#!/bin/bash
# One-time (idempotent) bring-up of the bootstrap-managed services on
# the kookaburra relay droplet:
#   1. tailscale  — joins tag:podnet; brings the mgmt-plane fabric up
#   2. Periphery  — listens on kookaburra's tailnet IP (DO firewall
#                   blocks 8120 publicly; tailscale traffic bypasses it)
# Run from bilby with the op-unlock SSH agent active.
#
# Periphery + tailscale are bootstrap-only — they are NOT Komodo
# stacks because Komodo→Periphery connectivity *depends* on tailscale
# being up, so a Komodo redeploy of either would break itself. (Same
# applies to kangaroo's Periphery.) Every OTHER service on kookaburra
# (rathole-server, logging, etc.) IS Komodo-managed via the linked-repo
# pattern once this bootstrap is done.
#
# Idempotent: safe to re-run. Re-runs refresh secrets + recreate
# containers if compose files changed; existing containers persist
# otherwise (restart=unless-stopped survives reboots).
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

DROPLET_IP="${DROPLET_IP:-170.64.195.179}"
SSH_HOST="root@${DROPLET_IP}"
REMOTE_DIR=/opt/komodo-periphery
# Bootstrap-side tailscale dir. Project name matches the eventual
# Komodo-managed stack (kookaburra-tailscale) so the named volume
# (kookaburra-tailscale_tailscale-state) is identical from day one —
# Komodo's first DeployStack adopts the running container with NO
# tailnet identity (and IP) regenerated. Same goes for container_name
# / TS_HOSTNAME: kookaburra-podnet is the single name across docker
# ps and the Tailscale admin.
TS_DIR=/opt/kookaburra-tailscale
TS_PROJECT=kookaburra-tailscale
TS_HOSTNAME=kookaburra-podnet

export OP_SERVICE_ACCOUNT_TOKEN="$(tr -d '\n' < OP_SERVICE_ACCOUNT_TOKEN)"
# Pick the op-unlock socket that actually has identities loaded (some
# old sockets may linger empty if op-unlock was re-run in a fresh
# shell — `ls | head -1` would happily grab a stale empty one).
SOCK=""
for s in /tmp/op-unlock-*.sock; do
  [ -S "$s" ] || continue
  if SSH_AUTH_SOCK="$s" ssh-add -l >/dev/null 2>&1; then SOCK="$s"; break; fi
done
[ -n "$SOCK" ] || { echo "no op-unlock SSH socket with identities; run op-unlock first" >&2; exit 1; }
export SSH_AUTH_SOCK="$SOCK"
CP="/tmp/kb-ssh-%r@%h:%p"
# IdentityAgent= is set explicitly per the opssh pattern — otherwise
# any future ~/.ssh/config IdentityAgent override (e.g. pointing to
# the 1Password GUI agent) would bypass the op-unlock socket and
# require an interactive prompt the bootstrap can't satisfy.
SSHO="-o IdentityAgent=$SOCK -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 \
 -o ServerAliveInterval=15 -o ControlMaster=auto -o ControlPersist=120 -o ControlPath=$CP"
retry() { local n=0; until "$@"; do n=$((n+1)); [ $n -ge 5 ] && return 1; echo "  retry $n: $*" >&2; sleep 8; done; }

# --- 1. SSH hardening FIRST (no Docker dependency; makes every
# subsequent bootstrap SSH call reliable for the slower docker steps).
echo "== prep dirs =="
retry ssh $SSHO "$SSH_HOST" "mkdir -p $TS_DIR $REMOTE_DIR/etc-komodo"

echo "== SSH hardening (auto-allowlist successful-auth IPs, NO banning) =="
# Ship + run kookaburra/ssh-hardening/apply.sh on the droplet.
# Idempotent — re-runs refresh sshd config + nftables ruleset.
BILBY_WAN=$(curl -s --max-time 6 https://1.1.1.1/cdn-cgi/trace 2>/dev/null | sed -n 's/^ip=//p')
retry scp -q $SSHO kookaburra/ssh-hardening/apply.sh "$SSH_HOST:/usr/local/sbin/kookaburra-ssh-harden"
retry ssh $SSHO "$SSH_HOST" "chmod +x /usr/local/sbin/kookaburra-ssh-harden && BILBY_WAN=$BILBY_WAN /usr/local/sbin/kookaburra-ssh-harden 2>&1 | tail -6"

# --- 2. dockernet bridge (Docker-dependent; cloud-init installs Docker)
echo "== ensure dockernet bridge (needed by Komodo-managed stacks that use the shared logging compose) =="
retry ssh $SSHO "$SSH_HOST" "docker network inspect dockernet >/dev/null 2>&1 || docker network create dockernet"

# --- 3. tailscale (joins tag:podnet as kookaburra-podnet) ---
# Use the SAME compose files + project name Komodo will use for the
# kookaburra-tailscale stack, so the named volume + container identity
# survive the bootstrap→Komodo handover (no tailnet IP regeneration).
echo "== ship tailscale compose (overlay + shared) =="
retry scp -q $SSHO tailscale/compose.shared.yaml "$SSH_HOST:$TS_DIR/compose.shared.yaml"
retry scp -q $SSHO tailscale/kookaburra/compose.yaml "$SSH_HOST:$TS_DIR/compose.yaml"

echo "== render .env (TS_AUTHKEY + OAuth from 1P) =="
# Bootstrap path mirrors the Komodo stack environment exactly so the
# tailscale-cleanup init (in compose.shared.yaml) gets the OAuth
# creds it needs to delete stale tailnet device ghosts. Without these
# the init runs, fails to obtain an access token, and falls through
# best-effort — meaning the rebuilt droplet inherits any `-N`
# collision suffix until Komodo's next redeploy fills them in.
TS_AUTHKEY="$(op read 'op://Homelab/Tailscale Auth Key/credential')"
TS_OAUTH_CLIENT_ID="$(op read 'op://Homelab/Tailscale OAuth Client/client id')"
TS_OAUTH_CLIENT_SECRET="$(op read 'op://Homelab/Tailscale OAuth Client/client secret')"
{ echo "TS_AUTHKEY=$TS_AUTHKEY";
  echo "TS_HOSTNAME=$TS_HOSTNAME";
  echo "TS_OAUTH_CLIENT_ID=$TS_OAUTH_CLIENT_ID";
  echo "TS_OAUTH_CLIENT_SECRET=$TS_OAUTH_CLIENT_SECRET";
  echo "TZ=Australia/Perth"; } | \
  ssh $SSHO "$SSH_HOST" "cat > $TS_DIR/.env && chmod 600 $TS_DIR/.env"

echo "== tailscale up (project=$TS_PROJECT, container=$TS_HOSTNAME) =="
retry ssh $SSHO "$SSH_HOST" "cd $TS_DIR && docker compose -p $TS_PROJECT -f compose.yaml -f compose.shared.yaml up -d"

# Wait for tailscale interface + IP
TS_IP=""
for i in $(seq 1 20); do
  TS_IP="$(ssh $SSHO "$SSH_HOST" "docker exec $TS_HOSTNAME tailscale ip -4 2>/dev/null | head -1" 2>/dev/null | tr -d '\r')"
  [ -n "$TS_IP" ] && break
  echo "  waiting for tailnet IP ($i)..."; sleep 3
done
[ -n "$TS_IP" ] || { echo "tailscale failed to come up" >&2; ssh $SSHO "$SSH_HOST" "docker logs --tail 30 $TS_HOSTNAME"; exit 1; }
echo "$TS_HOSTNAME tailnet IP: $TS_IP"

# --- 2. Periphery ---
echo "== ship Periphery compose =="
retry scp -q $SSHO kookaburra/periphery/compose.yaml "$SSH_HOST:$REMOTE_DIR/compose.yaml"

echo "== render Periphery .env (KOMODO_PASSKEYS from 1P) =="
KP="$(op read 'op://Homelab/Komodo Passkey/password')"
{ echo "KOMODO_PASSKEYS=$KP"; echo "TZ=Australia/Perth"; } | \
  ssh $SSHO "$SSH_HOST" "cat > $REMOTE_DIR/.env && chmod 600 $REMOTE_DIR/.env"

echo "== render periphery.config.toml (GitHub PAT for linked-repo clone) =="
GH="$(op read 'op://Homelab/Homelab GitHub Personal Access Token/token')"
{
  echo '[[git_provider]]'
  echo 'domain = "github.com"'
  echo '[[git_provider.accounts]]'
  echo 'username = "LogicWolfe"'
  echo "token = \"$GH\""
} | ssh $SSHO "$SSH_HOST" "cat > $REMOTE_DIR/etc-komodo/periphery.config.toml && chmod 600 $REMOTE_DIR/etc-komodo/periphery.config.toml"

echo "== Periphery up =="
retry ssh $SSHO "$SSH_HOST" "cd $REMOTE_DIR && docker compose up -d"

# Wait for Periphery health (curl -sk localhost:8120 from inside should return 405)
echo "== verify Periphery responds on kookaburra:$TS_IP:8120 (from bilby — needs bilby on tailnet too) =="
for i in $(seq 1 15); do
  c="$(ssh $SSHO "$SSH_HOST" "curl -sk --max-time 3 -o /dev/null -w '%{http_code}' https://localhost:8120/" 2>/dev/null)"
  [ "$c" = "405" ] && { echo "Periphery healthy (HTTP 405 on /, as expected)"; break; }
  echo "  Periphery starting ($i)... http=$c"; sleep 4
done

# --- final state summary ---
echo "== kookaburra state =="
ssh $SSHO "$SSH_HOST" "docker ps --format 'table {{.Names}}\t{{.Status}}'"
echo
echo "next: komodo/sync/servers.toml should have kookaburra registered as"
echo "  address = \"https://${TS_HOSTNAME}:8120\"  (MagicDNS resolves it)"
echo "  (or https://$TS_IP:8120 if MagicDNS is unavailable on the resolver chain)"
echo "then commit + push + komodo-sync; Komodo Core will connect via tailnet."
