// STAGED — not yet active. See the bilby counterpart and
// docs/plans/clickstack-migration/cutover.md. Renamed over the live
// config.alloy + logging redeployed at cutover.
//
// Structurally identical to bilby's staged config minus the bits that
// only exist on bilby: no op-connect-api / flood JSON rewrites (those
// containers aren't on kangaroo), no rtorrent-cleanup tail, no Gatus
// scrape (Gatus runs on bilby). ANSI decolorize is universal so kept.
// The OTLP exporter targets bilby's published collector cross-LAN at
// 10.0.0.119:4318 (replacing the old VL push to 10.0.0.119:9428).

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "30s"
}

discovery.relabel "container_logs" {
  targets = discovery.docker.containers.targets

  // Drop the leading slash that Docker prepends to container names.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.container_logs.output
  forward_to    = [loki.process.containers.receiver]
  relabel_rules = discovery.relabel.container_logs.rules
  labels        = {"host" = "kangaroo"}
}

// The op-connect-api / flood JSON-rewrite stages from bilby's config
// aren't needed here — those containers don't exist on kangaroo. ANSI
// decolorize is universal so kept.
loki.process "containers" {
  forward_to = [otelcol.receiver.loki.clickstack.receiver]

  stage.decolorize {}
}

// ---- ClickStack OTLP sink (replaces loki.write to Victoria Logs) ----
// kangaroo has no in-network path to the collector, so it ships
// cross-LAN to bilby's published OTLP/HTTP port (matches the old
// cross-LAN VL push, just OTLP now). LAN-only, plaintext — same trust
// posture as the previous :9428 path.

otelcol.receiver.loki "clickstack" {
  output {
    logs = [otelcol.processor.batch.clickstack.input]
  }
}

otelcol.processor.batch "clickstack" {
  output {
    logs = [otelcol.exporter.otlphttp.clickstack.input]
  }
}

otelcol.exporter.otlphttp "clickstack" {
  client {
    endpoint = "http://10.0.0.119:4318"
    headers  = {
      // ClickStack ingestion API key (same key as bilby; injected via
      // logging/kangaroo/stack.toml ← 1Password). Empty ⇒ 401 ⇒ no
      // data — loud failure, no silent fallback.
      "authorization" = sys.env("CLICKSTACK_INGESTION_KEY"),
    }
  }
}
