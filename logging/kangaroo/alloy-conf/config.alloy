// kangaroo's Alloy. Shared modules in ../alloy-modules do the work:
//   docker_logs → chain (per-service parsers) → Loki→OTLP bridge → enrich
//   → batch → the ClickStack collector on bandicoot, cross-LAN plaintext.
//   QTS has no journald, so container output is the only log source.
//
// Per-service parsing is config-as-code in ../alloy-modules (one module per
// service, one chain for every host), so a service moving between hosts
// keeps its parsing with no change here. See docs/logging.md.

// Internal-pipeline tracing — unified `alloy` service in HyperDX
// (same name on every host; one row per host).
tracing {
	sampling_fraction = 0.1
	write_to          = [otelcol.processor.batch.clickstack.input]
}

// The shared modules are read once, when the container starts. A push that
// changes one reaches this Alloy through the container recreate its content
// hash triggers, never as a reload inside the running process (see the tailer
// rule in docs/logging.md). Alloy has no read-once setting; a poll every ten
// years is one.
import.file "podhaus" {
	filename       = "/etc/alloy-modules"
	detector       = "poll"
	poll_frequency = "87600h"
}

podhaus.docker_logs "run" {
	host       = "kangaroo"
	forward_to = [podhaus.chain.run.receiver]
}

podhaus.chain "run" {
	forward_to = [otelcol.receiver.loki.clickstack.receiver]
}

otelcol.receiver.loki "clickstack" {
	output {
		logs = [podhaus.enrich.run.input]
	}
}

podhaus.enrich "run" {
	host   = "kangaroo"
	output = [otelcol.processor.batch.clickstack.input]
}

// Alloy self metrics — Prometheus→OTLP bridge (net-new on kangaroo;
// it has no Gatus scrape). Surfaces this host's pipeline throughput,
// queue depth and exporter-retry counters — the cross-LAN exporter's
// own health, the thing that used to die silently.
prometheus.exporter.self "alloy" { }

prometheus.scrape "alloy_self" {
  targets         = prometheus.exporter.self.alloy.targets
  scrape_interval = "60s"
  forward_to      = [otelcol.receiver.prometheus.alloy_self.receiver]
}

otelcol.receiver.prometheus "alloy_self" {
  output {
    metrics = [otelcol.processor.transform.svc_alloy.input]
  }
}

// The Prometheus→OTLP bridge carries no service.name resource
// attribute. Stamp a constant (mirrors bilby's svc_alloy and the
// enrich logs idiom). "alloy" matches this host's Alloy container
// logs and the tracing block, unifying all three signals under one
// `alloy` service. `host.name` is the same resource attribute the logs
// carry, so each host's Alloy self-metrics are distinguishable — without
// it the only per-host key is the ephemeral container ID
// (service.instance.id), useless for a durable query. The 60 s
// self-scrape on this stable `host.name` key is the kangaroo log-pipeline
// liveness heartbeat (Gatus).
otelcol.processor.transform "svc_alloy" {
  error_mode = "ignore"

  metric_statements {
    context = "metric"
    statements = [
      `set(resource.attributes["service.name"], "alloy")`,
      `set(resource.attributes["host.name"], "kangaroo")`,
    ]
  }

  output {
    metrics = [otelcol.processor.batch.clickstack.input]
  }
}

otelcol.processor.batch "clickstack" {
  output {
    logs    = [otelcol.exporter.otlphttp.clickstack.input]
    metrics = [otelcol.exporter.otlphttp.clickstack.input]
    traces  = [otelcol.exporter.otlphttp.clickstack.input]
  }
}

otelcol.exporter.otlphttp "clickstack" {
  client {
    // bandicoot's LAN address, from config/lan-addresses.json through
    // logging/kangaroo/stack.toml.
    endpoint = "http://" + sys.env("BANDICOOT_LAN_IPV4") + ":4318"
    headers  = {
      // ClickStack ingestion API key (same key every host uses; injected via
      // logging/kangaroo/stack.toml ← 1Password). Empty ⇒ 401 ⇒ no
      // data — loud failure, no silent fallback.
      "authorization" = sys.env("CLICKSTACK_INGESTION_KEY"),
    }
    // No keepalive: kangaroo pushes cross-LAN to a FIXED IP behind
    // bandicoot's published :4318 + NAT. When the collector container
    // recreates, the IP is unchanged but the backend isn't — an existing
    // keepalive TCP connection stays mapped (conntrack) to the dead old
    // container, so the next send blackholes and HANGS silently (no RST).
    // A fresh connection per batch always reaches the current collector.
    // bandicoot ships in-network by container name (DNS re-resolves) and
    // needs no equivalent. Low volume makes the per-batch connection cost
    // negligible (the docs' overhead caveat is for high-throughput
    // exporters). Root cause of the recurring kangaroo wedge, 2026-06-19.
    disable_keep_alives = true
  }

  // Retry across a collector outage for at most 30 minutes, then drop the
  // batch; 30m rides out any realistic collector restart. The budget is
  // checked only when an attempt returns: a request that never returns
  // (the hung stale connection that disable_keep_alives now prevents)
  // holds its queue worker whatever the budget, and the container's
  // healthcheck restarts an exporter whose requests have stopped
  // completing (logging/compose.shared.yaml).
  retry_on_failure {
    max_elapsed_time = "30m"
  }
  sending_queue {
    queue_size = 100000
  }
}
