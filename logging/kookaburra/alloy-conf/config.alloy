// kookaburra's alloy config — minimal cross-tailnet ship to bilby's
// ClickStack collector via MagicDNS (bilby-podnet.tail9ceb.ts.net).
// Resolution works because kookaburra's /etc/docker/daemon.json
// forwards container DNS to 100.100.100.100 (Tailscale MagicDNS) +
// 1.1.1.1 — same setup as bilby. See /docs/networking.html for the
// daemon.json pattern.
// No per-service parsers yet (kookaburra only runs tailscale +
// periphery + rathole at this stage); same generic severity-enrich +
// service.name-from-container as bilby/kangaroo so logs are
// queryable identically in HyperDX.

// Internal-pipeline tracing — unified `alloy` service in HyperDX
// (same name on every host; one row per host).
tracing {
  sampling_fraction = 0.1
  write_to          = [otelcol.processor.batch.clickstack.input]
}

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "30s"
}

discovery.relabel "container_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.container_logs.output
  forward_to    = [loki.process.containers.receiver]
  relabel_rules = discovery.relabel.container_logs.rules
  labels        = {"host" = "kookaburra"}
}

// ANSI strip — generic pre-shaping.
loki.process "containers" {
  forward_to = [otelcol.receiver.loki.clickstack.receiver]

  stage.decolorize {}
}

// ---- ClickStack OTLP sink (cross-tailnet to bilby) ----

otelcol.receiver.loki "clickstack" {
  output {
    logs = [otelcol.processor.transform.enrich.input]
  }
}

// Same enrich logic bilby/kangaroo use — service.name from container,
// severity_text from the leading level token.
otelcol.processor.transform "enrich" {
  error_mode = "ignore"

  log_statements {
    context = "log"
    statements = [
      `set(resource.attributes["service.name"], attributes["container"]) where attributes["container"] != nil`,

      `set(severity_text, "TRACE") where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(trace)(\\]|:|\\s)")`,
      `set(severity_number, 1) where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(trace)(\\]|:|\\s)")`,

      `set(severity_text, "DEBUG") where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(debug)(\\]|:|\\s)")`,
      `set(severity_number, 5) where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(debug)(\\]|:|\\s)")`,

      `set(severity_text, "INFO") where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(info)(\\]|:|\\s)")`,
      `set(severity_number, 9) where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(info)(\\]|:|\\s)")`,

      `set(severity_text, "WARN") where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(warn|warning)(\\]|:|\\s)")`,
      `set(severity_number, 13) where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(warn|warning)(\\]|:|\\s)")`,

      `set(severity_text, "ERROR") where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(error|err)(\\]|:|\\s)")`,
      `set(severity_number, 17) where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(error|err)(\\]|:|\\s)")`,

      `set(severity_text, "FATAL") where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(fatal|panic)(\\]|:|\\s)")`,
      `set(severity_number, 21) where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(fatal|panic)(\\]|:|\\s)")`,
    ]
  }

  output {
    logs = [otelcol.processor.batch.clickstack.input]
  }
}

otelcol.processor.batch "clickstack" {
  output {
    logs   = [otelcol.exporter.otlphttp.clickstack.input]
    traces = [otelcol.exporter.otlphttp.clickstack.input]
  }
}

// Bilby's ClickStack collector — reached via the tailnet (tag:podnet).
// Same trust posture as kangaroo's cross-LAN push: plaintext on an
// authenticated/private channel (WireGuard, not the LAN).
otelcol.exporter.otlphttp "clickstack" {
  client {
    endpoint = "http://bilby-podnet.tail9ceb.ts.net:4318"
    headers  = {
      "authorization" = sys.env("CLICKSTACK_INGESTION_KEY"),
    }
  }

  // Same resilience as kangaroo — retry forever + large buffer so a
  // bilby collector outage doesn't wedge this pipeline.
  retry_on_failure {
    max_elapsed_time = "0s"
  }
  sending_queue {
    queue_size = 100000
  }
}
