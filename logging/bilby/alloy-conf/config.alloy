// bilby's Alloy. Shared modules in ../alloy-modules do the work: the sources
// below (containers, Plex's server log, the Flood job logs and the systemd
// journal) → chain (per-service parsers) → ship (Loki→OTLP bridge, enrich,
// batch, Alloy's own metrics, and the exporter to the ClickStack collector
// on bandicoot). Gatus and ESPHome metrics are scraped here and handed to the
// same exporter.
//
// Per-service parsing is config-as-code in ../alloy-modules (one module per
// service, one chain for every host), so a service moving between hosts
// keeps its parsing with no change here. See docs/logging.md.

// Alloy's own pipeline spans under service `alloy`, sampled at 10%: span
// volume grows with the number of components, and they are kept for the
// pipeline's health, not request flow. Alloy allows a tracing block only in
// the root config. Its own log lines are not sent this way; the Docker source
// already reads them, and they would arrive twice.
tracing {
	sampling_fraction = 0.1
	write_to          = [podhaus.ship.run.input]
}

// The shared modules are read once, when the container starts. A push that
// changes one reaches this Alloy through the container recreate its content
// hash triggers, never as a reload inside the running process (see the tailer
// rule in docs/logging.md). Alloy has no read-once setting; a poll every ten
// years is one.
import.file "podhaus" {
	filename       = "/etc/alloy-modules"
	detector       = "poll"
	poll_frequency = "87600h"
}

podhaus.docker_logs "run" {
	host       = "bilby"
	forward_to = [podhaus.chain.run.receiver]
}

podhaus.plex_server_log "run" {
	host            = "bilby"
	container       = "plex"
	compose_project = "plex"
	compose_service = "plex"
	logs_dir        = "/var/log/podhaus/plex"
	timezone        = "Australia/Perth"
	forward_to      = [podhaus.chain.run.receiver]
}

podhaus.flood_job_logs "run" {
	host            = "bilby"
	container       = "rtorrent"
	compose_project = "flood"
	compose_service = "rtorrent"
	flood_db        = "/var/log/podhaus/flood-db"
	forward_to      = [podhaus.chain.run.receiver]
}

podhaus.journal "run" {
	host       = "bilby"
	forward_to = [podhaus.chain.run.receiver]
}

podhaus.chain "run" {
	forward_to = [podhaus.ship.run.receiver]
}

// Plaintext across the LAN to the collector's published port on bandicoot,
// whose address the shared catalog supplies through logging/bilby/stack.toml.
podhaus.ship "run" {
	host     = "bilby"
	endpoint = "http://" + sys.env("BANDICOOT_LAN_IPV4") + ":4318"
}

// Gatus exposes Prometheus metrics at :8080/metrics (metrics: true in
// gatus/conf/config.yaml). Scrape at Gatus's own ~60s cadence — faster
// just resamples stale values — bridge Prometheus → OTLP, same exporter.
prometheus.scrape "gatus" {
	targets = [{
		__address__      = "gatus:8080",
		__metrics_path__ = "/metrics",
	}]
	scrape_interval = "60s"
	forward_to      = [otelcol.receiver.prometheus.gatus.receiver]
}

otelcol.receiver.prometheus "gatus" {
	output {
		metrics = [otelcol.processor.transform.svc_gatus.input]
	}
}

// The Prometheus→OTLP bridge carries no service.name resource
// attribute, so bridged metrics land unattributed (no service in
// HyperDX's metric-by-service views — only queryable by metric name).
// Stamp a constant, mirroring the enrich processor's
// `set(resource.attributes["service.name"], …)` idiom on the logs
// path. "gatus" matches the service its own container logs already
// resolve to via enrich, so logs+metrics unify under one service. The
// ship module adds host.name.
otelcol.processor.transform "svc_gatus" {
	error_mode = "ignore"

	metric_statements {
		context    = "metric"
		statements = [
			`set(resource.attributes["service.name"], "gatus")`,
		]
	}

	output {
		metrics = [podhaus.ship.run.input]
	}
}

// ESPHome IoT devices expose every entity as OpenMetrics via their own
// `prometheus:` component (iot/esphome/config/<device>.yaml). This is the only
// telemetry path off these devices: ESPHome has no syslog output, and the
// MQTT route would mean standing up a broker plus a Telegraf bridge — two new
// services to carry one ESP32's log lines. Entities are free by comparison,
// and the state (BLE link up, notification rate, battery trend) is what
// actually diagnoses these devices; the log lines never were.
//
// Scraped by IP because Alloy resolves through Docker's DNS, which has no
// mDNS, so `turn-touch-burrow.local` is unreachable from in here. Both
// addresses are pinned by UniFi reservations and reach this file as
// environment variables from logging/bilby/stack.toml and the shared catalog
// (config/lan-addresses.json); without the pin a DHCP drift would silently
// end the scrape.
//
// Deliberately narrow: one target per device, ~10 series each. ClickHouse
// runs under a 4g cap, so the tempting alternative — scraping Home
// Assistant's /api/prometheus for every entity in the house — is not a
// like-for-like swap.
prometheus.scrape "esphome" {
	targets = [{
		__address__      = sys.env("TURN_TOUCH_BURROW_IPV4"),
		__metrics_path__ = "/metrics",
		instance         = "turn-touch-burrow",
	}, {
		__address__      = sys.env("LED_STRIP_GRASSHOPPER_IPV4"),
		__metrics_path__ = "/metrics",
		instance         = "led-strip-grasshopper",
	}]
	scrape_interval = "60s"
	forward_to      = [otelcol.receiver.prometheus.esphome.receiver]
}

otelcol.receiver.prometheus "esphome" {
	output {
		metrics = [otelcol.processor.transform.svc_esphome.input]
	}
}

// Same service.name stamping as svc_gatus — the Prometheus→OTLP bridge
// carries none, and unattributed metrics are invisible to HyperDX's
// metric-by-service views. "esphome" groups every device under one service,
// with `instance` from the scrape target separating them.
otelcol.processor.transform "svc_esphome" {
	error_mode = "ignore"

	metric_statements {
		context    = "metric"
		statements = [
			`set(resource.attributes["service.name"], "esphome")`,
		]
	}

	output {
		metrics = [podhaus.ship.run.input]
	}
}
