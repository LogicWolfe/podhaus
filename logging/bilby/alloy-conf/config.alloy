// bilby's Alloy. Pipeline (all shared modules in ../alloy-modules):
//   docker_logs → chain (per-service parsers) → Loki→OTLP bridge → enrich
//   (host + service.name resource attributes, severity) → batch → the
//   ClickStack collector on bandicoot, cross-LAN. Plex's server log, the
//   Flood job logs and the systemd journal ride the same path. Gatus,
//   ESPHome and Alloy's own metrics are scraped here and bridged to OTLP.
//   Alloy self-telemetry (own pipeline spans + self metrics) rides the
//   same exporter; its logs do NOT (already captured via the Docker
//   discovery path + alloy.alloy — write_to here would double-ingest,
//   see the fenwick double-ingest note in fenwick/compose.yaml).
//
// Per-service parsing is config-as-code in ../alloy-modules (one module per
// service, one chain for every host), so a service moving between hosts
// keeps its parsing with no change here. See docs/monitoring.html.

// Alloy's own internal-pipeline tracing. A per-host `alloy` service in
// HyperDX Traces showing component-eval spans — the pipeline diagnosing
// itself. Low sampling on purpose: span volume scales with component
// count, and the value here is health not request flow.
tracing {
	sampling_fraction = 0.1
	write_to          = [otelcol.processor.batch.clickstack.input]
}

import.file "podhaus" {
	filename = "/etc/alloy-modules"
}

podhaus.docker_logs "run" {
	host       = "bilby"
	forward_to = [podhaus.chain.run.receiver]
}

podhaus.plex_server_log "run" {
	host       = "bilby"
	container  = "plex"
	logs_dir   = "/var/log/podhaus/plex"
	timezone   = "Australia/Perth"
	forward_to = [podhaus.chain.run.receiver]
}

podhaus.flood_job_logs "run" {
	host       = "bilby"
	container  = "flood"
	flood_db   = "/var/log/podhaus/flood-db"
	forward_to = [podhaus.chain.run.receiver]
}

podhaus.journal "run" {
	host       = "bilby"
	forward_to = [podhaus.chain.run.receiver]
}

podhaus.chain "run" {
	forward_to = [otelcol.receiver.loki.clickstack.receiver]
}

otelcol.receiver.loki "clickstack" {
	output {
		logs = [podhaus.enrich.run.input]
	}
}

podhaus.enrich "run" {
	host   = "bilby"
	output = [otelcol.processor.batch.clickstack.input]
}

// Gatus exposes Prometheus metrics at :8080/metrics (metrics: true in
// gatus/conf/config.yaml). Scrape at Gatus's own ~60s cadence — faster
// just resamples stale values — bridge Prometheus → OTLP, same sink.
prometheus.scrape "gatus" {
  targets = [{
    __address__      = "gatus:8080",
    __metrics_path__ = "/metrics",
  }]
  scrape_interval = "60s"
  forward_to      = [otelcol.receiver.prometheus.gatus.receiver]
}

otelcol.receiver.prometheus "gatus" {
  output {
    metrics = [otelcol.processor.transform.svc_gatus.input]
  }
}

// The Prometheus→OTLP bridge carries no service.name resource
// attribute, so bridged metrics land unattributed (no service in
// HyperDX's metric-by-service views — only queryable by metric name).
// Stamp a constant, mirroring the enrich processor's
// `set(resource.attributes["service.name"], …)` idiom on the logs
// path. "gatus" matches the service its own container logs already
// resolve to via enrich, so logs+metrics unify under one service.
otelcol.processor.transform "svc_gatus" {
  error_mode = "ignore"

  metric_statements {
    context = "metric"
    statements = [
      `set(resource.attributes["service.name"], "gatus")`,
    ]
  }

  output {
    metrics = [otelcol.processor.batch.clickstack.input]
  }
}

// Alloy self metrics — same Prometheus→OTLP bridge pattern as Gatus
// above. prometheus.exporter.self surfaces Alloy's internal counters
// (pipeline throughput, queue depth, exporter retries) so the log
// pipeline's own health is queryable in HyperDX alongside everything
// it ships.
prometheus.exporter.self "alloy" { }

prometheus.scrape "alloy_self" {
  targets         = prometheus.exporter.self.alloy.targets
  scrape_interval = "60s"
  forward_to      = [otelcol.receiver.prometheus.alloy_self.receiver]
}

otelcol.receiver.prometheus "alloy_self" {
  output {
    metrics = [otelcol.processor.transform.svc_alloy.input]
  }
}

// Same service.name stamping as svc_gatus. "alloy" matches both this
// host's Alloy container logs (via enrich) and the tracing block's
// service name, so all three signals unify under one `alloy` service.
// `host` mirrors the logs path's loki label so each host's Alloy
// self-metrics are distinguishable (the unified `alloy` service is set
// by service.name, not host, so adding the dimension costs nothing).
otelcol.processor.transform "svc_alloy" {
  error_mode = "ignore"

  metric_statements {
    context = "metric"
    statements = [
      `set(resource.attributes["service.name"], "alloy")`,
      `set(resource.attributes["host"], "bilby")`,
    ]
  }

  output {
    metrics = [otelcol.processor.batch.clickstack.input]
  }
}

// ESPHome IoT devices expose every entity as OpenMetrics via their own
// `prometheus:` component (iot/esphome/config/<device>.yaml). This is the only
// telemetry path off these devices: ESPHome has no syslog output, and the
// MQTT route would mean standing up a broker plus a Telegraf bridge — two new
// services to carry one ESP32's log lines. Entities are free by comparison,
// and the state (BLE link up, notification rate, battery trend) is what
// actually diagnoses these devices; the log lines never were.
//
// Scraped by IP because Alloy resolves through Docker's DNS, which has no
// mDNS, so `turn-touch-burrow.local` is unreachable from in here. Both
// addresses are pinned by UniFi reservations (terraform/unifi.tf) — without
// them a DHCP drift would silently end the scrape.
//
// Deliberately narrow: one target per device, ~10 series each. bilby's
// ClickHouse runs under a 4g cap, so the tempting alternative — scraping Home
// Assistant's /api/prometheus for every entity in the house — is not a
// like-for-like swap.
prometheus.scrape "esphome" {
  targets = [{
    __address__      = "10.0.0.238",
    __metrics_path__ = "/metrics",
    instance         = "turn-touch-burrow",
  }, {
    __address__      = "10.0.0.44",
    __metrics_path__ = "/metrics",
    instance         = "led-strip-grasshopper",
  }]
  scrape_interval = "60s"
  forward_to      = [otelcol.receiver.prometheus.esphome.receiver]
}

otelcol.receiver.prometheus "esphome" {
  output {
    metrics = [otelcol.processor.transform.svc_esphome.input]
  }
}

// Same service.name stamping as svc_gatus — the Prometheus→OTLP bridge
// carries none, and unattributed metrics are invisible to HyperDX's
// metric-by-service views. "esphome" groups every device under one service,
// with `instance` from the scrape target separating them.
otelcol.processor.transform "svc_esphome" {
  error_mode = "ignore"

  metric_statements {
    context = "metric"
    statements = [
      `set(resource.attributes["service.name"], "esphome")`,
      `set(resource.attributes["host"], "bilby")`,
    ]
  }

  output {
    metrics = [otelcol.processor.batch.clickstack.input]
  }
}

otelcol.processor.batch "clickstack" {
  output {
    logs    = [otelcol.exporter.otlphttp.clickstack.input]
    metrics = [otelcol.exporter.otlphttp.clickstack.input]
    traces  = [otelcol.exporter.otlphttp.clickstack.input]
  }
}

otelcol.exporter.otlphttp "clickstack" {
  client {
    // ClickStack lives on bandicoot: cross-LAN to its published :4318.
    endpoint = "http://10.0.0.90:4318"
    // Same reasoning as kangaroo's exporter: a fixed IP behind a published
    // port + NAT keeps a kept-alive connection mapped to a dead collector
    // after a recreate, so every batch opens a fresh connection.
    disable_keep_alives = true
    headers  = {
      // ClickStack ingestion API key. Empty ⇒ 401 ⇒ no data in
      // HyperDX — a loud, visible failure. No silent fallback to the
      // old VL sink: this is a hard swap (no fallback masks failure).
      "authorization" = sys.env("CLICKSTACK_INGESTION_KEY"),
    }
  }

  // Collector resilience. The endpoint
  // blips on every clickstack redeploy; OTel's default retry gives up
  // after 5min and the in-memory queue then wedges → silent data loss
  // until a manual restart. Retry forever + a large buffer so any
  // collector outage self-heals on recovery instead of going dark.
  retry_on_failure {
    max_elapsed_time = "0s"
  }
  sending_queue {
    queue_size = 100000
  }
}
