// ACTIVE bilby logging config. Pipeline:
//   docker discovery → loki.process "containers" (ANSI strip +
//   op-connect-api/flood JSON) → per-service parser chain (imported
//   from parsers/, one tracked file per service) → Loki→OTLP bridge →
//   OTTL enrich (service.name + severity fallback) → ClickStack collector.
//   Gatus /metrics is scraped here and rides the same authed exporter.
//   Alloy self-telemetry (own pipeline spans + self metrics) rides the
//   same exporter; its logs do NOT (already captured via the Docker
//   discovery path + parsers.alloy — write_to here would double-ingest,
//   see the fenwick double-ingest note in fenwick/compose.yaml).
//
// Per-service parsers are config-as-code: parsers/<service>.alloy is a
// `declare` module owning that service's shaping (real event-time
// parse, level→detected_level, Body=message). Add a service = add a
// file in parsers/ + one line in the chain below. Unparsed services
// pass through untouched and get the generic OTTL severity fallback.

// Alloy's own internal-pipeline tracing. Net-new signal: a per-host
// `alloy` service in HyperDX Traces showing component-eval spans —
// the pipeline diagnosing itself. Low sampling on purpose: this is the
// one mem-risky box (4g ClickHouse cap), span volume scales with
// component count, and the value here is health not request flow.
tracing {
  sampling_fraction = 0.1
  write_to          = [otelcol.processor.batch.clickstack.input]
}

import.file "parsers" {
  filename = "/etc/alloy/parsers"
}

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "30s"
}

discovery.relabel "container_logs" {
  targets = discovery.docker.containers.targets

  // Drop the leading slash that Docker prepends to container names.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.container_logs.output
  forward_to    = [loki.process.containers.receiver]
  relabel_rules = discovery.relabel.container_logs.rules
  labels        = {"host" = "bilby"}
}

// Universal pre-shaping: strip ANSI so the per-service parsers (and
// JSON stages) never see colour codes. komodo-core, home-assistant,
// flood etc. emit raw ANSI. Per-container shaping now lives in
// parsers/<service>.alloy (config-as-code) — op-connect-api and flood
// moved to their own parser modules; the legacy inline stage.match
// blocks are gone.
loki.process "containers" {
  forward_to = [parsers.fenwick.run.receiver]

  stage.decolorize {}
}

// rtorrent-cleanup.sh (event.download.erased hook + ad-hoc invocations)
// writes to /flood-db/rtorrent-cleanup.log. Bind-mounted into alloy at
// /var/log/flood/. Tailing the file is necessary because the script is
// forked by rtorrent — its stdout never reaches the flood container's
// docker log stream. Distinct `service` label keeps cleanup events
// queryable separately from flood's web JSON logs.
local.file_match "rtorrent_cleanup" {
  path_targets = [{
    __path__  = "/var/log/flood/rtorrent-cleanup.log",
    container = "flood",
    service   = "rtorrent-cleanup",
    host      = "bilby",
  }]
}

loki.source.file "rtorrent_cleanup" {
  targets    = local.file_match.rtorrent_cleanup.targets
  forward_to = [otelcol.receiver.loki.clickstack.receiver]
}

// ---- ClickStack OTLP sink (replaces loki.write to Victoria Logs) ----
// Alloy is itself an OTel Collector distro: bridge the Loki-shaped
// entries to OTLP, batch, and ship to ClickStack's bundled collector
// over OTLP/HTTP. bilby reaches it in-network by container name.

// Per-service parser chain (config-as-code, one module file per
// service in parsers/). Order is functionally irrelevant — each module
// only transforms its own container's streams via stage.match and
// passes every other stream through untouched. Extend by adding
// parsers/<svc>.alloy and inserting another link in this chain.
// Anything without a parser here (e.g. rtorrent-cleanup, docs-server,
// signal-cli-rest-api) still flows and gets the generic OTTL
// service.name + severity fallback in otelcol.processor.transform.
// fenwick is the exception: its parser DROPS the stream (it
// self-reports OTLP directly to ClickStack) — runs first so the drop
// is cheap. See parsers/fenwick.alloy.
parsers.fenwick           "run" { forward_to = [parsers.komodo_op.run.receiver] }
parsers.komodo_op         "run" { forward_to = [parsers.komodo_core.run.receiver] }
parsers.komodo_core       "run" { forward_to = [parsers.komodo_ferretdb.run.receiver] }
parsers.komodo_ferretdb   "run" { forward_to = [parsers.komodo_postgres.run.receiver] }
parsers.komodo_postgres   "run" { forward_to = [parsers.paperless_postgres.run.receiver] }
parsers.paperless_postgres "run" { forward_to = [parsers.op_connect_api.run.receiver] }
parsers.op_connect_api    "run" { forward_to = [parsers.op_connect_sync.run.receiver] }
parsers.op_connect_sync   "run" { forward_to = [parsers.clickstack_mongo.run.receiver] }
parsers.clickstack_mongo  "run" { forward_to = [parsers.hyperdx.run.receiver] }
parsers.hyperdx           "run" { forward_to = [parsers.clickstack_otel.run.receiver] }
parsers.clickstack_otel   "run" { forward_to = [parsers.alloy.run.receiver] }
parsers.alloy             "run" { forward_to = [parsers.gatus.run.receiver] }
parsers.gatus             "run" { forward_to = [parsers.paperless.run.receiver] }
parsers.paperless         "run" { forward_to = [parsers.home_assistant.run.receiver] }
parsers.home_assistant    "run" { forward_to = [parsers.cloudflare_tunnel.run.receiver] }
parsers.cloudflare_tunnel "run" { forward_to = [parsers.unpackerr.run.receiver] }
parsers.unpackerr         "run" { forward_to = [parsers.clickstack_clickhouse.run.receiver] }
parsers.clickstack_clickhouse "run" { forward_to = [parsers.autoheal.run.receiver] }
parsers.autoheal          "run" { forward_to = [parsers.flood.run.receiver] }
parsers.flood             "run" { forward_to = [otelcol.receiver.loki.clickstack.receiver] }

otelcol.receiver.loki "clickstack" {
  output {
    logs = [otelcol.processor.transform.enrich.input]
  }
}

// Enrich bridged logs before export:
//  1. Set the OTLP service.name resource attribute from the Docker
//     container name. The Loki→OTLP bridge only puts `container` in log
//     attributes; without this HyperDX's ServiceName column, Service
//     Map and service filters are all blank.
//  2. Re-derive severity from the real level token at the START of the
//     line. ClickStack otherwise keyword-scans the whole body and
//     mislabels lines like "[INFO] ... Total errors encountered: 0" as
//     ERROR. One delimiter-anchored pattern over the first ~60 chars
//     ("errors" ≠ "error"); lines with no recognisable level keep
//     whatever ClickStack inferred. OTTL, not per-container regex.
otelcol.processor.transform "enrich" {
  error_mode = "ignore"

  log_statements {
    context = "log"
    statements = [
      `set(resource.attributes["service.name"], attributes["container"]) where attributes["container"] != nil`,

      `set(severity_text, "TRACE") where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(trace)(\\]|:|\\s)")`,
      `set(severity_number, 1) where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(trace)(\\]|:|\\s)")`,

      `set(severity_text, "DEBUG") where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(debug)(\\]|:|\\s)")`,
      `set(severity_number, 5) where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(debug)(\\]|:|\\s)")`,

      `set(severity_text, "INFO") where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(info)(\\]|:|\\s)")`,
      `set(severity_number, 9) where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(info)(\\]|:|\\s)")`,

      `set(severity_text, "WARN") where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(warn|warning)(\\]|:|\\s)")`,
      `set(severity_number, 13) where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(warn|warning)(\\]|:|\\s)")`,

      `set(severity_text, "ERROR") where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(error|err)(\\]|:|\\s)")`,
      `set(severity_number, 17) where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(error|err)(\\]|:|\\s)")`,

      `set(severity_text, "FATAL") where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(fatal|panic)(\\]|:|\\s)")`,
      `set(severity_number, 21) where IsMatch(body, "(?i)^.{0,60}?(\\[|\\s)(fatal|panic)(\\]|:|\\s)")`,

      // Authoritative: per-service parsers (parsers/*.alloy) set
      // `detected_level` from the real parsed level. Runs LAST so it
      // overrides the body-keyword heuristic above for parsed services.
      `set(severity_text, attributes["detected_level"]) where attributes["detected_level"] != nil`,
      `set(severity_number, 1)  where attributes["detected_level"] == "TRACE"`,
      `set(severity_number, 5)  where attributes["detected_level"] == "DEBUG"`,
      `set(severity_number, 9)  where attributes["detected_level"] == "INFO"`,
      `set(severity_number, 13) where attributes["detected_level"] == "WARN" or attributes["detected_level"] == "WARNING"`,
      `set(severity_number, 17) where attributes["detected_level"] == "ERROR" or attributes["detected_level"] == "ERR"`,
      `set(severity_number, 21) where attributes["detected_level"] == "FATAL" or attributes["detected_level"] == "PANIC"`,
    ]
  }

  output {
    logs = [otelcol.processor.batch.clickstack.input]
  }
}

// Gatus exposes Prometheus metrics at :8080/metrics (metrics: true in
// gatus/conf/config.yaml). Scrape at Gatus's own ~60s cadence — faster
// just resamples stale values — bridge Prometheus → OTLP, same sink.
prometheus.scrape "gatus" {
  targets = [{
    __address__      = "gatus:8080",
    __metrics_path__ = "/metrics",
  }]
  scrape_interval = "60s"
  forward_to      = [otelcol.receiver.prometheus.gatus.receiver]
}

otelcol.receiver.prometheus "gatus" {
  output {
    metrics = [otelcol.processor.transform.svc_gatus.input]
  }
}

// The Prometheus→OTLP bridge carries no service.name resource
// attribute, so bridged metrics land unattributed (no service in
// HyperDX's metric-by-service views — only queryable by metric name).
// Stamp a constant, mirroring the enrich processor's
// `set(resource.attributes["service.name"], …)` idiom on the logs
// path. "gatus" matches the service its own container logs already
// resolve to via enrich, so logs+metrics unify under one service.
otelcol.processor.transform "svc_gatus" {
  error_mode = "ignore"

  metric_statements {
    context = "metric"
    statements = [
      `set(resource.attributes["service.name"], "gatus")`,
    ]
  }

  output {
    metrics = [otelcol.processor.batch.clickstack.input]
  }
}

// Alloy self metrics — same Prometheus→OTLP bridge pattern as Gatus
// above. prometheus.exporter.self surfaces Alloy's internal counters
// (pipeline throughput, queue depth, exporter retries) so the log
// pipeline's own health is queryable in HyperDX alongside everything
// it ships.
prometheus.exporter.self "alloy" { }

prometheus.scrape "alloy_self" {
  targets         = prometheus.exporter.self.alloy.targets
  scrape_interval = "60s"
  forward_to      = [otelcol.receiver.prometheus.alloy_self.receiver]
}

otelcol.receiver.prometheus "alloy_self" {
  output {
    metrics = [otelcol.processor.transform.svc_alloy.input]
  }
}

// Same service.name stamping as svc_gatus. "alloy" matches both this
// host's Alloy container logs (via enrich) and the tracing block's
// service name, so all three signals unify under one `alloy` service.
// `host` mirrors the logs path's loki label so each host's Alloy
// self-metrics are distinguishable (the unified `alloy` service is set
// by service.name, not host, so adding the dimension costs nothing).
otelcol.processor.transform "svc_alloy" {
  error_mode = "ignore"

  metric_statements {
    context = "metric"
    statements = [
      `set(resource.attributes["service.name"], "alloy")`,
      `set(resource.attributes["host"], "bilby")`,
    ]
  }

  output {
    metrics = [otelcol.processor.batch.clickstack.input]
  }
}

otelcol.processor.batch "clickstack" {
  output {
    logs    = [otelcol.exporter.otlphttp.clickstack.input]
    metrics = [otelcol.exporter.otlphttp.clickstack.input]
    traces  = [otelcol.exporter.otlphttp.clickstack.input]
  }
}

otelcol.exporter.otlphttp "clickstack" {
  client {
    endpoint = "http://clickstack-otel:4318"
    headers  = {
      // ClickStack ingestion API key. Empty ⇒ 401 ⇒ no data in
      // HyperDX — a loud, visible failure. No silent fallback to the
      // old VL sink: this is a hard swap (no fallback masks failure).
      "authorization" = sys.env("CLICKSTACK_INGESTION_KEY"),
    }
  }

  // Collector resilience. The endpoint
  // blips on every clickstack redeploy; OTel's default retry gives up
  // after 5min and the in-memory queue then wedges → silent data loss
  // until a manual restart. Retry forever + a large buffer so any
  // collector outage self-heals on recovery instead of going dark.
  retry_on_failure {
    max_elapsed_time = "0s"
  }
  sending_queue {
    queue_size = 100000
  }
}
