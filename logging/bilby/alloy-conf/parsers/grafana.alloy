// Per-service log parser — grafana
//
// See parsers/komodo-op.alloy for the pattern/rationale.
//
// Grafana log format is logfmt. The event time is carried in the `t`
// key as RFC3339 with nanoseconds and a +08:00 offset; `level` is a
// lowercase word; `msg` is the human message (often quoted):
//   logger=dashboard-service t=2026-05-16T11:33:02.256409915+08:00 level=info msg="No last resource version found, starting from scratch" orgID=1
//
// Shaping mirrors the other parsers: parse `t` into the log timestamp
// (the +08:00 offset is part of RFC3339Nano, so the instant is exact),
// uppercase `level` into a `detected_level` label (OTTL maps it to OTLP
// severity), and reduce Body to just `msg`. logfmt mapping is
// { extracted_var = "logfmt_key" }, and an empty value means "same name
// as the key", so msg="" extracts the `msg` field into var `msg`.
// Non-logfmt lines yield no extracted fields and pass through untouched.

declare "grafana" {
  argument "forward_to" { }

  loki.process "this" {
    forward_to = argument.forward_to.value

    stage.match {
      selector = "{container=\"grafana\"}"

      stage.logfmt {
        mapping = {
          ts  = "t",
          lvl = "level",
          msg = "",
        }
      }

      stage.timestamp {
        source = "ts"
        format = "RFC3339Nano"
      }

      stage.template {
        source   = "lvl"
        template = "{{ ToUpper .Value }}"
      }

      stage.labels {
        values = { detected_level = "lvl" }
      }

      stage.output {
        source = "msg"
      }
    }
  }

  export "receiver" {
    value = loki.process.this.receiver
  }
}
