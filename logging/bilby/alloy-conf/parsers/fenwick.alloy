// Per-service log parser — fenwick
//
// See parsers/komodo-op.alloy for the pattern/rationale.
//
// Fenwick is the one service that does NOT go through this Loki→OTLP
// path: it runs Deno's built-in OpenTelemetry (OTEL_DENO=true) and
// ships OTLP (traces + logs + metrics, trace-correlated) directly to
// the ClickStack collector — the same endpoint and ingestion key Alloy
// itself exports to. Its docker stdout is therefore redundant; left in
// the pipeline it would double-ingest every log as an unparsed Loki
// line (the blob this whole parsers/ system exists to avoid).
//
// So this module simply DROPS the fenwick container's stream. `docker
// logs fenwick` still works for humans (Deno keeps printing to the
// console); HyperDX gets the structured OTLP copy, not this one.

declare "fenwick" {
	argument "forward_to" { }

	loki.process "this" {
		forward_to = argument.forward_to.value

		stage.match {
			selector = "{container=\"fenwick\"}"
			action   = "drop"
		}
	}

	export "receiver" {
		value = loki.process.this.receiver
	}
}
