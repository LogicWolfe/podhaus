// fractal's Alloy. Shared modules in ../alloy-modules do the work: the
// sources below (containers and the systemd journal, which WSL2 runs) →
// chain (per-service parsers) → ship (Loki→OTLP bridge, enrich, batch,
// Alloy's own metrics, and the exporter to the ClickStack collector on
// bandicoot). The local model service's metrics are scraped here and handed
// to the same exporter.
//
// Per-service parsing is config-as-code in ../alloy-modules (one module per
// service, one chain for every host), so a service moving between hosts
// keeps its parsing with no change here. See docs/logging.md.

// Alloy's own pipeline spans under service `alloy`, sampled at 10%: span
// volume grows with the number of components, and they are kept for the
// pipeline's health, not request flow. Alloy allows a tracing block only in
// the root config. Its own log lines are not sent this way; the Docker source
// already reads them, and they would arrive twice.
tracing {
	sampling_fraction = 0.1
	write_to          = [podhaus.ship.run.input]
}

// The shared modules are read once, when the container starts. A push that
// changes one reaches this Alloy through the container recreate its content
// hash triggers, never as a reload inside the running process (see the tailer
// rule in docs/logging.md). Alloy has no read-once setting; a poll every ten
// years is one.
import.file "podhaus" {
	filename       = "/etc/alloy-modules"
	detector       = "poll"
	poll_frequency = "87600h"
}

podhaus.docker_logs "run" {
	host       = "fractal"
	forward_to = [podhaus.chain.run.receiver]
}

podhaus.journal "run" {
	host       = "fractal"
	forward_to = [podhaus.chain.run.receiver]
}

podhaus.chain "run" {
	forward_to = [podhaus.ship.run.receiver]
}

// Out to Numbat's relay address, through rathole to bilby's Caddy, which
// checks this client certificate, and across the LAN to the collector on
// bandicoot.
podhaus.ship "run" {
	host             = "fractal"
	endpoint         = "https://logs-ingest.pod.haus"
	client_cert_file = "/run/podhaus-secrets/fractal-cert.pem"
	client_key_file  = "/run/podhaus-secrets/fractal-key.pem"
}

// Local model service (llm/): both containers expose Prometheus metrics on
// dockernet, bridged to OTLP and handed to the ship module's exporter.
//
// llm-server is a llama.cpp router, which serves /metrics only by forwarding
// to the model process: the request must name the model (the preset's
// section name in llm/server/models.ini), and `autoload=false` is what keeps
// a scrape from loading the model while a game has the GPU. With no model
// loaded the router answers 400 and the scrape fails; that failed scrape is
// the "yielded" signal here, the watcher's llm_watcher_state is the
// authoritative one.
prometheus.scrape "llm_server" {
	targets = [{
		__address__      = "llm-server:8080",
		__metrics_path__ = "/metrics",
	}]
	params = {
		model    = ["qwen3.8-27b"],
		autoload = ["false"],
	}
	scrape_interval = "15s"
	forward_to      = [otelcol.receiver.prometheus.llm_server.receiver]
}

otelcol.receiver.prometheus "llm_server" {
	output {
		metrics = [otelcol.processor.transform.svc_llm_server.input]
	}
}

// The bridge carries no service.name; stamp the container name so metrics
// share a service with the container's logs (set by enrich.alloy).
otelcol.processor.transform "svc_llm_server" {
	error_mode = "ignore"

	metric_statements {
		context    = "metric"
		statements = [
			`set(resource.attributes["service.name"], "llm-server")`,
			`set(resource.attributes["host.name"], "fractal")`,
		]
	}

	output {
		metrics = [podhaus.ship.run.input]
	}
}

// llm-watcher: its state, the GPU's utilisation, memory, power and
// temperature, the guest's memory, and the slot pool. 15 s resolves a
// handoff's phases; the exact timings are in the handoff events.
prometheus.scrape "llm_watcher" {
	targets = [{
		__address__      = "llm-watcher:8081",
		__metrics_path__ = "/metrics",
	}]
	scrape_interval = "15s"
	forward_to      = [otelcol.receiver.prometheus.llm_watcher.receiver]
}

otelcol.receiver.prometheus "llm_watcher" {
	output {
		metrics = [otelcol.processor.transform.svc_llm_watcher.input]
	}
}

otelcol.processor.transform "svc_llm_watcher" {
	error_mode = "ignore"

	metric_statements {
		context    = "metric"
		statements = [
			`set(resource.attributes["service.name"], "llm-watcher")`,
			`set(resource.attributes["host.name"], "fractal")`,
		]
	}

	output {
		metrics = [podhaus.ship.run.input]
	}
}
