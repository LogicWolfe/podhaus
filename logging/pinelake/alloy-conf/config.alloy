// Pinelake's Alloy. Shared modules in ../alloy-modules do the work:
//   docker_logs → chain (per-service parsers) → Loki→OTLP bridge → enrich
//   → batch → logs-ingest.pod.haus with Pinelake's dedicated client
//   certificate. Plex's server log and the Flood job logs ride the same
//   path. macOS has no journald and the unified log has no Alloy source.
//
// Per-service parsing is config-as-code in ../alloy-modules (one module per
// service, one chain for every host), so a service moving between hosts
// keeps its parsing with no change here. See docs/monitoring.html.

// Internal-pipeline tracing — unified `alloy` service in HyperDX
// (same name on every host; one row per host).
tracing {
	sampling_fraction = 0.1
	write_to          = [otelcol.processor.batch.clickstack.input]
}

import.file "podhaus" {
	filename = "/etc/alloy-modules"
}

podhaus.docker_logs "run" {
	host       = "pinelake"
	forward_to = [podhaus.chain.run.receiver]
}

podhaus.plex_server_log "run" {
	host       = "pinelake"
	container  = "pinelake-plex"
	logs_dir   = "/var/log/podhaus/plex"
	timezone   = "America/Edmonton"
	forward_to = [podhaus.chain.run.receiver]
}

podhaus.flood_job_logs "run" {
	host       = "pinelake"
	container  = "pinelake-flood"
	flood_db   = "/var/log/podhaus/flood-db"
	forward_to = [podhaus.chain.run.receiver]
}

podhaus.chain "run" {
	forward_to = [otelcol.receiver.loki.clickstack.receiver]
}

otelcol.receiver.loki "clickstack" {
	output {
		logs = [podhaus.enrich.run.input]
	}
}

podhaus.enrich "run" {
	host   = "pinelake"
	output = [otelcol.processor.batch.clickstack.input]
}

prometheus.exporter.self "alloy" { }

prometheus.scrape "alloy_self" {
  targets         = prometheus.exporter.self.alloy.targets
  scrape_interval = "60s"
  forward_to      = [otelcol.receiver.prometheus.alloy_self.receiver]
}

otelcol.receiver.prometheus "alloy_self" {
  output {
    metrics = [otelcol.processor.transform.svc_alloy.input]
  }
}

otelcol.processor.transform "svc_alloy" {
  error_mode = "ignore"
  metric_statements {
    context = "metric"
    statements = [
      `set(resource.attributes["service.name"], "alloy")`,
      `set(resource.attributes["host"], "pinelake")`,
    ]
  }
  output {
    metrics = [otelcol.processor.batch.clickstack.input]
  }
}

otelcol.processor.batch "clickstack" {
  output {
    logs    = [otelcol.exporter.otlphttp.clickstack.input]
    metrics = [otelcol.exporter.otlphttp.clickstack.input]
    traces  = [otelcol.exporter.otlphttp.clickstack.input]
  }
}

otelcol.exporter.otlphttp "clickstack" {
  client {
    endpoint = "https://logs-ingest.pod.haus"
    headers  = {"authorization" = sys.env("CLICKSTACK_INGESTION_KEY")}
    tls {
      cert_file = "/run/podhaus-secrets/pinelake-cert.pem"
      key_file  = "/run/podhaus-secrets/pinelake-key.pem"
    }
    disable_keep_alives = true
  }
  retry_on_failure {
    max_elapsed_time = "30m"
  }
  sending_queue {
    queue_size = 100000
  }
}
