// Per-service log parser — clickstack-otel
//
// See komodo-op.alloy for the pattern/rationale.
//
// clickstack-otel (the OpenTelemetry Collector supervisor) emits
// zap-style JSON, one object per line:
//   {"level":"info","ts":1778902378.3935137,"logger":"supervisor",
//    "caller":"supervisor/supervisor.go:668","msg":"Connected ..."}
//
// This parser only reads `level` into `detected_level`; enrich.alloy
// upper-cases it and folds zap's dpanic/panic onto FATAL. The shared JSON
// step in enrich.alloy makes every field an attribute and the body `msg`.
// `ts` is not parsed: the row keeps Docker's receive time. Non-JSON lines
// pass through untouched.

declare "clickstack_otel" {
  argument "forward_to" { }

  loki.process "this" {
    forward_to = argument.forward_to.value

    stage.match {
      selector = "{service=\"clickstack-otel\"} |~ \"^\\\\{\""

      stage.json {
        expressions = {lvl = "level"}
      }

      stage.labels {
        values = {detected_level = "lvl"}
      }
    }
  }

  export "receiver" {
    value = loki.process.this.receiver
  }
}
