// Per-service log parser — indy-service
//
// See fenwick.alloy: indy-service (the indy-board stack on bilby) exports
// its own logs and spans to the ClickStack collector over OTLP, including
// the log lines and status reports its two boards send it, each tagged
// with `device`. Its docker stdout carries the same records, so this module
// drops the stream rather than ingest every record twice. `docker logs
// indy-service` still shows them.

declare "indy_service" {
	argument "forward_to" { }

	loki.process "this" {
		forward_to = argument.forward_to.value

		stage.match {
			selector = "{service=\"indy-service\"}"
			action   = "drop"
		}
	}

	export "receiver" {
		value = loki.process.this.receiver
	}
}
