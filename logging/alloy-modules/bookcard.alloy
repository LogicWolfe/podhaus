// Per-service log parser — bookcard
//
// See bookbinder.alloy: bookcard (the Kindle library service on bilby)
// exports its own spans and log records to the ClickStack collector over
// OTLP, each record on its request's trace. Its docker stdout carries the
// same records as JSON lines, so this module drops those rather than ingest
// every record twice. Lines that are not JSON pass through: they are what
// the process prints when it fails before or after its exporter runs (a
// config.json it cannot read, an exporter that will not build, a traceback).
// `docker logs bookcard` still shows everything.

declare "bookcard" {
	argument "forward_to" { }

	loki.process "this" {
		forward_to = argument.forward_to.value

		stage.match {
			selector = "{service=\"bookcard\"} |~ \"^\\\\{\""
			action   = "drop"
		}
	}

	export "receiver" {
		value = loki.process.this.receiver
	}
}
