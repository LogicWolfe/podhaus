// Per-service log parser — alloy
//
// See komodo-op.alloy for the pattern/rationale.
//
// Alloy emits its own logs as logfmt (UTC, RFC3339 nanosecond ts):
//   ts=2026-05-16T03:56:20.117255871Z level=info msg="finished
//     transferring logs" component_path=/ component_id=... written=956
//
// The `level` field becomes `detected_level` (enrich.alloy upper-cases it).
// The body is the whole line, so every logfmt field stays readable and
// searchable in it. The row keeps Docker's receive time; `ts` is not parsed.
//
// stage.logfmt mapping semantics: keys are the *extracted* variable names,
// values are the logfmt keys to read, so `lvl = "level"` reads logfmt key
// `level` into `lvl`.

declare "alloy" {
  argument "forward_to" { }

  loki.process "this" {
    forward_to = argument.forward_to.value

    // Drop the Docker tailer's "finished transferring logs" line when it
    // reports zero bytes written: a no-op poll report, not a record. A
    // stopped container that has never printed a line is re-polled every
    // 5 s for as long as it exists, because the tailer only stops
    // re-polling once it has read a line, and every poll logs this line.
    // Reports with bytes written and every other Alloy line are kept.
    stage.match {
      selector            = "{service=\"alloy\"} |= \"finished transferring logs\" |~ \"written=0( |$)\""
      action              = "drop"
      drop_counter_reason = "empty_docker_poll"
    }

    stage.match {
      selector = "{service=\"alloy\"}"

      stage.logfmt {
        mapping = {
          lvl = "level",
        }
      }

      stage.labels {
        values = { detected_level = "lvl" }
      }
    }
  }

  export "receiver" {
    value = loki.process.this.receiver
  }
}
