// Per-service log parser — clickstack-clickhouse
//
// See komodo-op.alloy for the pattern/rationale.
//
// ClickHouse server native log format (the container's local wall clock
// with no zone, dotted date, microseconds); the real server log goes to a
// file inside the container, only the tail of it (and entrypoint noise)
// reaches stdout:
//   2026.05.16 12:00:24.261660 [ 747 ] {ebe9491d-...} <Debug> default.otel_logs (...): Create MergeTreeSink, deduplicate=false
//   2026.05.16 12:00:25.324953 [ 700 ] {} <Trace> default.otel_logs (...): Removed 1 old parts
//
// Fields: <ts YYYY.MM.DD HH:MM:SS.uuuuuu> [ <thread> ] {<query_id>}
// <Level> <message>. The level words are full English: Information and
// Notice become INFO here; enrich.alloy upper-cases the rest and folds
// Warning onto WARN. The body is the whole line.
//
// Time: this parser never sets it. A stdout line keeps Docker's receive
// time. The same lines also arrive from ClickHouse's error-log file, whose
// time clickhouse-error-log.alloy has already parsed in the container's
// zone before the line reaches this chain.
//
// Entrypoint / init lines (e.g. `/entrypoint.sh: create new user
// 'default' instead 'default'`) do not match the regex and pass
// through this component unchanged.

declare "clickstack_clickhouse" {
	argument "forward_to" { }

	loki.process "this" {
		forward_to = argument.forward_to.value

		stage.match {
			selector = "{service=\"clickstack-clickhouse\"} |~ \"^\\\\d{4}\\\\.\\\\d{2}\\\\.\\\\d{2} \\\\d{2}:\\\\d{2}:\\\\d{2}\\\\.\\\\d+ \\\\[ \\\\d+ \\\\] \\\\{[^}]*\\\\} <[A-Za-z]+> \""

			stage.regex {
				expression = "^\\S+ \\S+ \\[ \\d+ \\] \\{[^}]*\\} <(?P<lvl>[A-Za-z]+)> "
			}

			stage.template {
				source   = "lvl"
				template = "{{ if or (eq .Value \"Information\") (eq .Value \"Notice\") }}INFO{{ else }}{{ .Value }}{{ end }}"
			}

			stage.labels {
				values = {detected_level = "lvl"}
			}
		}
	}

	export "receiver" {
		value = loki.process.this.receiver
	}
}
