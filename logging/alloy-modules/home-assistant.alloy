// Per-service log parser — home-assistant
//
// See komodo-op.alloy for the pattern/rationale.
//
// Home Assistant (Python logging) format. The leading timestamp is
// LOCAL wall-clock in the container's TZ, millisecond precision, then
// level / thread / logger name / message:
//   2026-05-16 11:34:52.126 ERROR (MainThread) [homeassistant.components.twinkly.coordinator] Error fetching twinkly data: ...
//
// ANSI color codes (HA wraps lines in \e[31m … \e[0m) are already
// stripped upstream by docker-logs.alloy's stage.decolorize.
//
// The body is the whole line. The bracketed logger name is also kept as
// the `logger` attribute, so one integration's lines are one filter away.
// The local timestamp is not parsed: every row keeps Docker's nanosecond
// receive time, which also keeps a traceback's continuation lines in
// order after their header.
//
// Lines that don't match the timestamp prefix pass through untouched:
//   - s6 supervisor startup banners ("s6-rc: info: service … started")
//   - multiline Python traceback continuations ("Traceback …", "  File …")
//
// Level vocabulary is Python's: DEBUG / INFO / WARNING / ERROR /
// CRITICAL. CRITICAL becomes FATAL here; enrich.alloy folds WARNING onto
// WARN.

declare "home_assistant" {
  argument "forward_to" { }

  loki.process "this" {
    forward_to = argument.forward_to.value

    stage.match {
      selector = "{service=\"home-assistant\"} |~ \"^\\\\d{4}-\\\\d{2}-\\\\d{2} \\\\d{2}:\\\\d{2}:\\\\d{2}\\\\.\\\\d+ [A-Z]+ \\\\([^)]+\\\\) \\\\[[^\\\\]]+\\\\]\""

      stage.regex {
        expression = "^\\S+ \\S+ (?P<lvl>[A-Z]+) \\([^)]+\\) \\[(?P<logger>[^\\]]+)\\]"
      }

      stage.template {
        source   = "lvl"
        template = "{{ if eq .Value \"CRITICAL\" }}FATAL{{ else }}{{ .Value }}{{ end }}"
      }

      stage.labels {
        values = { detected_level = "lvl", logger = "logger" }
      }
    }
  }

  export "receiver" {
    value = loki.process.this.receiver
  }
}
