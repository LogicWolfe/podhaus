// Per-service log parser — pocket-id
//
// See komodo-op.alloy for the pattern/rationale; follows pomerium.alloy's
// gated-JSON shape most closely.
//
// Pocket ID (the identity provider container `pocket-id`, on bilby
// today) emits one JSON object per line, RFC3339Nano local time with a
// numeric offset baked into the string:
//   {"time":"2026-09-10T10:19:55.159018574+08:00","level":"INFO","msg":"Request","app":"pocket-id","version":"2.9.0","status":200,"method":"GET","path":"/api/oidc/userinfo","query":"","route":"/api/oidc/userinfo","ip":"172.18.0.16","latency":3264818,"referer":"","user_agent":"Go-http-client/1.1","body_size":1683}
//   {"time":"2026-09-09T18:25:37.05433691+08:00","level":"WARN","msg":"Request with errors: Error #01: You are not signed in\n","app":"pocket-id","version":"2.9.0","status":401,"method":"GET","path":"/api/users/me", ...}
//   {"time":"2026-09-10T10:19:25.772180111+08:00","level":"INFO","msg":"Starting job","app":"pocket-id","version":"2.9.0","name":"SyncScim","id":"7d01f760-4793-4c59-93f3-73bbfac6145c"}
//
// `time` carries its own offset (+08:00, the container's local wall
// clock — Australia/Perth on bilby, the only host running pocket-id
// today), so RFC3339Nano parses it directly with no `location=`, same
// as pomerium.alloy, and stays correct if the container moves host.
// Fractional-second digit count varies (9 down to 8 seen above); Go's
// RFC3339Nano layout tolerates that.
//
// The body is deliberately left as the whole JSON line. Pocket ID's
// `Request` lines carry the path, the query (which holds the OIDC
// client_id), the status, the client ip and the user agent, and all of
// it must reach HyperDX; the collector promotes every field of a
// JSON-object body into LogAttributes, so they stay queryable, whereas
// rewriting the body to plain text would lose them. This parser only
// sets the timestamp from `time` and the severity from the JSON `level`
// field, upper-cased (already upper-case in practice, but ToUpper guards
// a future lower-case build). The timestamp stage is kept for now;
// docs/plans/structured-logging.html removes timestamp parsing for
// Docker sources, whose rows otherwise carry Docker's own capture time.
// The trailing "\n" inside some `msg` values is part of the JSON string,
// not of the line, so the body needs no trimming.

declare "pocket_id" {
  argument "forward_to" { }

  loki.process "this" {
    forward_to = argument.forward_to.value

    stage.match {
      selector = "{service=\"pocket-id\"}"

      // Gate the JSON handling on the line looking like a JSON object —
      // see pomerium.alloy: stage.timestamp's default "fudge" failure
      // action would otherwise back-date a non-JSON line (a startup
      // banner) to 1 ns after the previous JSON line's time.
      stage.match {
        selector = "{service=\"pocket-id\"} |~ \"^\\\\{\""

        stage.json {
          expressions = {
            lvl = "level",
            ts  = "time",
          }
        }

        stage.timestamp {
          source = "ts"
          format = "RFC3339Nano"
        }

        stage.template {
          source   = "lvl"
          template = "{{ ToUpper .Value }}"
        }

        stage.labels {
          values = { detected_level = "lvl" }
        }
      }
    }
  }

  export "receiver" {
    value = loki.process.this.receiver
  }
}
