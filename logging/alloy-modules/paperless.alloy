// Per-service log parser — paperless
//
// See komodo-op.alloy for the pattern/rationale.
//
// paperless-ngx (Django/Celery) log format, LOCAL time (the container's
// TZ), bracketed fields:
//   [2026-05-16 11:40:00,000] [INFO] [celery.beat] Scheduler: Sending due task ...
//
// The bracketed local time is stripped from Body and not parsed: the row
// keeps Docker's receive time. Levels are Python logging words; normalize
// WARNING→WARN and CRITICAL→FATAL so the detected_level label matches the
// canonical TRACE|DEBUG|INFO|WARN|ERROR|FATAL set (OTTL maps it to OTLP
// severity). Multiline tracebacks and any non-matching lines fall
// through stage.match untouched.

declare "paperless" {
  argument "forward_to" { }

  loki.process "this" {
    forward_to = argument.forward_to.value

    stage.match {
      selector = "{service=\"paperless\"}"

      stage.regex {
        expression = "^\\[\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2},\\d{3}\\] \\[(?P<lvl>[A-Z]+)\\] \\[(?P<comp>[^\\]]+)\\]\\s+(?P<msg>.*)$"
      }

      stage.template {
        source   = "lvl"
        template = "{{ if eq .Value \"WARNING\" }}WARN{{ else if eq .Value \"CRITICAL\" }}FATAL{{ else }}{{ .Value }}{{ end }}"
      }

      stage.labels {
        values = { detected_level = "lvl" }
      }

      stage.output {
        source = "msg"
      }
    }
  }

  export "receiver" {
    value = loki.process.this.receiver
  }
}
