// Per-service log parser — paperless
//
// See komodo-op.alloy for the pattern/rationale.
//
// paperless-ngx (Django/Celery) log format, LOCAL time (the container's
// TZ), bracketed fields:
//   [2026-05-16 11:40:00,000] [INFO] [celery.beat] Scheduler: Sending due task ...
//
// The body is the whole line. The third bracket, the Python logger name,
// is also kept as the `logger` attribute. The bracketed local time is not
// parsed: the row keeps Docker's receive time. Levels are Python logging
// words: CRITICAL becomes FATAL here; enrich.alloy folds WARNING onto
// WARN. Multiline tracebacks and any non-matching lines fall through
// stage.match untouched.

declare "paperless" {
	argument "forward_to" { }

	loki.process "this" {
		forward_to = argument.forward_to.value

		stage.match {
			selector = "{service=\"paperless\"} |~ \"^\\\\[\\\\d{4}-\\\\d{2}-\\\\d{2} \\\\d{2}:\\\\d{2}:\\\\d{2},\\\\d{3}\\\\] \\\\[[A-Z]+\\\\] \\\\[[^\\\\]]+\\\\]\""

			stage.regex {
				expression = "^\\[[^\\]]+\\] \\[(?P<lvl>[A-Z]+)\\] \\[(?P<logger>[^\\]]+)\\]"
			}

			stage.template {
				source   = "lvl"
				template = "{{ if eq .Value \"CRITICAL\" }}FATAL{{ else }}{{ .Value }}{{ end }}"
			}

			stage.labels {
				values = {detected_level = "lvl", logger = "logger"}
			}
		}
	}

	export "receiver" {
		value = loki.process.this.receiver
	}
}
