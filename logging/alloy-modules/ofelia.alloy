// Per-service log parser — ofelia
//
// See komodo-op.alloy for the pattern/rationale.
//
// Ofelia (the cron scheduler container: `ofelia` on bilby, `bandicoot-
// ofelia`, `pinelake-ofelia` — all normalised to service="ofelia" by
// docker-logs.alloy's prefix-stripping) logs three-letter level tags
// with NO year and NO timezone in the line itself:
//   Sep 10 10:22:00.312 INF Job stop job=search-index execution=66c3c9c597f2 stdout="[search-index] no HTML changes; skip\n" duration=297.394487ms failed=false skipped=false
//   Sep  9 16:56:03.726 ERR Job stop job=sky-cache-invalidate execution=9f9b9facaa3e error="error non-zero exit code: 6" stderr="curl: (6) Could not resolve host: gatus (Domain name not found)\n" duration=3.717301811s failed=true skipped=false
//   Sep  9 10:26:11.801 WRN Shutting down the process signal=terminated
//
// The printed time is the container's own local wall clock (from its TZ
// env var), so it differs by host. It is not parsed: the row keeps
// Docker's receive time, which is right on every host. The body is the
// whole line.
//
// Severity: the zerolog console short levels TRC/DBG/INF/WRN/ERR/FTL/PNC
// map to TRACE/DEBUG/INFO/WARN/ERROR/FATAL/FATAL (only INF, WRN and ERR
// have appeared in real output; the rest are mapped so they never land
// as a bare tag). Without this parser the level would come from the word
// "error" inside a job's own `error="..."` field, so a real failure with
// no literal "error" substring (a bare non-zero exit with no message)
// would go unflagged.

declare "ofelia" {
	argument "forward_to" { }

	loki.process "this" {
		forward_to = argument.forward_to.value

		stage.match {
			selector = "{service=\"ofelia\"} |~ \"^[A-Za-z]{3}\\\\s+\\\\d{1,2} \\\\d{2}:\\\\d{2}:\\\\d{2}\\\\.\\\\d{3} [A-Z]{3} \""

			stage.regex {
				expression = "^[A-Za-z]{3}\\s+\\d{1,2} \\d{2}:\\d{2}:\\d{2}\\.\\d{3} (?P<lvl>[A-Z]{3}) "
			}

			stage.template {
				source   = "lvl"
				template = "{{ if eq .Value \"TRC\" }}TRACE{{ else if eq .Value \"DBG\" }}DEBUG{{ else if eq .Value \"INF\" }}INFO{{ else if eq .Value \"WRN\" }}WARN{{ else if eq .Value \"ERR\" }}ERROR{{ else if or (eq .Value \"FTL\") (eq .Value \"PNC\") }}FATAL{{ else }}{{ .Value }}{{ end }}"
			}

			stage.labels {
				values = {detected_level = "lvl"}
			}
		}
	}

	export "receiver" {
		value = loki.process.this.receiver
	}
}
