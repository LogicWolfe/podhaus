// Per-service log parser — caddy
//
// See komodo-op.alloy for the pattern/rationale. Same zap-JSON shape as
// clickstack-otel.
//
// Caddy emits one zap JSON object per line, admin API and access logs
// both:
//   {"level":"info","ts":1788960526.0307655,"logger":"admin.api","msg":"received request","method":"GET","host":"127.0.0.1:2019","uri":"/config/", ...}
//
// This parser only reads `level` into `detected_level`; enrich.alloy
// upper-cases it and folds zap's dpanic/panic onto FATAL. The shared JSON
// step in enrich.alloy makes every field an attribute under its own name
// (an access line's `host` is the request's Host header) and the body
// `msg`. `ts` is not parsed: the row keeps Docker's receive time.
// Non-JSON lines (Caddy's own startup banner) are kept out of the JSON
// stage by the line filter, so they pass through untouched.

declare "caddy" {
	argument "forward_to" { }

	loki.process "this" {
		forward_to = argument.forward_to.value

		stage.match {
			selector = "{service=\"caddy\"} |~ \"^\\\\{\""

			stage.json {
				expressions = {lvl = "level"}
			}

			stage.labels {
				values = {detected_level = "lvl"}
			}
		}
	}

	export "receiver" {
		value = loki.process.this.receiver
	}
}
