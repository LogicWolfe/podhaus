// Per-service log parser — clickstack-mongo
//
// See komodo-op.alloy for the pattern/rationale.
//
// MongoDB Log v2: one structured-JSON object per line:
//   {"t":{"$date":"2026-05-16T11:56:30.664+08:00"},"s":"I",
//    "c":"NETWORK","id":22943,"ctx":"listener","msg":"Connection
//    accepted","attr":{...}}
//
// Field map: s = severity (single char), c = component, msg = the
// human message, attr = structured detail.
//
// This parser maps `s` onto a `detected_level` (the debug verbosities
// D1–D5 pass through and enrich.alloy folds them to DEBUG). The shared
// JSON step in enrich.alloy makes every field an attribute (`c`, `ctx`,
// `attr.remote`, `t.$date`, ...) and the body `msg`. The row keeps
// Docker's receive time; `t` is not parsed.
//
// The stages are gated on a JSON line filter, so a non-JSON line (an
// entrypoint message) passes through untouched.

declare "clickstack_mongo" {
	argument "forward_to" { }

	loki.process "this" {
		forward_to = argument.forward_to.value

		stage.match {
			selector = "{service=\"clickstack-mongo\"} |~ \"^\\\\{\""

			stage.json {
				expressions = {sev = "s"}
			}

			stage.template {
				source   = "sev"
				template = "{{ if eq .Value \"D\" }}DEBUG{{ else if eq .Value \"I\" }}INFO{{ else if eq .Value \"W\" }}WARN{{ else if eq .Value \"E\" }}ERROR{{ else if eq .Value \"F\" }}FATAL{{ else }}{{ .Value }}{{ end }}"
			}

			stage.labels {
				values = {detected_level = "sev"}
			}
		}
	}

	export "receiver" {
		value = loki.process.this.receiver
	}
}
