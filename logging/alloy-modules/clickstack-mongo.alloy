// Per-service log parser — clickstack-mongo
//
// See komodo-op.alloy for the pattern/rationale.
//
// MongoDB Log v2: one structured-JSON object per line:
//   {"t":{"$date":"2026-05-16T11:56:30.664+08:00"},"s":"I",
//    "c":"NETWORK","id":22943,"ctx":"listener","msg":"Connection
//    accepted","attr":{...}}
//
// Field map: s = severity (single char), c = component, msg = the
// human message, attr = structured detail (dropped from Body — it's
// noisy and varies per event; keep Body to component + message).
//
// Shaping: Mongo severity → canonical `detected_level` label (OTTL maps it
// to OTLP severity; the debug verbosities D1–D5 pass through and
// enrich.alloy folds them to DEBUG), Body reduced to
// "<component>  <message>". The row keeps Docker's receive time; `t` is
// not parsed.
//
// The stages are gated on a JSON line filter: a non-JSON line (an
// entrypoint message) would otherwise leave every extracted value unset
// and the templates would write "<no value>" into the level and Body. See
// hyperdx.alloy for that failure mode.

declare "clickstack_mongo" {
  argument "forward_to" { }

  loki.process "this" {
    forward_to = argument.forward_to.value

    stage.match {
      selector = "{service=\"clickstack-mongo\"} |~ \"^\\\\{\""

      stage.json {
        expressions = {
          sev  = "s",
          comp = "c",
          msg  = "msg",
        }
      }

      stage.template {
        source   = "lvl"
        template = "{{ if eq .sev \"D\" }}DEBUG{{ else if eq .sev \"I\" }}INFO{{ else if eq .sev \"W\" }}WARN{{ else if eq .sev \"E\" }}ERROR{{ else if eq .sev \"F\" }}FATAL{{ else }}{{ .sev }}{{ end }}"
      }

      stage.labels {
        values = { detected_level = "lvl" }
      }

      stage.template {
        source   = "body"
        template = "{{ .comp }}  {{ .msg }}"
      }

      stage.output {
        source = "body"
      }
    }
  }

  export "receiver" {
    value = loki.process.this.receiver
  }
}
