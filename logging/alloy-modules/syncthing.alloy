// Per-service log parser — syncthing
//
// See komodo-op.alloy for the pattern/rationale.
//
// Syncthing log format, the container's LOCAL wall clock (Perth on
// kangaroo, Edmonton on pinelake), 3-letter level:
//   2026-05-16 10:24:04 INF Established secure connection (device=...)
//   2026-05-16 10:55:05 WRN Failed to sync (path="WORK FOLDERS" ...)
//
// Levels: DBG/INF/WRN/ERR → canonical. The body is the whole line. The
// local time is not parsed: the row keeps Docker's receive time, which is
// right on every host whatever the container's time zone. Non-matching
// lines pass through to the generic OTTL fallback.

declare "syncthing" {
	argument "forward_to" { }

	loki.process "this" {
		forward_to = argument.forward_to.value

		stage.match {
			selector = "{service=\"syncthing\"} |~ \"^\\\\d{4}-\\\\d{2}-\\\\d{2} \\\\d{2}:\\\\d{2}:\\\\d{2} [A-Z]{3} \""

			stage.regex {
				expression = "^\\S+ \\S+ (?P<lvl>[A-Z]{3}) "
			}

			stage.template {
				source   = "lvl"
				template = "{{ if eq .Value \"DBG\" }}DEBUG{{ else if eq .Value \"INF\" }}INFO{{ else if eq .Value \"WRN\" }}WARN{{ else if eq .Value \"ERR\" }}ERROR{{ else }}{{ .Value }}{{ end }}"
			}

			stage.labels {
				values = {detected_level = "lvl"}
			}
		}
	}

	export "receiver" {
		value = loki.process.this.receiver
	}
}
