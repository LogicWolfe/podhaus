// Per-service log parser — gatus
//
// See komodo-op.alloy for the pattern/rationale.
//
// gatus log format (Go's standard logger, wall-clock date and time, then
// the message):
//   2026/05/16 11:33:32 [watchdog.executeEndpoint] Monitored group=...
//   2026/05/16 11:29:22 Received termination signal, attempting to ...
//
// Two real shapes: a bracketed `[component]` (a Go function name like
// `watchdog.executeEndpoint`, NOT a level) and bare lines with no
// bracket (`Shutting down`). The body is the whole line. The row keeps
// Docker's receive time; the in-line time is not parsed.
//
// Severity: gatus prints NO level word. Its logger (TwiN/logr) is created
// without the level prefix, so logr.Errorf and logr.Infof lines look the
// same. Left unset, the ClickStack collector keyword-scans the body and
// stamps ERROR on every watchdog line (the "err" in `errors=0`) and FATAL
// on any endpoint whose name contains "alert". So the level comes from
// the message text, mapped from gatus's own source (github.com/TwiN/gatus;
// the file and line references below are at commit 884f64d). The texts
// were audited at that commit, but gatus/compose.yaml runs the `latest`
// image: when gatus upgrades, re-check this wording against its source,
// because a reworded failure no longer matches and falls back to INFO.
//  - ERROR: the messages gatus logs with logr.Errorf or logr.Fatalf.
//    "Failed to send an alert" (watchdog/alerting.go:66, 111) and the
//    rest of the `Failed to <verb>` family (alert persistence in the same
//    file, storage writes in storage/store/sql/sql.go, the config reload
//    in main.go:237, the cookie-jar fatal in client/config.go:291); the
//    invalid-config reload (main.go:238); storage and shutdown failures
//    ("Save failed", "Query failed", "Silently ...", "Error closing SSH
//    tunnels"); a rejected push to an external endpoint ("Invalid token",
//    "Invalid duration", "... not found", api/external_endpoint.go:38-54);
//    and every `[controller.Handle]` line except its two info lines, since
//    controller/controller.go:32 and 37 log the listen error as
//    logr.Fatalf("[controller.Handle] %s") and exit. Error messages of
//    features podhaus does not configure (IAP, PagerDuty, incident.io,
//    security) are not listed.
//  - ERROR: a Go crash header, `panic: ` or `fatal error: ` at the start of
//    the line. gatus panics when its configuration or storage fails to
//    load (main.go:32, 105, 243; storage/store/store.go:113); the runtime
//    prints these without the date, so they never match the dated
//    selectors above.
//  - WARN: `success=false` (a monitored endpoint failing its conditions:
//    the endpoint is down, not gatus), and "Not sending alert" (the alert
//    triggered but its provider is not configured, watchdog/alerting.go:78
//    and 114, logged by gatus as a warning).
//  - INFO: everything else, including the stack-trace lines after a panic.

declare "gatus" {
	argument "forward_to" { }

	loki.process "this" {
		forward_to = argument.forward_to.value

		stage.match {
			selector = "{service=\"gatus\"}"

			stage.static_labels {
				values = {detected_level = "INFO"}
			}

			stage.match {
				selector = "{service=\"gatus\"} |= \"success=false\""

				stage.static_labels {
					values = {detected_level = "WARN"}
				}
			}

			stage.match {
				selector = "{service=\"gatus\"} |~ \"^\\\\d{4}/\\\\d{2}/\\\\d{2} \\\\d{2}:\\\\d{2}:\\\\d{2} \\\\[watchdog\\\\.handleAlertsTo(Trigger|Resolve)\\\\] Not sending alert \""

				stage.static_labels {
					values = {detected_level = "WARN"}
				}
			}

			stage.match {
				selector = "{service=\"gatus\"} |~ \"^\\\\d{4}/\\\\d{2}/\\\\d{2} \\\\d{2}:\\\\d{2}:\\\\d{2} (\\\\[[^\\\\]]+\\\\] )?(Failed to (check|create|decode|delete|execute|get|initialize|insert|load|merge|parse|persist|render|retrieve|save|scan|send|update) |The configuration file was updated, but it is not valid|Save failed|Query failed|Silently |Error closing |Invalid (token|duration) |(External e|E)ndpoint with key=\\\\S+ not found)\""

				stage.static_labels {
					values = {detected_level = "ERROR"}
				}
			}

			stage.match {
				selector = "{service=\"gatus\"} |~ \"^\\\\d{4}/\\\\d{2}/\\\\d{2} \\\\d{2}:\\\\d{2}:\\\\d{2} \\\\[controller\\\\.Handle\\\\] \" !~ \"\\\\] (Listening on |Server has shut down successfully)\""

				stage.static_labels {
					values = {detected_level = "ERROR"}
				}
			}

			stage.match {
				selector = "{service=\"gatus\"} |~ \"^(panic|fatal error): \""

				stage.static_labels {
					values = {detected_level = "ERROR"}
				}
			}
		}
	}

	export "receiver" {
		value = loki.process.this.receiver
	}
}
