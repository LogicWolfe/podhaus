// systemd journal for one Linux host: warning severity and worse from
// every unit, plus the full audit trail of logins, privilege use, OOM
// kills and the Docker daemon.
//
// Needs `/var/log/journal` and `/etc/machine-id` bound read-only into the
// Alloy container (see each host's compose). Only the Linux hosts
// instantiate this module; a unit a host does not run (earlyoom on
// numbat) simply matches nothing.
//
// `matches` are sd_journal matches: repeats of one field OR together and
// different fields AND, so each audit source below is its own component.
//  - `this`: PRIORITY 0–4 from everything. Mount failures, kernel faults
//    and every unit's warnings and errors.
//  - `sshd`, `sudo`, `earlyoom`, `docker`: the same journal at PRIORITY
//    5–7, which is where these log their routine events: sshd's logins
//    from `Accepted publickey` to `session closed`, sudo's command and
//    `session opened` lines, earlyoom's kill reports and dockerd's whole
//    log. Their priority 0–4 entries already arrive through `this`, so
//    each takes only 5–7 and nothing is shipped twice.
//    sshd and sudo are matched by SYSLOG_IDENTIFIER, not unit. sudo's
//    entries carry the caller's session scope or user manager as their
//    unit. sshd's accept is logged under sshd.service, but once the login
//    moves into its session scope the disconnect and `session closed`
//    lines land under that `session-N.scope` or under no unit. The
//    identifiers are `sshd` (the listener) and `sshd-session` (each
//    connection, on OpenSSH 9.8 and later).
// Entries with no PRIORITY field (the audit transport — SELinux AVC
// denials, ~1.6k a day on voltaire from the SSH remote-forward every
// session requests) match none of these.
//
// Labels: host, service_name=journald, stream=journal on every source,
// then unit, identifier, transport and priority from each entry, and `job`
// (the source component, which loki.source.journal adds itself).
// enrich.alloy turns them into the docs/logging.md schema and deletes
// them. The sources' labels never change (see the top of
// docker-logs.alloy); Alloy reads this module once, when its container
// starts, and anything new is derived in enrich.alloy. detected_level comes
// from the priority where the priority is the program's own: 0–4 always,
// and 5–7 except on the stdout transport. A program writing to stdout
// (dockerd, earlyoom) gets its unit's default priority, 6, for every line,
// so dockerd's `level=error` lines also sit at priority 6; those keep no
// detected_level and enrich.alloy reads the level word. earlyoom's kill
// lines carry no level word and are stamped WARN.

declare "journal" {
	argument "host" { }
	argument "forward_to" { }

	loki.relabel "fields" {
		forward_to = []

		rule {
			source_labels = ["__journal__systemd_unit"]
			target_label  = "unit"
		}

		rule {
			source_labels = ["__journal_syslog_identifier"]
			target_label  = "identifier"
		}

		rule {
			source_labels = ["__journal__transport"]
			target_label  = "transport"
		}

		rule {
			source_labels = ["__journal_priority"]
			target_label  = "priority"
		}
	}

	loki.source.journal "this" {
		path          = "/var/log/journal"
		matches       = "PRIORITY=0 PRIORITY=1 PRIORITY=2 PRIORITY=3 PRIORITY=4"
		max_age       = "12h"
		relabel_rules = loki.relabel.fields.rules
		labels        = {"host" = argument.host.value, "service_name" = "journald", "stream" = "journal"}
		forward_to    = [loki.process.severity.receiver]
	}

	loki.source.journal "sshd" {
		path          = "/var/log/journal"
		matches       = "SYSLOG_IDENTIFIER=sshd SYSLOG_IDENTIFIER=sshd-session PRIORITY=5 PRIORITY=6 PRIORITY=7"
		max_age       = "12h"
		relabel_rules = loki.relabel.fields.rules
		labels        = {"host" = argument.host.value, "service_name" = "journald", "stream" = "journal"}
		forward_to    = [loki.process.severity.receiver]
	}

	loki.source.journal "sudo" {
		path          = "/var/log/journal"
		matches       = "SYSLOG_IDENTIFIER=sudo PRIORITY=5 PRIORITY=6 PRIORITY=7"
		max_age       = "12h"
		relabel_rules = loki.relabel.fields.rules
		labels        = {"host" = argument.host.value, "service_name" = "journald", "stream" = "journal"}
		forward_to    = [loki.process.severity.receiver]
	}

	loki.source.journal "earlyoom" {
		path          = "/var/log/journal"
		matches       = "_SYSTEMD_UNIT=earlyoom.service PRIORITY=5 PRIORITY=6 PRIORITY=7"
		max_age       = "12h"
		relabel_rules = loki.relabel.fields.rules
		labels        = {"host" = argument.host.value, "service_name" = "journald", "stream" = "journal"}
		forward_to    = [loki.process.severity.receiver]
	}

	loki.source.journal "docker" {
		path          = "/var/log/journal"
		matches       = "_SYSTEMD_UNIT=docker.service PRIORITY=5 PRIORITY=6 PRIORITY=7"
		max_age       = "12h"
		relabel_rules = loki.relabel.fields.rules
		labels        = {"host" = argument.host.value, "service_name" = "journald", "stream" = "journal"}
		forward_to    = [loki.process.severity.receiver]
	}

	// Passes everything on unchanged. It keeps the name every source above
	// forwards to, so their arguments stay exactly as deployed (see the
	// top), while the mapping itself lives in journal_levels.
	loki.process "severity" {
		forward_to = [journal_levels.this.receiver]
	}

	journal_levels "this" {
		forward_to = argument.forward_to.value
	}
}

// The journal priority as a level. Its own declare so logging/tests can run
// it on stand-in entries without a journal.
declare "journal_levels" {
	argument "forward_to" { }

	loki.process "this" {
		forward_to = argument.forward_to.value

		stage.match {
			selector = "{priority=~\"[56]\", transport!=\"stdout\"}"

			stage.static_labels {
				values = {detected_level = "INFO"}
			}
		}

		stage.match {
			selector = "{priority=\"7\", transport!=\"stdout\"}"

			stage.static_labels {
				values = {detected_level = "DEBUG"}
			}
		}

		// earlyoom writes to stdout with no level word, and a kill is
		// the event it exists to report, so its kill line is a warning.
		// `to process` keeps out its start-up threshold line, which also
		// begins "sending SIGTERM".
		stage.match {
			selector = "{unit=\"earlyoom.service\"} |~ \"^sending SIG(TERM|KILL) to process \""

			stage.static_labels {
				values = {detected_level = "WARN"}
			}
		}

		stage.match {
			selector = "{priority=\"4\"}"

			stage.static_labels {
				values = {detected_level = "WARN"}
			}
		}

		stage.match {
			selector = "{priority=\"3\"}"

			stage.static_labels {
				values = {detected_level = "ERROR"}
			}
		}

		stage.match {
			selector = "{priority=~\"[0-2]\"}"

			stage.static_labels {
				values = {detected_level = "FATAL"}
			}
		}
	}

	export "receiver" {
		value = loki.process.this.receiver
	}
}
