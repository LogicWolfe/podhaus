// Container stdout/stderr for one host: Docker discovery → labels → tail
// → ANSI strip. Shared by every host; the only per-host input is the
// host name.
//
// Labels (enrich.alloy turns them into the docs/logging.md schema and
// deletes them):
//   host            this host's name, set by the tailer.
//   service         the container name with this host's own `<host>-`
//                   prefix stripped, so `pinelake-flood` on Pinelake and
//                   `flood` on bilby select the same parser module; Lumen's
//                   per-worktree index containers are all `lumen-warm`.
//                   enrich.alloy names containers outside a compose project
//                   from these labels (`forgejo-actions-task`, `unmanaged`).
//   container       the container name as Docker reports it.
//   stream          stdout / stderr.
//   compose_project, compose_service  from the compose labels.
//
// These labels are the tailer's identity and never change.
// loki.source.docker keys each container's saved read position on the
// container ID plus its whole label set, so a changed label starts that
// container's tailer again from the first line of its retained log, and
// every line is shipped a second time with its original timestamp. Derive
// or rename anything new in enrich.alloy, which runs after the tailer and
// keys nothing.
//
// Names are identity too. Saved positions live under the storage path at
// <import label>.<declare>.<instance label>/<component>.<label>/positions.yml
// (podhaus.docker_logs.run/loki.source.docker.containers/positions.yml), so
// renaming the tailer, this declare, a host's instance label or the
// import.file label loses every position and re-reads every retained log.
//
// The relabel rules, the discovery settings and the tailer's arguments may
// change, provided every container keeps exactly the labels it has now.
// Alloy reads this module once, when its container starts (the import in
// each host's config.alloy), so a change reaches it through the container
// recreate, and an Alloy that stops keeps every saved position. Changed in
// a running Alloy, a rule or Docker setting would restart every tailer, and
// a tailer stopped while Alloy keeps running deletes its saved position.
// logging/tests pins the rules, the tailer's arguments and the labels, so a
// change there is made deliberately, with its pins.
//
// Not collected: Lumen's throwaway `docker run --rm` search containers
// (label podhaus.lumen=true without podhaus.lumen.worktree); their stdout
// is the code-search request stream, source snippets included.
//
// The log schema test's Alloy containers (label podhaus.harness=true, see
// logging/tests) are collected like any other. They log with Docker's
// `none` driver, which has nothing to read, so while one runs this host's
// Alloy ships about two minutes of "could not fetch logs" error rows for
// it, until a rule here drops containers with that label.

declare "docker_logs" {
	argument "host" { }
	argument "forward_to" { }

	discovery.docker "containers" {
		host             = "unix:///var/run/docker.sock"
		refresh_interval = "30s"

		// List stopped containers too. Docker lists only running, paused
		// and restarting containers by default, so a container that stays
		// stopped for longer than one refresh, such as one Ofelia starts on
		// a schedule, would leave the list; its tailer would end and forget
		// its read position, and the next start would re-read the whole log
		// from the first line. Kept in the list, the same tailer resumes
		// where it stopped. That holds only because the first relabel rule
		// drops the network labels, which change when a container stops.
		// The filter matches state names exactly, so the default states are
		// listed alongside `exited`; `created` is left out because such a
		// container has never run and has no log. Cost: the tailer forgets
		// a position once a log stream ends, so an Alloy restart re-reads
		// each stopped container's log once.
		filter {
			name   = "status"
			values = ["restarting", "running", "paused", "exited"]
		}
	}

	docker_targets "this" {
		host    = argument.host.value
		targets = discovery.docker.containers.targets
	}

	// The rules run twice: on the discovered targets, and again inside the
	// tailer, which adds the per-stream `__meta_docker_container_log_stream`
	// label that only exists there. Whatever changes here must leave every
	// container's labels exactly as they are (see the top of this file).
	loki.source.docker "containers" {
		host          = "unix:///var/run/docker.sock"
		targets       = docker_targets.this.output
		forward_to    = [loki.process.decolorize.receiver]
		relabel_rules = docker_targets.this.rules
		labels        = {"host" = argument.host.value}
	}

	// Universal pre-shaping: strip ANSI so the per-service parsers (and
	// JSON stages) never see colour codes. komodo-core, home-assistant,
	// flood etc. emit raw ANSI.
	loki.process "decolorize" {
		forward_to = argument.forward_to.value

		stage.decolorize { }
	}
}

// The relabel rules that turn a discovered container into the labels
// above. Their own declare so logging/tests can run them on stand-in
// targets without a Docker socket.
declare "docker_targets" {
	argument "host" { }
	argument "targets" { }

	discovery.relabel "this" {
		targets = argument.targets.value

		// Drop the network and port labels. loki.source.docker keys each
		// tailer and its saved read position on the container ID plus this
		// whole label set, and a stopped container reports no IP address
		// and no ports, so with these labels every start and stop would
		// change the key and the replacement tailer would read the log from
		// the first line. The tailer reads only the container ID, and every
		// `__` label is stripped from the entries it sends, so nothing
		// downstream loses anything. Keep this rule first, so no rule can
		// copy one of these labels into a label that survives.
		rule {
			action = "labeldrop"
			regex  = "__address__|__meta_docker_network_.*|__meta_docker_port_.*"
		}

		// Lumen's throwaway `docker run --rm` containers (label
		// podhaus.lumen=true) stream MCP requests that include source
		// snippets from indexed repositories, under random Docker names.
		// Never tail them. The detached warm/index containers also carry
		// podhaus.lumen.worktree and are kept (renamed below). A missing
		// label is the empty string, so "true;" means lumen without a
		// worktree.
		rule {
			source_labels = [
				"__meta_docker_container_label_podhaus_lumen",
				"__meta_docker_container_label_podhaus_lumen_worktree",
			]
			regex  = "true;"
			action = "drop"
		}

		// Drop the leading slash that Docker prepends to container names.
		rule {
			source_labels = ["__meta_docker_container_name"]
			regex         = "/(.*)"
			target_label  = "container"
		}

		rule {
			source_labels = ["__meta_docker_container_name"]
			regex         = "/(?:" + argument.host.value + "-)?(.*)"
			target_label  = "service"
		}

		// Give the per-worktree `lumen-warm-<hash>` containers one `service`
		// label, so one parser selector and one service.name cover them.
		// Must follow the generic name rule above so it wins.
		rule {
			source_labels = ["__meta_docker_container_label_podhaus_lumen_worktree"]
			regex         = ".+"
			target_label  = "service"
			replacement   = "lumen-warm"
		}

		rule {
			source_labels = ["__meta_docker_container_log_stream"]
			target_label  = "stream"
		}

		rule {
			source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
			target_label  = "compose_project"
		}

		rule {
			source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
			target_label  = "compose_service"
		}
	}

	export "output" {
		value = discovery.relabel.this.output
	}

	export "rules" {
		value = discovery.relabel.this.rules
	}
}
