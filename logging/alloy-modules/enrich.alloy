// OTTL enrichment of bridged logs before export, shared by every host.
//
//  1. Stamp the host name as a RESOURCE attribute. The Loki→OTLP bridge
//     only carries the `host` label as a log attribute, and the ClickStack
//     collector promotes JSON body fields over log attributes — Pomerium,
//     Caddy's admin API and FerretDB all emit their own `host` field, so
//     LogAttributes['host'] lies for ~35k rows a day. ResourceAttributes
//     ['host'] is untouched by that promotion and is what the Gatus
//     staleness checks query.
//  2. Set service.name from the Docker container name. Without this
//     HyperDX's ServiceName column, Service Map and service filters are
//     all blank. File and journal sources that carry no container set
//     `service_name` instead.
//  3. Severity. The level is taken from the parser's `detected_level` when
//     there is one: parser modules set it from the service's real level
//     field, and it runs last and wins. Otherwise it is the FIRST level
//     word in the first ~60 characters of the body: the word must follow
//     the start of the line, `[`, whitespace, `=` or `"`, and be followed
//     by `]`, `:`, whitespace, `"` or the end. That reads `INFO:` in column
//     one, `level=warn`, `"level":"info"` and `[INFO]`, and the first word
//     winning keeps "[INFO] retrying after error: boom" INFO. A word must
//     stand alone, so "errors" is not "error". Lines with neither keep
//     whatever ClickStack infers.
//
//     Known limitation, accepted: because `=` and `"` count as delimiters,
//     a key or value that is a level word and comes before the real level
//     is read as the level. Measured live, the only case is indy-service's
//     `reset=Panic`, which reads as FATAL (7 rows in 22 hours); the
//     delimiters fix far more lines than that breaks.
//
//     Every level is normalised to TRACE DEBUG INFO WARN ERROR FATAL with
//     its OpenTelemetry number (1 5 9 13 17 21): WARNING folds to WARN,
//     ERR to ERROR, PANIC and zap's DPANIC to FATAL, and MongoDB's debug
//     verbosities D1–D5 to DEBUG. A parser level outside that vocabulary
//     keeps its own text and gets no number.

declare "enrich" {
	argument "host" { }
	argument "output" { }

	otelcol.processor.transform "this" {
		error_mode = "ignore"

		log_statements {
			context = "log"
			statements = [
				`set(resource.attributes["host"], "` + argument.host.value + `")`,

				`set(resource.attributes["service.name"], attributes["container"]) where attributes["container"] != nil`,
				`set(resource.attributes["service.name"], attributes["service_name"]) where attributes["service_name"] != nil`,

				`merge_maps(cache, ExtractPatterns(body, "(?i)^.{0,60}?(?:^|[\\[\\s=\"])(?P<level>trace|debug|info|warning|warn|error|err|fatal|panic)(?:[\\]:\\s\"]|$)"), "upsert")`,
				`set(cache["level"], ConvertCase(cache["level"], "upper")) where cache["level"] != nil`,
				`set(cache["level"], attributes["detected_level"]) where attributes["detected_level"] != nil`,

				`set(cache["level"], "WARN") where cache["level"] == "WARNING"`,
				`set(cache["level"], "ERROR") where cache["level"] == "ERR"`,
				`set(cache["level"], "FATAL") where cache["level"] == "PANIC" or cache["level"] == "DPANIC"`,
				`set(cache["level"], "DEBUG") where IsMatch(cache["level"], "^D[1-5]$")`,

				`set(severity_text, cache["level"]) where cache["level"] != nil`,
				`set(severity_number, 1) where cache["level"] == "TRACE"`,
				`set(severity_number, 5) where cache["level"] == "DEBUG"`,
				`set(severity_number, 9) where cache["level"] == "INFO"`,
				`set(severity_number, 13) where cache["level"] == "WARN"`,
				`set(severity_number, 17) where cache["level"] == "ERROR"`,
				`set(severity_number, 21) where cache["level"] == "FATAL"`,
			]
		}

		output {
			logs = argument.output.value
		}
	}

	export "input" {
		value = otelcol.processor.transform.this.input
	}
}
