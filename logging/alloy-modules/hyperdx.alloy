// Per-service log parser — hyperdx
//
// See komodo-op.alloy for the pattern/rationale.
//
// hyperdx (HyperDX / ClickStack app server, Node + pino) emits a
// bracketed component prefix followed by a pino JSON object:
//   [API] {"level":30,"time":1778903804921,"pid":14,"hostname":"...","req":{...},"msg":"HTTP GET /health"}
//   [ALERT-TASK] {"level":30,"time":1778903820031,"msg":"check-alerts started at ..."}
//
// The prefix moves to the `component` attribute (API, ALERT-TASK, ...) and
// the line becomes the JSON object alone, so the shared JSON step in
// enrich.alloy makes every pino field an attribute (`req.method`, `pid`,
// ...) and the body `msg`. pino's numeric `level` (10/20/30/40/50/60)
// becomes `detected_level`. `time` is not parsed: the row keeps Docker's
// receive time.
//
// Early-boot / framework lines that aren't `[COMP] {json}` skip the
// nested stage.match entirely and pass through untouched. The gate
// matters: Loki's template stage prints the literal "<no value>" for a
// variable that was never extracted, so without it every such line would
// get a bogus level.

declare "hyperdx" {
	argument "forward_to" { }

	loki.process "this" {
		forward_to = argument.forward_to.value

		stage.match {
			selector = "{service=\"hyperdx\"} |~ \"^\\\\[[^\\\\]]+\\\\] \\\\{\""

			stage.regex {
				expression = "^\\[(?P<component>[^\\]]+)\\]\\s+(?P<json>\\{.*\\})$"
			}

			stage.json {
				source      = "json"
				expressions = {lvl = "level"}
			}

			stage.template {
				source   = "lvl"
				template = "{{ if eq .Value \"10\" }}TRACE{{ else if eq .Value \"20\" }}DEBUG{{ else if eq .Value \"30\" }}INFO{{ else if eq .Value \"40\" }}WARN{{ else if eq .Value \"50\" }}ERROR{{ else if eq .Value \"60\" }}FATAL{{ else }}{{ .Value }}{{ end }}"
			}

			stage.labels {
				values = {detected_level = "lvl", component = "component"}
			}

			stage.output {
				source = "json"
			}
		}
	}

	export "receiver" {
		value = loki.process.this.receiver
	}
}
