// Per-service log parser — hyperdx
//
// See komodo-op.alloy for the pattern/rationale.
//
// hyperdx (HyperDX / ClickStack app server, Node + pino) emits a
// bracketed component prefix followed by a pino JSON object:
//   [API] {"level":30,"time":1778903804921,"pid":14,"hostname":"...","req":{...},"msg":"HTTP GET /health"}
//   [ALERT-TASK] {"level":30,"time":1778903820031,"msg":"check-alerts started at ..."}
//
// pino fields used: `level` (numeric: 10/20/30/40/50/60), `time`
// (epoch MILLISECONDS), `msg` (the human line). Component prefix
// (API, ALERT-TASK, ...) is preserved by re-prefixing Body so the
// HyperDX line still shows which subsystem logged it.
//
// Early-boot / framework lines that aren't `[COMP] {json}` (plain
// text, no JSON object) don't match the regex and are meant to fall
// straight through this component untouched.
//
// Bug fixed here: that passthrough claim was wrong. When the outer
// regex doesn't match at all, `comp`/`json`/`lvl`/`t`/`msg` are never
// extracted (not even as empty strings), and Loki's template stage
// prints the literal text "<no value>" for a referenced-but-never-set
// variable — not "". The old single stage.match ran the level template
// and the Body template unconditionally, so every early-boot line got
// detected_level="<no value>" (a bogus label, worse than unset) and
// Body="[<no value>] <no value>" (the original line destroyed).
// Reproduced against a real hyperdx startup line via the local harness
// before this fix. Fixed by nesting the JSON-handling stages inside a
// second stage.match gated on a line filter that the `[COMP] {json}`
// shape is actually present — lines that don't match skip the nested
// block entirely and are untouched by any of these stages, which is
// what "passes through clean" actually requires.

declare "hyperdx" {
	argument "forward_to" { }

	loki.process "this" {
		forward_to = argument.forward_to.value

		stage.match {
			selector = "{service=\"hyperdx\"}"

			stage.match {
				selector = "{service=\"hyperdx\"} |~ \"^\\\\[[^\\\\]]+\\\\] \\\\{\""

				// Split "[COMP] {json}" — the line filter above already
				// guarantees this shape, so the capture groups always land.
				stage.regex {
					expression = "^\\[(?P<comp>[^\\]]+)\\]\\s+(?P<json>\\{.*\\})$"
				}

				stage.json {
					source      = "json"
					expressions = {lvl = "level", t = "time", msg = "msg"}
				}

				// pino numeric level -> canonical UPPERCASE severity. OTTL
				// downstream maps detected_level to OTLP SeverityNumber.
				stage.template {
					source   = "lvl"
					template = "{{ if eq .Value \"10\" }}TRACE{{ else if eq .Value \"20\" }}DEBUG{{ else if eq .Value \"30\" }}INFO{{ else if eq .Value \"40\" }}WARN{{ else if eq .Value \"50\" }}ERROR{{ else if eq .Value \"60\" }}FATAL{{ else }}{{ .Value }}{{ end }}"
				}

				stage.labels {
					values = {detected_level = "lvl"}
				}

				// pino `time` is epoch milliseconds; "UnixMs" is the documented
				// Alloy/Loki predefined token for ms-since-epoch (peers: Unix,
				// UnixUs, UnixNs). The 13-digit string parses directly.
				stage.timestamp {
					source = "t"
					format = "UnixMs"
				}

				// Body = pino msg, re-prefixed with the component tag so the
				// subsystem (API / ALERT-TASK / ...) stays visible in HyperDX.
				stage.template {
					source   = "line"
					template = "[{{ .comp }}] {{ .msg }}"
				}

				stage.output {
					source = "line"
				}
			}
		}
	}

	export "receiver" {
		value = loki.process.this.receiver
	}
}
