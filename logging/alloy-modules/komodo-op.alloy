// Per-service log parser — komodo-op
//
// Config-as-code: one tracked file per service, shared by every host.
// Imported by each host's config.alloy via `import.file "podhaus"` and
// composed by chain.alloy. Adding a service = add a file here + one line
// in chain.alloy. Selectors match the `service` label (the container
// name with the host's own prefix stripped, so `pinelake-flood` and
// `flood` hit the same parser). See docs/logging.md.
//
// The rule every parser follows: it sets the severity and nothing else
// about the line. It reads the service's own level into `detected_level`
// (enrich.alloy upper-cases and normalises it), never rewrites or shortens
// the body, and never drops a field. A text line stays whole as the body;
// a JSON line is structured by the shared step in enrich.alloy. The
// in-line time is not parsed: a container's row keeps Docker's nanosecond
// receive time, which is correct whatever time zone the container prints
// in. Only a file source whose lines carry the only time parses it.
// Streams of other services pass through untouched (stage.match only acts
// on its selector).
//
// komodo-op log format (UTC):
//   2026/05/16 03:27:18 [INFO] Syncing Komodo secret 'OP__...'

declare "komodo_op" {
  argument "forward_to" { }

  loki.process "this" {
    forward_to = argument.forward_to.value

    stage.match {
      selector = "{service=\"komodo-op\"}"

      stage.regex {
        expression = "^\\d{4}/\\d{2}/\\d{2} \\d{2}:\\d{2}:\\d{2} \\[(?P<lvl>[A-Z]+)\\]\\s"
      }

      stage.labels {
        values = { detected_level = "lvl" }
      }
    }
  }

  export "receiver" {
    value = loki.process.this.receiver
  }
}
