#!/bin/bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
: "${OP_SERVICE_ACCOUNT_TOKEN:?run with: op-vault dev -- ./komodo-upgrade}"
op run --env-file komodo/compose.env -- \
  docker compose -p komodo -f komodo/ferretdb.compose.yaml --env-file komodo/compose.env pull
op run --env-file komodo/compose.env -- \
  docker compose -p komodo -f komodo/ferretdb.compose.yaml --env-file komodo/compose.env up -d
