# rclone config template.
#
# Structural fields (type, drive_id, drive_type) are committed here for
# review and history. Only the OAuth token JSON blob is secret. Each host
# stores its OWN OAuth token in 1P (separate refresh-token chains so the
# two hosts don't race-invalidate each other on token rotation):
#   - bilby:    op://Homelab/rclone-onedrive-token-bilby/notes-b64
#   - kangaroo: op://Homelab/rclone-onedrive-token-kangaroo/notes-b64
#
# Both fields are base64-encoded — the OAuth JSON gets through Komodo's
# env-file pipeline (which truncates at the first newline of plain
# multi-line content).
#
# Each backup stack's backrest-init container reads its host's
# RCLONE_ONEDRIVE_TOKEN_B64 Komodo Variable, base64-decodes it, then
# envsubst's it into ${RCLONE_ONEDRIVE_TOKEN} below. See
# backup/compose.shared.yaml for the init logic.
#
# IMPORTANT: rclone refreshes its OAuth token on every call and rewrites
# the live /rclone/rclone.conf (in the backrest-rclone named volume) in
# place. That means:
#   - The 1P token copy goes stale within 1-2 days of real use (OneDrive
#     invalidates each used refresh_token and issues a new one).
#   - The file in the named volume is the live source of truth for the
#     token after first use. 1P is only useful at cold bootstrap.
#   - The init container's render is idempotent: it only writes if the
#     file doesn't exist, so re-deploys preserve the live token.
#   - If a fresh bootstrap ever happens AFTER the 1P token has gone
#     stale (e.g., volume wipe + redeploy), rclone will reject the token
#     and re-OAuth is required.
#
# Re-OAuth recipe (per host — needs a GUI browser, run on a laptop):
#   1. brew install rclone (macOS) — or apt/dnf install on Linux
#   2. rclone authorize "onedrive"
#      (web browser opens; sign in to OneDrive, approve, then rclone
#       prints the JSON token to stdout)
#   3. Save the JSON to a temp file, e.g. /tmp/token.json
#   4. base64 -w0 < /tmp/token.json   (one-line output)
#   5. op item edit rclone-onedrive-token-<host> --vault Homelab \
#        "notes-b64[concealed]=<paste>"
#   6. docker restart komodo-op   (force Komodo Variable refresh)
#   7. Stop the affected backrest container, delete the backrest-rclone
#      named volume on that host, redeploy the backup stack — init
#      container will render fresh from the new 1P snapshot.
#
[onedrive]
type = onedrive
drive_id = 397B8A27385EB8E3
drive_type = personal
token = ${RCLONE_ONEDRIVE_TOKEN}
