#!/bin/sh
# This runs only as Backrest's backrest-state hook, so it is the sole writer
# of copied snapshots in Bilby's repository and completes before OneDrive sync.
set -eu

source_repository=/repos/podhaus-bandicoot
destination_repository=/repos/podhaus
source_repository_id=af91f4420f462b9a2fe6c5f27ba1259ee3fbf0fb9ecca5629544b8d46b517791
destination_repository_id=4f9bd4ec0f9b81cbf02e52b05a54892070a13f83c15f1e7c8f1b8578155cef63
today=$(date +%Y-%m-%d)
expected_plans='clickstack-mongo rustfs backrest-state komodo onepassword metube sonarr fenwick'

report_failure() {
  status=$?
  trap - EXIT
  wget -qO- --post-data='' \
    --header "Authorization: Bearer $GATUS_BACKREST_PUSH_TOKEN" \
    "$GATUS_BASE_URL/api/v1/endpoints/$GATUS_BACKREST_ENDPOINT_ID/external?success=false&error=offsite+mirror+failed" \
    >/dev/null || true
  wget -qO- --post-data='' \
    --header "Authorization: Bearer $GATUS_BANDICOOT_PUSH_TOKEN" \
    "$GATUS_BASE_URL/api/v1/endpoints/$GATUS_BACKREST_BANDICOOT_ENDPOINT_ID/external?success=false&error=offsite+mirror+failed" \
    >/dev/null || true
  exit "$status"
}

repository_id() {
  restic -r "$1" cat config --json | jq -er '.id'
}

require_current_snapshot() {
  repository=$1
  plan=$2
  restic -r "$repository" snapshots --json \
    --tag "created-by:bandicoot,plan:$plan" |
    jq -e --arg today "$today" '[.[] | select(.time | startswith($today))] | length > 0' >/dev/null
}

trap report_failure EXIT

[ -e "$source_repository/.podhaus-share-mounted" ]
[ -e "$destination_repository/.podhaus-share-mounted" ]
[ -n "${GATUS_BACKREST_PUSH_TOKEN:-}" ]
[ -n "${GATUS_BASE_URL:-}" ]
[ -n "${GATUS_BACKREST_ENDPOINT_ID:-}" ]
[ -n "${GATUS_BACKREST_BANDICOOT_ENDPOINT_ID:-}" ]
[ -n "${GATUS_BANDICOOT_PUSH_TOKEN:-}" ]

password_command='jq -er '\''.repos[] | select(.id == "podhaus") | .password'\'' /config/config.json'
export RESTIC_PASSWORD_COMMAND="$password_command"
export RESTIC_FROM_PASSWORD_COMMAND="$password_command"

[ "$(repository_id "$source_repository")" = "$source_repository_id" ]
[ "$(repository_id "$destination_repository")" = "$destination_repository_id" ]

for plan in $expected_plans; do
  require_current_snapshot "$source_repository" "$plan"
done

restic -r "$destination_repository" --retry-lock 1h copy \
  --from-repo "$source_repository" --tag 'created-by:bandicoot'
restic -r "$destination_repository" --retry-lock 1h forget \
  --tag 'created-by:bandicoot' --group-by host,paths,tags \
  --keep-daily 14 --keep-weekly 4 --keep-monthly 6 --prune

for plan in $expected_plans; do
  require_current_snapshot "$destination_repository" "$plan"
done

rclone sync --config /rclone/rclone.conf "$destination_repository" onedrive:Backups/podhaus-restic

trap - EXIT
