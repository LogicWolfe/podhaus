{
  "version": 4,
  "instance": "${BACKREST_INSTANCE}",
  "auth": {
    "disabled": true
  },
  "repos": [
    {
      "id": "podhaus-bandicoot",
      "uri": "/repos/podhaus-bandicoot",
      "password": "${RESTIC_REPO_PASSWORD}",
      "flags": [],
      "env": [],
      "prunePolicy": {
        "schedule": {
          "cron": "30 5 * * 0",
          "clock": "CLOCK_LOCAL"
        },
        "maxUnusedPercent": 10
      },
      "checkPolicy": {
        "schedule": {
          "cron": "45 5 * * 0",
          "clock": "CLOCK_LOCAL"
        },
        "readDataSubsetPercent": 10
      },
      "hooks": [
        {
          "conditions": ["CONDITION_ANY_ERROR"],
          "onError": "ON_ERROR_IGNORE",
          "actionCommand": {
            "command": "wget -qO- --post-data='' --header='Authorization: Bearer ${GATUS_BACKREST_PUSH_TOKEN}' '${GATUS_BASE_URL}/api/v1/endpoints/${GATUS_BACKREST_ENDPOINT_ID}/external?success=false&error=backrest+{{ .Task }}+failed+for+{{ .Plan.Id }}'"
          }
        }
      ],
      "autoUnlock": true,
      "autoInitialize": true
    }
  ],
  "plans": [
    {
      "id": "clickstack-mongo",
      "repo": "podhaus-bandicoot",
      "paths": ["/userdata/clickstack/mongo"],
      "schedule": {
        "cron": "0 4 * * *",
        "clock": "CLOCK_LOCAL"
      },
      "retention": {
        "policyTimeBucketed": {
          "daily": 14,
          "weekly": 4,
          "monthly": 6
        }
      },
      "hooks": [],
      "skipIfUnchanged": false
    },
    {
      "id": "backrest-state",
      "repo": "podhaus-bandicoot",
      "paths": ["/userdata/backrest-state"],
      "schedule": {
        "cron": "0 5 * * *",
        "clock": "CLOCK_LOCAL"
      },
      "retention": {
        "policyTimeBucketed": {
          "daily": 14,
          "weekly": 4,
          "monthly": 6
        }
      },
      "hooks": [
        {
          "conditions": ["CONDITION_SNAPSHOT_SUCCESS", "CONDITION_SNAPSHOT_SKIPPED"],
          "onError": "ON_ERROR_IGNORE",
          "actionCommand": {
            "command": "wget -qO- --post-data='' --header='Authorization: Bearer ${GATUS_BACKREST_PUSH_TOKEN}' '${GATUS_BASE_URL}/api/v1/endpoints/${GATUS_BACKREST_ENDPOINT_ID}/external?success=true'"
          }
        }
      ],
      "skipIfUnchanged": false
    },
    {
      "id": "rustfs",
      "repo": "podhaus-bandicoot",
      "paths": ["/userdata/rustfs"],
      "schedule": {
        "cron": "30 3 * * *",
        "clock": "CLOCK_LOCAL"
      },
      "retention": {
        "policyTimeBucketed": {
          "daily": 14,
          "weekly": 4,
          "monthly": 6
        }
      },
      "hooks": [],
      "skipIfUnchanged": false
    },
    {
      "id": "komodo",
      "repo": "podhaus-bandicoot",
      "paths": ["/userdata/komodo"],
      "schedule": {
        "cron": "40 4 * * *",
        "clock": "CLOCK_LOCAL"
      },
      "retention": {
        "policyTimeBucketed": {
          "daily": 14,
          "weekly": 4,
          "monthly": 6
        }
      },
      "hooks": [],
      "skipIfUnchanged": false
    },
    {
      "id": "onepassword",
      "repo": "podhaus-bandicoot",
      "paths": ["/userdata/onepassword"],
      "schedule": {
        "cron": "50 4 * * *",
        "clock": "CLOCK_LOCAL"
      },
      "retention": {
        "policyTimeBucketed": {
          "daily": 14,
          "weekly": 4,
          "monthly": 6
        }
      },
      "hooks": [],
      "skipIfUnchanged": false
    },
    {
      "id": "metube",
      "repo": "podhaus-bandicoot",
      "paths": ["/userdata/metube"],
      "schedule": {
        "cron": "10 4 * * *",
        "clock": "CLOCK_LOCAL"
      },
      "retention": {
        "policyTimeBucketed": {
          "daily": 14,
          "weekly": 4,
          "monthly": 6
        }
      },
      "hooks": [],
      "skipIfUnchanged": false
    },
    {
      "id": "sonarr",
      "repo": "podhaus-bandicoot",
      "paths": ["/userdata/sonarr"],
      "schedule": {
        "cron": "25 4 * * *",
        "clock": "CLOCK_LOCAL"
      },
      "retention": {
        "policyTimeBucketed": {
          "daily": 14,
          "weekly": 4,
          "monthly": 6
        }
      },
      "hooks": [],
      "skipIfUnchanged": false
    },
    {
      "id": "fenwick",
      "repo": "podhaus-bandicoot",
      "paths": ["/userdata/fenwick", "/userdata/signal-cli"],
      "schedule": {
        "cron": "15 4 * * *",
        "clock": "CLOCK_LOCAL"
      },
      "retention": {
        "policyTimeBucketed": {
          "daily": 14,
          "weekly": 4,
          "monthly": 6
        }
      },
      "hooks": [],
      "skipIfUnchanged": false
    }
  ]
}
