#!/bin/bash
# Apply current podhaus + fenwick config to running Komodo state —
# the local-iteration counterpart to a git push, plus the recovery
# path for procedure-definition changes that the GitHub push can't
# self-apply.
#
# Use this when:
#   - You've edited a stack.toml or compose.yaml locally and want it
#     applied WITHOUT committing+pushing (debug iteration).
#   - You've pushed an edit to komodo/sync/procedures.toml. The push
#     path can't apply procedure-stage changes by itself: Komodo's
#     resource::update::<Procedure> refuses to modify a procedure
#     that's currently running (explicit busy-guard in resource/mod.rs)
#     and the in-procedure RunSync's iterative sync loop bails after
#     10 retries. Run this from outside the procedure to apply the
#     procedure change.
#
# Flow:
#   0. RunAction(podhaus-load-local-tree) — mirrors bilby's working
#      checkout (~/repos/podhaus, bind-mounted read-only into Komodo
#      Core at /syncs/podhaus-local) into the Komodo-owned deploy tree
#      at /etc/komodo/repos/podhaus-deploy (bind-mounted at
#      /syncs/podhaus). This is what makes every step below deploy
#      LOCAL state regardless of origin/main — from here on, nothing
#      reads the working checkout, only the deploy tree it just wrote.
#   1. RunSync(podhaus) DIRECTLY via the API — not wrapped in a
#      procedure. Out of any procedure context, so Komodo's busy guard
#      on update::<Procedure> doesn't fire and procedure-definition
#      changes land cleanly. Surgical: only redeploys stacks whose
#      files actually changed (deploy reason "File contents for
#      compose.yaml have changed"); a clean tree triggers "No Changes"
#      and zero deploys. Do NOT add a `resource_type` filter here —
#      doing so scopes the sync's stack_map to the filtered type, and
#      the deploy sub-stage then treats every on-disk stack as
#      uncreated, triggering a fleet-wide "deploy on creation" cascade.
#   2. RunProcedure(podhaus-deploy) — its Stage 0 RunSync now sees no
#      diffs (pre-sync did them) so the in-procedure update::<Procedure>
#      is never invoked. Remaining stages handle the hash-inject
#      reconcile + surgical stack deploy + ofelia restart. Deliberately
#      NOT podhaus-push-deploy: that procedure's own Stage 0 is
#      PullRepo(podhaus-deploy), which would force the deploy tree back
#      to origin/main and clobber the local overlay step 0 just wrote.
#   3. RunProcedure(fenwick-push-deploy) — same shape for the fenwick
#      stack defs.
#
# Bootstrap (CreateResourceSync, CreateRepo/PullRepo for the
# podhaus-deploy tree, first sync, komodo-op wait) lives in
# `komodo-start` — this script assumes Komodo Core is up and the deploy
# tree + `podhaus` + `fenwick` ResourceSyncs already exist.

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
: "${OP_SERVICE_ACCOUNT_TOKEN:?run with: op-vault dev -- ./komodo-sync}"

api_key=$(op read "op://Homelab/Komodo API OnePassword Sync/username")
api_secret=$(op read "op://Homelab/Komodo API OnePassword Sync/credential")

komodo_api() {
  local endpoint="$1" payload="$2"
  curl -sf -X POST "http://localhost:9120/${endpoint}" \
    -H "Content-Type: application/json" \
    -H "X-Api-Key: ${api_key}" \
    -H "X-Api-Secret: ${api_secret}" \
    -d "$payload"
}

poll_until_complete() {
  local update_id="$1" label="$2"
  local update status success
  while :; do
    update=$(komodo_api read "$(jq -n --arg u "$update_id" \
      '{type:"GetUpdate",params:{id:$u}}')")
    status=$(echo "$update" | jq -r '.status')
    [ "$status" = "Complete" ] && break
    sleep 2
  done
  success=$(echo "$update" | jq -r '.success')
  echo "  ${label}: success=${success}"
  [ "$success" = "true" ]
}

run_sync() {
  local sync="$1"
  echo "→ pre-sync ${sync} (out-of-procedure)"
  local resp update_id
  resp=$(komodo_api execute "$(jq -n --arg s "$sync" \
    '{type:"RunSync",params:{sync:$s}}')")
  update_id=$(echo "$resp" | jq -r '._id."$oid"')
  poll_until_complete "$update_id" "${sync} sync"
}

run_procedure() {
  local procedure="$1"
  echo "→ ${procedure}"
  local resp update_id
  resp=$(komodo_api execute "$(jq -n --arg p "$procedure" \
    '{type:"RunProcedure",params:{procedure:$p}}')")
  update_id=$(echo "$resp" | jq -r '._id."$oid"')
  poll_until_complete "$update_id" "$procedure"
}

run_action() {
  local action="$1"
  echo "→ ${action}"
  local resp update_id
  resp=$(komodo_api execute "$(jq -n --arg a "$action" \
    '{type:"RunAction",params:{action:$a}}')")
  update_id=$(echo "$resp" | jq -r '._id."$oid"')
  poll_until_complete "$update_id" "$action"
}

run_action podhaus-load-local-tree
run_sync podhaus
run_procedure podhaus-deploy
run_procedure fenwick-push-deploy
run_procedure pets-push-deploy
run_procedure docs-push-deploy
