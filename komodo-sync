#!/bin/bash
# Steady-state RunSync + deploy-stale tool for ad-hoc local iteration.
#
# Use this when:
#   - You've edited a stack.toml or variables.toml locally and want it
#     applied WITHOUT committing+pushing (debug iteration).
#   - You want to force-redeploy any stack whose container is at a
#     commit older than `git HEAD` on bilby's working tree.
#
# Do NOT use this as a workaround for the push procedure — every
# `git push` to main fires `podhaus-push-deploy` which runs the
# Stage 0 RunSync + Stage 1 deploy-if-changed + Stage 2 linked-repo
# force-deploy automatically. This script is for local debug only.
#
# Bootstrap (CreateResourceSync, first sync, komodo-op wait) lives in
# `komodo-start` — this script assumes Komodo Core is up and the
# podhaus ResourceSync already exists.

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
export OP_SERVICE_ACCOUNT_TOKEN="$(cat OP_SERVICE_ACCOUNT_TOKEN)"

api_key=$(op read "op://Homelab/Komodo API OnePassword Sync/username")
api_secret=$(op read "op://Homelab/Komodo API OnePassword Sync/credential")

komodo_api() {
  local endpoint="$1" payload="$2"
  curl -sf -X POST "http://localhost:9120/${endpoint}" \
    -H "Content-Type: application/json" \
    -H "X-Api-Key: ${api_key}" \
    -H "X-Api-Secret: ${api_secret}" \
    -d "$payload"
}

echo "Reconciling stack definitions (RunSync)..."
komodo_api execute '{
  "type": "RunSync",
  "params": { "sync": "podhaus" }
}' > /dev/null
sleep 3

# Redeploy any stack whose containers were built from a commit older
# than current HEAD. Komodo tracks the commit hash that produced the
# running compose; comparing it against git HEAD identifies stale
# stacks without us having to walk the diff ourselves.
head=$(git rev-parse HEAD)
echo
echo "Checking deployed-hash vs current HEAD (${head:0:8})..."

mapfile -t stacks < <(komodo_api read '{"type":"ListStacks","params":{}}' | jq -r '.[] | .name')

stale=()
for stack in "${stacks[@]}"; do
  deployed=$(komodo_api read "$(jq -n --arg s "$stack" '{type:"GetStack",params:{stack:$s}}')" | jq -r '.info.deployed_hash // empty')
  if [ -z "$deployed" ]; then
    # Never deployed. Komodo's sync deploy step + `deploy = true` in
    # stack.toml means a fresh deploy gets triggered on next sync run
    # automatically; we mirror that here by including never-deployed
    # stacks in the deploy list.
    stale+=("$stack")
    echo "  $stack  (never deployed)"
    continue
  fi
  if [ "$deployed" != "$head" ]; then
    stale+=("$stack")
    echo "  $stack  (deployed ${deployed:0:8})"
  fi
done

if [ ${#stale[@]} -eq 0 ]; then
  echo "  No stale stacks."
  echo "Done"
  exit 0
fi

echo
echo "Redeploying ${#stale[@]} stale stack(s)..."
for stack in "${stale[@]}"; do
  printf "  %s..." "$stack"
  komodo_api execute "$(jq -n --arg s "$stack" '{type:"DeployStack",params:{stack:$s}}')" > /dev/null
  echo " queued."
done

echo "Done"
