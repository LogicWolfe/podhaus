#!/bin/bash
# Apply current podhaus + fenwick config to running Komodo state —
# the local-iteration counterpart to a git push.
#
# Use this when:
#   - You've edited a stack.toml or compose.yaml locally and want it
#     applied WITHOUT committing+pushing (debug iteration).
#
# Thin wrapper around the same Komodo procedures the GitHub push
# webhooks fire (`podhaus-push-deploy` + `fenwick-push-deploy`), so
# behavior is identical to a push without the commit. The single
# source of truth for "what 'apply config' means" — stage ordering,
# linked-repo force-deploys, future cross-cutting steps like an
# ofelia label-refresh restart — lives in komodo/sync/procedures.toml.
# This script just triggers them and polls until done.
#
# Bootstrap (CreateResourceSync, first sync, komodo-op wait) lives in
# `komodo-start` — this script assumes Komodo Core is up and the
# `podhaus` + `fenwick` ResourceSyncs already exist.

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
export OP_SERVICE_ACCOUNT_TOKEN="$(cat OP_SERVICE_ACCOUNT_TOKEN)"

api_key=$(op read "op://Homelab/Komodo API OnePassword Sync/username")
api_secret=$(op read "op://Homelab/Komodo API OnePassword Sync/credential")

komodo_api() {
  local endpoint="$1" payload="$2"
  curl -sf -X POST "http://localhost:9120/${endpoint}" \
    -H "Content-Type: application/json" \
    -H "X-Api-Key: ${api_key}" \
    -H "X-Api-Secret: ${api_secret}" \
    -d "$payload"
}

run_procedure() {
  local procedure="$1"
  echo "→ ${procedure}"

  local resp update_id update status success
  resp=$(komodo_api execute "$(jq -n --arg p "$procedure" \
    '{type:"RunProcedure",params:{procedure:$p}}')")
  update_id=$(echo "$resp" | jq -r '._id."$oid"')

  while :; do
    update=$(komodo_api read "$(jq -n --arg u "$update_id" \
      '{type:"GetUpdate",params:{id:$u}}')")
    status=$(echo "$update" | jq -r '.status')
    [ "$status" = "Complete" ] && break
    sleep 2
  done

  success=$(echo "$update" | jq -r '.success')
  echo "  ${procedure}: success=${success}"
  [ "$success" = "true" ]
}

run_procedure podhaus-push-deploy
run_procedure fenwick-push-deploy
