#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

TF_DIR="${TF_DIR:-terraform}"
APPLICATION_IP="${NUMBAT_APPLICATION_IPV4:-$(terraform -chdir="$TF_DIR" output -raw numbat_application_ipv4)}"
RELAY_IP="${NUMBAT_RELAY_IPV4:-$(terraform -chdir="$TF_DIR" output -raw numbat_relay_ipv4)}"
SSH_HOST="${NUMBAT_SSH_HOST:-root@$APPLICATION_IP}"
REMOTE_DIR=/opt/komodo-periphery
REPO_DIR="$REMOTE_DIR/etc-komodo/repos/podhaus-numbat"
KEYS_DIR="${BILBY_KEYS_DIR:-/opt/komodo/keys}"

SOCK=""
for candidate in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/op-unlock/agent.sock" /tmp/op-unlock-*.sock; do
  [ -S "$candidate" ] || continue
  if SSH_AUTH_SOCK="$candidate" ssh-add -l >/dev/null 2>&1; then
    SOCK="$candidate"
    break
  fi
done
[ -n "$SOCK" ] || { echo "run op-unlock first" >&2; exit 1; }
export SSH_AUTH_SOCK="$SOCK"

host_key="$(terraform -chdir="$TF_DIR" output -raw numbat_ssh_host_public_key)"
known_hosts_dir="${XDG_STATE_HOME:-$HOME/.local/state}/podhaus"
known_hosts_file="$known_hosts_dir/numbat-known-hosts"
install -d -m 700 "$known_hosts_dir"
ssh_target="${SSH_HOST#*@}"
printf '%s %s\n[%s]:2222 %s\n%s %s\n' \
  "$APPLICATION_IP" "$host_key" "$APPLICATION_IP" "$host_key" "$ssh_target" "$host_key" \
  > "$known_hosts_file"
chmod 600 "$known_hosts_file"

common=(-o "IdentityAgent=$SOCK" -o BatchMode=yes -o StrictHostKeyChecking=yes -o "UserKnownHostsFile=$known_hosts_file" -o ConnectTimeout=10)
if [ -n "${NUMBAT_SSH_PORT:-}" ]; then
  port="$NUMBAT_SSH_PORT"
elif ssh "${common[@]}" -p 2222 "$SSH_HOST" true 2>/dev/null; then
  port=2222
else
  port=22
fi
remote() { ssh "${common[@]}" -p "$port" "$SSH_HOST" "$@"; }
copy() { scp -q "${common[@]}" -P "$port" "$1" "$SSH_HOST:$2"; }

work_dir="$(mktemp -d)"
trap 'find "$work_dir" -depth -delete' EXIT
sed \
  -e "s/\${NUMBAT_APPLICATION_IPV4}/$APPLICATION_IP/g" \
  -e "s/\${NUMBAT_RELAY_IPV4}/$RELAY_IP/g" \
  numbat/host/podhaus.nft > "$work_dir/podhaus.nft"
sed -e "s/\${NUMBAT_RELAY_IPV4}/$RELAY_IP/g" \
  numbat/host/20-relay-ip > "$work_dir/20-numbat-relay-ip"

echo "== host packages and configuration =="
root_password="$(op read 'op://Homelab/Numbat Root/password')"
printf 'root:%s\n' "$root_password" | remote chpasswd
unset root_password
remote "dnf -y install dnf-plugins-core git nftables policycoreutils-python-utils qemu-guest-agent"
remote "dnf -y config-manager --add-repo https://download.docker.com/linux/rhel/docker-ce.repo >/dev/null"
remote "dnf -y install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin"
remote "packages=\$(rpm -qa 'cockpit*'); [ -z \"\$packages\" ] || dnf -y remove \$packages"
remote "install -d -m 755 /etc/nftables /etc/docker /etc/NetworkManager/dispatcher.d"
copy numbat/host/bootstrap-sshd_config /etc/ssh/numbat-bootstrap-sshd_config
copy numbat/host/bootstrap-sshd.service /etc/systemd/system/numbat-bootstrap-sshd.service
copy "$work_dir/20-numbat-relay-ip" /etc/NetworkManager/dispatcher.d/20-numbat-relay-ip
copy "$work_dir/podhaus.nft" /etc/nftables/podhaus.nft
copy numbat/host/podhaus-nftables /usr/local/sbin/podhaus-nftables
copy numbat/host/podhaus-nftables.service /etc/systemd/system/podhaus-nftables.service
copy numbat/host/docker-daemon.json /etc/docker/daemon.json
copy pomerium/keys/user-ca.pub /etc/ssh/pomerium-user-ca.pub
copy numbat/host/00-podhaus-final.conf /etc/ssh/sshd_config.d/00-podhaus-final.conf
remote "chmod 600 /etc/ssh/numbat-bootstrap-sshd_config; chmod 755 /etc/NetworkManager/dispatcher.d/20-numbat-relay-ip /usr/local/sbin/podhaus-nftables; semanage port -a -t ssh_port_t -p tcp 2222 2>/dev/null || semanage port -m -t ssh_port_t -p tcp 2222; systemctl daemon-reload; systemctl enable --now numbat-bootstrap-sshd.service qemu-guest-agent.service docker.service; systemctl restart docker.service; /etc/NetworkManager/dispatcher.d/20-numbat-relay-ip eth0 up; docker network inspect dockernet >/dev/null 2>&1 || docker network create dockernet; sshd -t; systemctl restart sshd.service"

echo "== relay first =="
remote "install -d -m 700 $REMOTE_DIR/keys; install -d -m 755 $REMOTE_DIR/etc-komodo/repos"
if remote "test -d $REPO_DIR/.git"; then
  remote "git -C $REPO_DIR pull --ff-only"
else
  remote "git clone --depth 1 --branch main https://github.com/LogicWolfe/podhaus.git $REPO_DIR"
fi
noise_private="$(op read 'op://Homelab/Rathole Relay/noise_private_key')"
for name in public_tls forgejo_ssh protected_http bilby_ssh voltaire_ssh kangaroo_ssh; do
  value="$(op read "op://Homelab/Numbat Rathole/$name")"
  printf 'RATHOLE_%s_TOKEN=%s\n' "$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')" "$value"
done > "$work_dir/relay.env"
printf 'RATHOLE_NOISE_LOCAL_PRIVATE_KEY=%s\n' "$noise_private" >> "$work_dir/relay.env"
copy "$work_dir/relay.env" "$REPO_DIR/relay/numbat/.env"
remote "chmod 600 $REPO_DIR/relay/numbat/.env; cd $REPO_DIR/relay/numbat && docker compose -p numbat-relay up -d --build; test \"\$(docker inspect -f '{{.State.Running}}' numbat-rathole-server)\" = true"

echo "== Periphery =="
for key in core.pub numbat-periphery.key; do
  [ -f "$KEYS_DIR/$key" ] || { echo "missing $KEYS_DIR/$key" >&2; exit 1; }
done
remote "install -d -m 700 $REMOTE_DIR/keys; install -d -m 755 $REMOTE_DIR/etc-komodo"
remote "cat > $REMOTE_DIR/keys/periphery.key && chmod 600 $REMOTE_DIR/keys/periphery.key" < "$KEYS_DIR/numbat-periphery.key"
remote "cat > $REMOTE_DIR/keys/core.pub && chmod 644 $REMOTE_DIR/keys/core.pub" < "$KEYS_DIR/core.pub"
copy numbat/periphery/compose.yaml "$REMOTE_DIR/compose.yaml"
printf 'TZ=Australia/Perth\n' | remote "cat > $REMOTE_DIR/.env && chmod 600 $REMOTE_DIR/.env"
printf '' | remote "cat > $REMOTE_DIR/etc-komodo/periphery.config.toml && chmod 600 $REMOTE_DIR/etc-komodo/periphery.config.toml"
remote "cd $REMOTE_DIR && docker compose -p komodo-periphery up -d"

echo "== recovery plane =="
copy tailscale-recovery-bootstrap /tmp/tailscale-recovery-bootstrap
recovery_key="$(op read 'op://Homelab/Tailscale Recovery Auth Key/password')"
printf '%s\n' "$recovery_key" | remote "chmod 700 /tmp/tailscale-recovery-bootstrap; /tmp/tailscale-recovery-bootstrap --hostname numbat-recovery; rm -f /tmp/tailscale-recovery-bootstrap"

echo "== wait for Komodo =="
api_key="$(op read 'op://Homelab/Komodo API OnePassword Sync/username')"
api_secret="$(op read 'op://Homelab/Komodo API OnePassword Sync/credential')"
for attempt in $(seq 1 30); do
  state="$(curl -sf -X POST http://localhost:9120/read -H 'Content-Type: application/json' \
    -H "X-Api-Key: $api_key" -H "X-Api-Secret: $api_secret" \
    -d '{"type":"ListServers","params":{}}' | jq -r '.[] | select(.name=="numbat") | .info.state' || true)"
  [ "$state" = Ok ] && break
  sleep 4
done
[ "$state" = Ok ] || { echo "numbat did not reach state=Ok" >&2; exit 1; }

echo "== close bootstrap surface =="
remote "systemctl enable podhaus-nftables.service; systemctl reload-or-restart podhaus-nftables.service; systemctl disable numbat-bootstrap-sshd.service; systemctl mask cockpit.socket 2>/dev/null || true; systemd-run --quiet --collect --unit podhaus-close-bootstrap-ssh --on-active=3s systemctl stop numbat-bootstrap-sshd.service"
echo "numbat state=Ok; bootstrap SSH closed"
