[Unit]
Description=Wait for QNAP NFS (10.0.0.25:2049) to be reachable
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'for i in $(seq 1 90); do if exec 3<>/dev/tcp/10.0.0.25/2049 2>/dev/null; then exec 3<&-; exec 3>&-; exit 0; fi; sleep 2; done; exit 0'
TimeoutStartSec=200
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
