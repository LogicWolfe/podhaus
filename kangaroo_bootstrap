#!/bin/bash
# kangaroo_bootstrap — get kangaroo to "comfortable Komodo universe" state.
#
# Run from bilby. Idempotent — safe to re-run any time.
#
# What it does (in order):
#   1. Verify SSH + Docker on kangaroo.
#   2. Create periphery dir layout under /share/CACHEDEV2_DATA/Container.
#   3. SCP keys (private + Core's pub) and render config (TZ + GitHub PAT).
#   4. SSH-execute `docker compose up -d`.
#   5. Wait for Periphery health (outbound dial settles via Core in <30s).
#   6. Idempotently install the QNAP boot-DOM autorun hook, plus the
#      Pomerium SSH CA trust start.sh it invokes at every boot.
#   7. Verify the committed kangaroo Server definition.
#
# v2 PKI + outbound: Periphery dials Core at ws://10.0.0.119:9120; auth is
# X25519 noise handshake. periphery.key (kangaroo-periphery.key on bilby)
# is SCPed in; core.pub is copied from bilby's keys volume. Pubkey is
# committed to komodo/keys/kangaroo-periphery.pub for Core's trust list.

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

# --- Config ---
KANGAROO_SSH="${KANGAROO_SSH:-admin@10.0.0.25}"
# Container state lives on CACHEDEV2 (Jump, the backed-up volume) per the
# placement rule in docs/storage.html — never CACHEDEV1/Pouch.
KANGAROO_DIR="/share/CACHEDEV2_DATA/Container/komodo-periphery"
# Container Station ships docker outside the default SSH PATH on QTS.
# Override via env if your install differs.
KANGAROO_DOCKER="${KANGAROO_DOCKER:-/share/CACHEDEV2_DATA/.qpkg/container-station/usr/bin/docker}"
PERIPHERY_HEALTH_TIMEOUT="${PERIPHERY_HEALTH_TIMEOUT:-120}"
BILBY_KEYS_DIR="${BILBY_KEYS_DIR:-/opt/komodo/keys}"

export OP_SERVICE_ACCOUNT_TOKEN="$(cat OP_SERVICE_ACCOUNT_TOKEN)"

log()  { printf '\e[1;34m▸\e[0m %s\n' "$*"; }
warn() { printf '\e[1;33m!\e[0m %s\n' "$*" >&2; }
fail() { printf '\e[1;31m✗\e[0m %s\n' "$*" >&2; exit 1; }
ok()   { printf '\e[1;32m✓\e[0m %s\n' "$*"; }

ssh_kangaroo() { ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new "$KANGAROO_SSH" "$@"; }

# --- 1. Preflight ---
log "Preflight: verifying SSH + Docker on kangaroo ($KANGAROO_SSH)"
ssh_kangaroo "echo OK" >/dev/null || fail "SSH to $KANGAROO_SSH failed. Check the host's reachable + your key is loaded."
ssh_kangaroo "$KANGAROO_DOCKER info >/dev/null 2>&1" || fail "Docker not available at $KANGAROO_DOCKER on kangaroo. Container Station running? Override KANGAROO_DOCKER if path differs."
ok "kangaroo reachable, Docker responsive"

# kangaroo is a homelab target like any other, but QTS has no Python so it
# can never be an Ansible host and the authorized_keys role cannot reach it.
# Rather than let that become a second, drifting policy, derive the same key
# set the role would compute for a non-dev homelab target: the operator's
# personal key plus every homelab development machine's machine key.
log "Deriving authorized keys from the Ansible inventory"
KANGAROO_KEYS="$("${PYTHON:-./.venv/bin/python}" - <<'PY'
import pathlib, yaml
inv = pathlib.Path("ansible/inventory")
children = yaml.safe_load((inv / "hosts.yml").read_text())["all"]["children"]
keys = [yaml.safe_load((inv / "group_vars/all.yml").read_text())["podhaus_personal_key"]]
for host in sorted(children["homelab_dev_machines"].get("hosts") or {}):
    keys.append(yaml.safe_load((inv / f"host_vars/{host}.yml").read_text())["podhaus_machine_key"])
print("\n".join(" ".join(k.split()) for k in keys))
PY
)" || fail "Could not derive the authorized key set from ansible/inventory."
[[ -n "$KANGAROO_KEYS" ]] || fail "Derived an empty authorized key set — refusing to continue."

log "Ensuring those keys are authorized on kangaroo"
# Appended rather than rendered whole: this is root's authorized_keys on an
# appliance whose firmware updates write to it, so clobbering the file could
# strip a QTS-managed entry and lock the box out. Revocation here is manual.
printf '%s\n' "$KANGAROO_KEYS" | ssh_kangaroo 'while IFS= read -r key; do [ -n "$key" ] || continue; grep -Fqx "$key" /root/.ssh/authorized_keys || printf "%s\n" "$key" >> /root/.ssh/authorized_keys; done'
ok "$(printf '%s\n' "$KANGAROO_KEYS" | wc -l | tr -d ' ') operator keys authorized"

log "Preflight: verifying v2 keypair material on bilby ($BILBY_KEYS_DIR)"
for f in core.pub kangaroo-periphery.key; do
    [ -f "$BILBY_KEYS_DIR/$f" ] || fail "Missing $BILBY_KEYS_DIR/$f — regenerate the keypairs (see docs/secrets.html)."
done
ok "keypair material present"

# --- 2. Directory layout ---
log "Ensuring directory layout on kangaroo: $KANGAROO_DIR"
ssh_kangaroo "mkdir -p '$KANGAROO_DIR/etc-komodo' '$KANGAROO_DIR/keys' && chmod 700 '$KANGAROO_DIR/keys'"
ok "directories ready"

# --- 2b. dockernet bridge ---
# Komodo-deployed kangaroo stacks declare dockernet as external; a fresh
# Container Station install doesn't have it (bit the 2026-06 rebuild).
log "Ensuring dockernet bridge on kangaroo"
ssh_kangaroo "$KANGAROO_DOCKER network inspect dockernet >/dev/null 2>&1 || $KANGAROO_DOCKER network create dockernet"
ok "dockernet present"

# --- 3a. Ship keys (private + Core's pub) ---
log "Shipping v2 PKI keys to kangaroo"
# Stream via stdin so the privkey never appears on disk anywhere except
# bilby's /opt/komodo/keys/ and kangaroo's keys dir.
ssh_kangaroo "cat > '$KANGAROO_DIR/keys/periphery.key' && chmod 600 '$KANGAROO_DIR/keys/periphery.key'" < "$BILBY_KEYS_DIR/kangaroo-periphery.key"
ssh_kangaroo "cat > '$KANGAROO_DIR/keys/core.pub'      && chmod 644 '$KANGAROO_DIR/keys/core.pub'"      < "$BILBY_KEYS_DIR/core.pub"
ok "periphery.key + core.pub staged"

# --- 3b. Render and ship .env ---
log "Rendering .env (TZ only — outbound auth is keypair-based)"
TZ_VALUE="Australia/Perth"
{
    printf 'TZ=%s\n' "$TZ_VALUE"
} | ssh_kangaroo "cat > '$KANGAROO_DIR/.env' && chmod 600 '$KANGAROO_DIR/.env'"
ok ".env staged on kangaroo"

log "Shipping compose.yaml to kangaroo"
scp -q kangaroo/periphery/compose.yaml "$KANGAROO_SSH:$KANGAROO_DIR/compose.yaml"
ok "compose.yaml staged"

# --- 3c. Render and ship periphery.config.toml ---
# Periphery config carries the GitHub PAT for Komodo's Linked Repo to clone
# private repos via HTTPS (Komodo doesn't support SSH cloning). Lives under
# the bind-mounted /etc/komodo dir so it's persisted across container restarts.
log "Rendering periphery.config.toml from 1Password (GitHub PAT)"
GITHUB_PAT="$(op read 'op://Homelab/Homelab GitHub Personal Access Token/token')"
{
    printf '# Auto-rendered by kangaroo_bootstrap. Do not edit on the host —\n'
    printf '# changes here will be overwritten on next bootstrap re-run.\n\n'
    printf '[[git_provider]]\n'
    printf 'domain = "github.com"\n'
    printf 'accounts = [\n'
    printf '    { username = "LogicWolfe", token = "%s" },\n' "$GITHUB_PAT"
    printf ']\n'
} | ssh_kangaroo "cat > '$KANGAROO_DIR/etc-komodo/periphery.config.toml' && chmod 600 '$KANGAROO_DIR/etc-komodo/periphery.config.toml'"
ok "periphery.config.toml staged"

# --- 4. Bring up Periphery ---
log "Starting Periphery via docker compose up -d on kangaroo"
ssh_kangaroo "cd '$KANGAROO_DIR' && $KANGAROO_DOCKER compose up -d"
ok "compose up issued"

# --- 5. Wait for Periphery to dial Core successfully ---
# Outbound mode: no inbound listener to probe. Health = Core sees the
# Server as state=Ok via the websocket connection. We probe via the
# Komodo API from bilby.
log "Waiting for kangaroo Periphery to dial Core (timeout ${PERIPHERY_HEALTH_TIMEOUT}s)"
api_key=$(op read "op://Homelab/Komodo API OnePassword Sync/username")
api_secret=$(op read "op://Homelab/Komodo API OnePassword Sync/credential")
deadline=$((SECONDS + PERIPHERY_HEALTH_TIMEOUT))
while (( SECONDS < deadline )); do
    state=$(curl -sf -X POST http://localhost:9120/read \
        -H "Content-Type: application/json" \
        -H "X-Api-Key: $api_key" -H "X-Api-Secret: $api_secret" \
        -d '{"type":"ListServers","params":{}}' 2>/dev/null \
        | jq -r '.[] | select(.name=="kangaroo") | .info.state' 2>/dev/null || echo "")
    if [ "$state" = "Ok" ]; then
        ok "kangaroo state=Ok (outbound connection live)"
        break
    fi
    sleep 4
done
if [ "$state" != "Ok" ]; then
    warn "kangaroo didn't reach state=Ok within ${PERIPHERY_HEALTH_TIMEOUT}s — check 'docker logs komodo-periphery' on kangaroo."
fi

# --- 6. CS-upgrade survival: autorun.sh boot hook ---
# Start CS's user Docker engine at boot via the native QNAP autorun.sh
# hook (boot DOM, survives firmware + Container Station upgrades). The
# stacks are all restart:unless-stopped, so engine-up brings them back.
# (Replaces a `@reboot` crontab line that never ran — BusyBox crond
# doesn't implement the `@reboot` nickname.)
log "Installing autorun.sh boot hook on kangaroo (CS-upgrade survival)"
AUTORUN_DIR="$(dirname "$KANGAROO_DIR")/host-autorun"
ssh_kangaroo "mkdir -p '$AUTORUN_DIR'"
scp -q kangaroo/host-autorun/autorun.sh kangaroo/host-autorun/install.sh "$KANGAROO_SSH:$AUTORUN_DIR/"
ssh_kangaroo "chmod +x '$AUTORUN_DIR/install.sh' '$AUTORUN_DIR/autorun.sh' && '$AUTORUN_DIR/install.sh'"
ok "autorun.sh boot hook installed"

# --- 6b. Pomerium SSH CA trust ---
# QTS regenerates sshd_config on firmware upgrades, so trust is re-applied
# at every boot: autorun.sh invokes this start.sh, which appends the
# TrustedUserCAKeys line if missing and HUPs sshd. The CA public half is
# published to 1Password by Terraform (its producer); the repo carries no
# copy to drift. The outbound tunnel itself is the restart-managed
# kangaroo-relay container — only CA trust lives host-side.
log "Installing Pomerium SSH CA trust (CA file + boot start.sh) on kangaroo"
QTS_PODHAUS_DIR="/share/CACHEDEV2_DATA/.podhaus/pomerium-ssh-origin"
QTS_CA_FILE="$QTS_PODHAUS_DIR/pomerium-ssh-user-ca.pub"
QTS_SSHD_CONFIG="/etc/config/ssh/sshd_config"
ssh_kangaroo "mkdir -p '$QTS_PODHAUS_DIR'"
op read 'op://Homelab/Pomerium Secrets/Secrets/ssh_user_ca_pub' \
    | ssh_kangaroo "cat > '$QTS_CA_FILE' && chmod 644 '$QTS_CA_FILE'"
ssh_kangaroo "ssh-keygen -l -f '$QTS_CA_FILE' >/dev/null" || fail "shipped CA file failed ssh-keygen validation"
{
    printf '#!/bin/sh\n'
    printf '# Auto-rendered by kangaroo_bootstrap; run at boot by autorun.sh.\n'
    printf 'set -eu\n'
    printf "grep -Fqx 'TrustedUserCAKeys %s' '%s' || printf '\\\\nTrustedUserCAKeys %s\\\\n' >> '%s'\n" \
        "$QTS_CA_FILE" "$QTS_SSHD_CONFIG" "$QTS_CA_FILE" "$QTS_SSHD_CONFIG"
    printf "/usr/sbin/sshd -t -f '%s'\n" "$QTS_SSHD_CONFIG"
    printf '[ ! -s /var/run/sshd.pid ] || kill -HUP $(cat /var/run/sshd.pid)\n'
} | ssh_kangaroo "cat > '$QTS_PODHAUS_DIR/start.sh' && chmod 755 '$QTS_PODHAUS_DIR/start.sh' && '$QTS_PODHAUS_DIR/start.sh'"
ok "Pomerium SSH CA trusted (boot-persistent via autorun.sh)"

# --- 7. Verify kangaroo in komodo/sync/servers.toml ---
# Outbound mode requires the Server's `address` field to be empty (or unset)
# so Core knows to expect Periphery -> Core direction. Kept here as a
# sanity check; the actual TOML edit happens in the repo.
log "Verifying kangaroo entry in komodo/sync/servers.toml"
SERVERS_TOML="komodo/sync/servers.toml"
if grep -q '^name = "kangaroo"' "$SERVERS_TOML"; then
    ok "kangaroo entry present in $SERVERS_TOML"
else
    warn "kangaroo entry MISSING from $SERVERS_TOML — add it manually"
fi

# --- Summary ---
echo
ok "kangaroo Periphery bootstrap done."
echo
echo "Next:"
echo "  1. Verify in https://komodo.pod.haus that kangaroo shows state=Ok"
echo "  2. Push or run ./komodo-sync to deploy any changed kangaroo stacks"
