log:
  level: info
  job_level: info

runner:
  file: /data/.runner
  # Bandicoot's 15 GiB is shared with ClickStack, Komodo Core and the Fenwick
  # family, and a Rust build job takes several GiB. Four jobs fit beside them;
  # the rest queue rather than exhaust memory and lose builds to earlyoom.
  capacity: {{ podhaus_forgejo_runner_capacity }}
  timeout: {{ podhaus_forgejo_runner_timeout }}
  shutdown_timeout: 5m
  insecure: false
  fetch_timeout: 30s
  fetch_interval: 2s
  report_interval: 1s
  labels:
    - podhaus-ci-x64:docker://docker.io/library/node:22-bookworm
    - podhaus-browser-x64:docker://mcr.microsoft.com/playwright:v1.61.1-noble

cache:
  enabled: true
  dir: /data/cache

container:
  network: ""
  privileged: false
  # Checkout and promotion run inside job containers, so they need the same
  # direct-origin resolution as the daemon's Actions protocol. When memory runs
  # out, a CI job is the cheapest thing to lose: the OOM score makes earlyoom
  # and the kernel pick job containers before host services or dev sessions.
  options: >-
    --add-host git.pod.haus:{{ podhaus_forgejo_runner_instance_address }}
    --oom-score-adj=900
  valid_volumes: []
  # The daemon uses the mounted socket to create job containers; jobs never
  # receive the socket themselves.
  docker_host: "-"
  force_pull: false
  force_rebuild: false

host:
  workdir_parent: ""

server:
  connections: {}
