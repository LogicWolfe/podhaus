#!/bin/sh
set -eu

{{ podhaus_pinelake_libexec_dir }}/pinelake-mount-guard \
  --mount-point {{ podhaus_terramaster_mount }} \
  --volume-uuid {{ podhaus_terramaster_uuid }} \
  --sentinel {{ podhaus_terramaster_sentinel }} \
{% for path in podhaus_terramaster_required_paths %}
  --require {{ path }} \
{% endfor %}
  >/dev/null

exec /usr/bin/open -gja /Applications/OrbStack.app
