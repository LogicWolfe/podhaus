[Unit]
Description=Flic button daemon
Documentation=https://github.com/50ButtonsEach/fliclib-linux-hci
After=network-online.target
Wants=network-online.target
# flicd takes hci0 exclusively via HCI_CHANNEL_USER, so BlueZ must be out
# of the way. bluetooth.service is disabled; this stops it racing back.
Conflicts=bluetooth.service

[Service]
# Runs as root, unsandboxed, on purpose. This is a single-job appliance and
# an easy thing to debug matters more here than a tight blast radius.
#
# 5551 is open to the LAN, and flicd's protocol has no authentication or
# encryption. Deliberate: anyone on the network can watch button presses.
#
# No --wait-for-hci. That flag tells flicd to carry on when it cannot bind
# the adapter, so it keeps serving TCP while deaf to every button — which
# is exactly how this failed the first time, silently, for 25 minutes.
# Exiting instead means Restart= retries until the radio is actually there,
# and a real failure shows up in the journal.
ExecStart=/opt/flicd/flicd \
    --db-file /var/lib/flicd/flicd.db \
    --server-addr 0.0.0.0 \
    --server-port 5551 \
    --hci-dev hci0

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
