#!/usr/bin/env bash
# Install or update flicd on the Pi Zero. Idempotent — safe to re-run, and
# the path back after a re-flash.
#
# The Pi is an appliance, not a fleet host: ARMv6 rules out Docker and
# Komodo Periphery, so this is the kangaroo_bootstrap pattern — a committed
# script for a host Ansible does not reach.
#
# Run it ON the Pi, from a copy of this directory:
#   scp -r iot/pizero nathan@<pi>:/tmp/ && ssh nathan@<pi> sudo /tmp/pizero/flicd-install

set -euo pipefail

SRC="https://github.com/50ButtonsEach/fliclib-linux-hci/archive/refs/heads/master.tar.gz"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

[[ $EUID -eq 0 ]] || { echo "flicd-install: must run as root" >&2; exit 1; }

arch="$(uname -m)"
[[ $arch == armv6l || $arch == armv7l ]] || {
	echo "flicd-install: expected an ARM board, got $arch" >&2; exit 1
}

echo "==> Fetching flicd"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
curl -fsSL "$SRC" | tar -xz -C "$tmp"
bin="$tmp/fliclib-linux-hci-master/bin/armv6l/flicd"
[[ -x $bin ]] || { echo "flicd-install: no armv6l flicd in the tarball" >&2; exit 1; }

echo "==> Installing"
install -d -m 0755 /opt/flicd
install -m 0755 "$bin" /opt/flicd/flicd
# Bundled clients, for pairing and for testing flicd without Home Assistant.
install -m 0755 -t /opt/flicd "$tmp/fliclib-linux-hci-master"/clientlib/python/*.py 2>/dev/null || true
install -m 0644 "$HERE/flicd.service" /etc/systemd/system/flicd.service

# BlueZ holds hci0 through the kernel's normal channel; flicd needs the
# adapter exclusively via HCI_CHANNEL_USER. Leaving bluetoothd running does
# not always fail loudly — it degrades connection reliability instead.
echo "==> Disabling BlueZ"
systemctl disable --now bluetooth.service 2>/dev/null || true

echo "==> Starting flicd"
systemctl daemon-reload
systemctl enable --now flicd.service
systemctl --no-pager --lines=0 status flicd.service

echo
echo "flicd listening on 5551, open to the LAN."
echo "Pair a button: hold it down for 7 seconds with discovery running."
