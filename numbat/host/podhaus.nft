table inet podhaus {
  chain input {
    type filter hook input priority -10; policy accept;
    ct state established,related accept
    iifname "lo" accept
    ip protocol icmp accept
    ip daddr 103.1.184.88 tcp dport { 22, 80, 443, 2222 } accept
    ip daddr 103.4.235.175 tcp dport { 22, 443, 2333 } accept
    ip daddr { 103.1.184.88, 103.4.235.175 } drop
  }
}
