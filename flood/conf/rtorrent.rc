scgi_local = /tmp/rtorrent.sock

encoding_list = UTF-8
port_range = 49184-49184
port_random = no
check_hash = no
directory = /data/torrents
session = /flood-db
session.path.set = /flood-db
session.use_lock.set = no
encryption = allow_incoming, try_outgoing, enable_retry
trackers.use_udp.set = yes
dht.mode.set = off
protocol.pex.set = no

min_peers = 1
max_peers = 100
min_peers_seed = 1
max_peers_seed = 50
max_uploads = 15

network.xmlrpc.size_limit.set = 10000000

schedule = watch_directory,1,1,"load.start=/data/.watch/*.torrent"
schedule = untied_directory,5,5,"stop_untied=/data/.watch/*.torrent"
schedule = scgi_permission,0,0,"execute.nothrow=chmod,\"g+w,o=\",/tmp/rtorrent.sock"
schedule = insufficient_disk_space,1,30,close_low_diskspace=500M

# pinelake-tag → Pouch .stignore sync. On finish, kick a full reconciler
# pass over /flood-db/*.torrent.rtorrent that inserts the base_path of
# every complete + pinelake-tagged torrent into .stignore (alphabetically
# into the matching !<TopLevel>/ block). The hook is the zero-latency
# trigger; an ofelia label runs the same script every 5 min to catch the
# tag-applied-after-completion case. See flood/scripts/pinelake-stignore.sh.
method.set_key=event.download.finished,pinelake_stignore,"execute.nothrow.bg={/scripts/pinelake-stignore.sh}"

# Real-time in-place RAR extraction. Replaces the previous unpackerr
# stack: rtorrent passes $d.base_path= (the exact directory the torrent
# landed under), and the script walks it at any depth for the archive
# entry-point, then runs 7za in place. Drops the _unpackerred.<dir>.txt
# marker so rar-backlog.sh's daily safety-net scan won't re-flag it.
# Idempotent on the marker; failure-loud (leaves no marker) so the
# safety-net catches stuck folders. See flood/scripts/rtorrent-extract.sh.
method.set_key=event.download.finished,rar_extract,"execute.nothrow.bg={/scripts/rtorrent-extract.sh,$d.base_path=}"

# Hardlink-publish completed media into the Plex library. flood-publish.py
# queries rtorrent for per-file completion and links each done file from
# /data/torrents into the publishdir captured below. This finish-hook pass
# makes a freshly-completed torrent publish near-instantly; the ofelia tick
# (every minute) is the steady-state driver and the backstop if this pass
# runs before rar_extract. See docs/plans/flood-atomic-publish.md.
method.set_key=event.download.finished,flood_publish,"execute.nothrow.bg={python3,/scripts/flood-publish.py}"

method.set_key=event.download.inserted_new,loaded_time,"d.custom.set=addtime,$cat=$system.time=;d.save_full_session="

# Redirect every new download into a per-torrent dir under /data/torrents
# (Plex-invisible) and stash the user's chosen destination as `publishdir`
# so flood-publish.py knows where to hardlink completed media. Done in the
# Python helper (synchronous, before any data lands) rather than an inline
# rtorrent.rc substitution — the nested-$cat form is unreliable. Uses the
# same execute.nothrow={…,$d.hash=} pattern as the other hooks.
method.set_key=event.download.inserted_new,redirect_dl,"execute.nothrow={python3,/scripts/flood-publish.py,--redirect,$d.hash=}"
