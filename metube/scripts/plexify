#!/usr/bin/env python3
# yt-dlp Exec postprocessor (after_move), invoked as:
#   plexify FILEPATH TITLE CHANNEL
#
# MeTube's /downloads bind is Pouch's Kids/_incoming staging tree (see
# metube/compose.yaml) — every file MeTube writes is staging, never the Plex
# library itself. The family may pick a show folder in MeTube's folder
# picker (or type one); a file that lands directly in staging with no
# folder falls back to the video's yt-dlp %(channel)s, which for these
# kids' shows is the show name itself. Either way, this hook asks Sonarr
# (which sees the same tree at /kids, with our staging root appearing there
# as /kids/_incoming) to identify the episode from the show name + video
# title, then runs a Sonarr ManualImport to move the file into /kids/TV
# with the right season/episode name. A file with neither a folder nor a
# channel (yt-dlp renders a missing field as the literal string "NA") fails
# loudly instead of silently sitting in staging forever.
#
# The episode number lives only in Sonarr's TheTVDB-backed episode list, not
# in anything yt-dlp can see (see docs/plans/metube.md). The strict first
# pass: an episode title that exactly equals the whole video title or one of
# its "|"/"-"/":"-delimited segments, or else a difflib ratio match (scored
# the same way, over the whole title and every segment) with a clear margin
# over the runner-up — anything murkier is deferred rather than risking a
# wrong episode number. Substring containment alone isn't enough: "Plumber"
# must not match "Quantum Plumber" just because it's a substring of it.
#
# A strict miss no longer fails the download outright: the file stays put in
# its staging folder and the hook exits 0. Instead, whichever invocation
# (a placement or a miss) finds MeTube's own download queue empty sweeps
# every show folder in staging: leftover files against that show's still-
# unplaced Sonarr episodes, matched by the strict rule again or, failing
# that, a looser token rule with one word of slack ("Mars Canyon Race Space"
# fitting the episode "Mars Canyon Race"). A pair is only accepted when it's
# the unique fit in both directions — one wrong download is still its own
# batch and still fails on its own. See docs/plans/metube.md, "Batch
# matching: the second pass", for the full design and why deferring the
# loose match until the batch is complete is what makes it safe at all.
#
# Every placement, and the sweep as a whole, is reported to Gatus's
# `metube_plexify` external endpoint (success=true, or
# success=false&error=...) so a bad match reaches Nathan instead of silently
# sitting in staging. yt-dlp/MeTube shows the triggering download as errored
# when this hook exits non-zero — which, for a sweep failure, may be a
# different file than the one that actually failed to match.

from __future__ import annotations

import difflib
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass
from pathlib import Path

# MeTube's own view of its staging root (see the module docstring).
STAGING_ROOT = Path("/downloads")
# Sonarr binds the whole Kids share at /kids (see sonarr/compose.yaml), so
# STAGING_ROOT appears there as /kids/_incoming — the fixed translation
# between the two containers' views of one folder.
INCOMING_DIRNAME = "_incoming"
SONARR_VIEW_PREFIX = "/kids"
LIBRARY_ROOT = "/kids/TV"
NO_CHANNEL = "NA"  # yt-dlp's literal rendering of a missing %(channel)s
IMPORT_POLL_INTERVAL_S = 2
IMPORT_POLL_TIMEOUT_S = 60
# This hook runs as a subprocess of MeTube itself (yt-dlp's Exec
# postprocessor), so MeTube's own API is always its own container's
# localhost — no env var, unlike SONARR_URL which crosses to another
# container.
METUBE_URL = "http://localhost:8081"
TVDB_FOLDER_RE = re.compile(r"\{tvdb-(\d+)\}")
NON_ALNUM_RE = re.compile(r"[^a-z0-9]+")
# Splits a raw (not yet normalised) video title into its junk-prefix and
# career segments, e.g. "Skillsville FULL EPISODE | Entrepreneur" -> the
# segment "Entrepreneur" alone, so a fuzzy match against it isn't diluted
# by the length of the surrounding channel boilerplate.
# The full-width bar (U+FF5C) is what yt-dlp writes into filenames for `|`,
# and some channels use it in titles outright.
TITLE_SEGMENT_RE = re.compile(r"[|｜\-–—:]")

# Ambiguity guard for the difflib fallback: the best candidate must clear
# this ratio, and beat the runner-up by this much, or the match is refused.
RATIO_MATCH_THRESHOLD = 0.9
RATIO_MATCH_MARGIN = 0.05

# The batch sweep's token rule (see the module docstring): the shorter of
# an episode title's and a title segment's word lists must appear
# contiguously inside the longer, with no more than this many extra words
# in the longer one — the slack that lets "Mars Canyon Race Space" fit the
# episode "Mars Canyon Race" without also letting arbitrary junk in.
TOKEN_FIT_MAX_SLACK = 1


class PlexifyError(Exception):
    """A hook failure with a message safe to hand to Gatus and stderr."""


@dataclass(frozen=True)
class Series:
    id: int
    title: str
    tvdb_id: int


@dataclass(frozen=True)
class Episode:
    id: int
    title: str
    season_number: int
    episode_number: int
    has_file: bool = False


@dataclass(frozen=True)
class LeftoverFile:
    """A file still sitting in a show's staging folder when the batch
    sweep runs, with the video title MeTube's history recorded for it."""
    name: str
    title: str


@dataclass(frozen=True)
class Pair:
    file: LeftoverFile
    episode: Episode


@dataclass(frozen=True)
class BatchAssignment:
    pairs: list[Pair]
    leftover_files: list[LeftoverFile]


def normalise(text: str) -> str:
    """casefold, strip non-alphanumerics, collapse whitespace."""
    collapsed = NON_ALNUM_RE.sub(" ", text.casefold())
    return " ".join(collapsed.split())


def title_segments(video_title: str) -> list[str]:
    """The video title, each `|`/`-`/`–`/`—`/`:`-delimited segment, and
    the remainder after each delimiter, all trimmed. A channel's
    boilerplate framing ("Skillsville FULL EPISODE | Chef") splits the
    career name out on its own so a near-miss spelling can be matched by
    ratio without the framing diluting it; the remainders keep an episode
    title that itself contains a delimiter ("SPACE RACERS: Starling:
    Space Racer!") intact once the framing prefix is dropped."""
    segments = [part.strip() for part in TITLE_SEGMENT_RE.split(video_title)]
    remainders = [video_title[m.end():].strip() for m in TITLE_SEGMENT_RE.finditer(video_title)]
    return [video_title] + [part for part in segments + remainders if part]


def required_env(name: str) -> str:
    value = os.environ.get(name)
    if not value:
        raise PlexifyError(f"missing required environment variable {name}")
    return value


class SonarrClient:
    """Thin wrapper over the Sonarr v3 API endpoints this hook needs."""

    def __init__(self, base_url: str, api_key: str) -> None:
        self._base_url = base_url.rstrip("/")
        self._api_key = api_key

    def _request(self, method: str, path: str, params: dict | None = None,
                 body: dict | None = None):
        url = f"{self._base_url}{path}"
        if params:
            url += "?" + urllib.parse.urlencode(params)
        data = json.dumps(body).encode() if body is not None else None
        request = urllib.request.Request(
            url, data=data, method=method,
            headers={"X-Api-Key": self._api_key, "Content-Type": "application/json"},
        )
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                raw = response.read()
        except urllib.error.HTTPError as exc:
            raise PlexifyError(f"Sonarr {method} {path} failed: HTTP {exc.code} {exc.read()[:200]}") from exc
        except urllib.error.URLError as exc:
            raise PlexifyError(f"Sonarr {method} {path} unreachable: {exc.reason}") from exc
        return json.loads(raw) if raw else None

    def list_series(self) -> list[Series]:
        rows = self._request("GET", "/api/v3/series")
        return [Series(r["id"], r["title"], r["tvdbId"]) for r in rows]

    def lookup_series(self, term: str) -> list[dict]:
        return self._request("GET", "/api/v3/series/lookup", params={"term": term}) or []

    def first_quality_profile_id(self) -> int:
        profiles = self._request("GET", "/api/v3/qualityprofile")
        if not profiles:
            raise PlexifyError("Sonarr has no quality profiles configured")
        return profiles[0]["id"]

    def add_series(self, tvdb_id: int, title: str, quality_profile_id: int) -> Series:
        body = {
            "tvdbId": tvdb_id,
            "title": title,
            "qualityProfileId": quality_profile_id,
            "rootFolderPath": LIBRARY_ROOT,
            "monitored": False,
            "seasonFolder": True,
            "addOptions": {"searchForMissingEpisodes": False},
        }
        created = self._request("POST", "/api/v3/series", body=body)
        return Series(created["id"], created["title"], created["tvdbId"])

    def episodes_for(self, series_id: int) -> list[Episode]:
        rows = self._request("GET", "/api/v3/episode", params={"seriesId": series_id})
        return [
            Episode(r["id"], r["title"], r["seasonNumber"], r["episodeNumber"], r["hasFile"])
            for r in rows
        ]

    def webdl_1080p_quality(self) -> dict:
        for definition in self._request("GET", "/api/v3/qualitydefinition"):
            if definition["quality"]["name"] == "WEBDL-1080p":
                return definition["quality"]
        raise PlexifyError("Sonarr has no WEBDL-1080p quality definition")

    def english_language(self) -> dict:
        for language in self._request("GET", "/api/v3/language"):
            if language["name"] == "English":
                return language
        raise PlexifyError("Sonarr has no English language entry")

    def manual_import(self, sonarr_path: str, series_id: int, episode_id: int,
                       quality: dict, language: dict) -> int:
        body = {
            "name": "ManualImport",
            "importMode": "move",
            "files": [{
                "path": sonarr_path,
                "seriesId": series_id,
                "episodeIds": [episode_id],
                "quality": {"quality": quality, "revision": {"version": 1, "real": 0, "isRepack": False}},
                "languages": [language],
                "releaseGroup": "",
            }],
        }
        command = self._request("POST", "/api/v3/command", body=body)
        return command["id"]

    def wait_for_command(self, command_id: int) -> None:
        deadline = time.monotonic() + IMPORT_POLL_TIMEOUT_S
        while time.monotonic() < deadline:
            command = self._request("GET", f"/api/v3/command/{command_id}")
            status = command["status"]
            if status == "completed":
                return
            if status == "failed":
                raise PlexifyError(f"Sonarr import command failed: {command.get('message', 'no message')}")
            time.sleep(IMPORT_POLL_INTERVAL_S)
        raise PlexifyError(f"Sonarr import command {command_id} did not finish within {IMPORT_POLL_TIMEOUT_S}s")


def batch_done(queue: list[dict], own_title: str) -> bool:
    """True when MeTube's download queue is empty, or contains only
    entries whose title is this invocation's own file. The Exec
    postprocessor that calls this runs inside yt-dlp's own postprocessing
    chain, before MeTube moves that same download from `queue` to `done`
    — so a lone download's own hook invocation always finds its own entry
    still "queued", and a bare `if queue: return 0` would defer forever,
    letting some later, unrelated download be the one that always
    happens to run the sweep."""
    return all(entry["title"] == own_title for entry in queue)


class MeTubeClient:
    """Thin wrapper over the one MeTube endpoint the batch sweep needs.
    Reachable at localhost because this hook runs as a subprocess inside
    MeTube's own container (see METUBE_URL above)."""

    def __init__(self, base_url: str) -> None:
        self._base_url = base_url.rstrip("/")

    def history(self) -> dict:
        request = urllib.request.Request(f"{self._base_url}/history", method="GET")
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                return json.loads(response.read())
        except urllib.error.HTTPError as exc:
            raise PlexifyError(f"MeTube GET /history failed: HTTP {exc.code}") from exc
        except urllib.error.URLError as exc:
            raise PlexifyError(f"MeTube GET /history unreachable: {exc.reason}") from exc


def add_series_from_lookup(sonarr: SonarrClient, result: dict) -> Series:
    quality_profile_id = sonarr.first_quality_profile_id()
    series = sonarr.add_series(result["tvdbId"], result["title"], quality_profile_id)
    wait_for_episodes(sonarr, series)
    return series


def wait_for_episodes(sonarr: SonarrClient, series: Series) -> None:
    """Sonarr answers the add before it has fetched the episode list; a
    match attempted against that empty list would fail the first download
    of every new show."""
    deadline = time.monotonic() + IMPORT_POLL_TIMEOUT_S
    while time.monotonic() < deadline:
        if sonarr.episodes_for(series.id):
            return
        time.sleep(IMPORT_POLL_INTERVAL_S)
    raise PlexifyError(f"Sonarr listed no episodes for {series.title!r} within {IMPORT_POLL_TIMEOUT_S}s of adding it")


def resolve_series_by_tvdb_id(sonarr: SonarrClient, tvdb_id: int, show_name: str) -> Series:
    for series in sonarr.list_series():
        if series.tvdb_id == tvdb_id:
            return series
    results = sonarr.lookup_series(f"tvdb:{tvdb_id}")
    if not results:
        raise PlexifyError(f"no Sonarr lookup result for tvdb:{tvdb_id} (show {show_name!r})")
    return add_series_from_lookup(sonarr, results[0])


def resolve_series(sonarr: SonarrClient, show_name: str) -> Series:
    """Resolve a Sonarr series from a show name — either a staging folder
    name (a `{tvdb-N}` tag wins) or, when there was no folder, the video's
    channel, which must then be an exact TheTVDB title itself."""
    tvdb_tag = TVDB_FOLDER_RE.search(show_name)
    if tvdb_tag:
        return resolve_series_by_tvdb_id(sonarr, int(tvdb_tag.group(1)), show_name)

    normalised_show = normalise(show_name)
    for series in sonarr.list_series():
        if normalise(series.title) == normalised_show:
            return series

    matches = [r for r in sonarr.lookup_series(show_name) if normalise(r["title"]) == normalised_show]
    if len(matches) != 1:
        raise PlexifyError(f"no exact Sonarr match for show {show_name!r}")
    return add_series_from_lookup(sonarr, matches[0])


def resolve_show_name(relative: Path, channel: str) -> str:
    """The show is the staging folder name when the family chose one,
    else the video's channel — a channel of "NA" means yt-dlp saw neither
    a folder nor a channel to fall back on."""
    if len(relative.parts) >= 2:
        return relative.parts[0]
    if channel == NO_CHANNEL:
        raise PlexifyError("video has no channel and no folder was chosen")
    return channel


def best_ratio_against_title(episode_title: str, normalised_candidates: list[str]) -> float:
    normalised_episode = normalise(episode_title)
    return max(
        difflib.SequenceMatcher(None, normalised_episode, candidate).ratio()
        for candidate in normalised_candidates
    )


def select_episode(video_title: str, episodes: list[Episode]) -> Episode:
    normalised_candidates = [normalise(segment) for segment in title_segments(video_title)]

    # A whole delimited segment equalling an episode title, not merely
    # containing it — "Plumber" must not match "Quantum Plumber" just
    # because it's a substring of it.
    exact = [e for e in episodes if normalise(e.title) in normalised_candidates]
    if len(exact) == 1:
        return exact[0]
    if len(exact) > 1:
        raise PlexifyError(f"ambiguous exact title match for {video_title!r}: " + ", ".join(e.title for e in exact))

    scored = sorted(
        ((best_ratio_against_title(e.title, normalised_candidates), e) for e in episodes),
        key=lambda pair: pair[0], reverse=True,
    )
    if not scored:
        raise PlexifyError(f"Sonarr series has no episodes to match against {video_title!r}")
    best_ratio, best = scored[0]
    runner_up_ratio = scored[1][0] if len(scored) > 1 else 0.0
    if best_ratio >= RATIO_MATCH_THRESHOLD and (best_ratio - runner_up_ratio) >= RATIO_MATCH_MARGIN:
        return best
    top = ", ".join(f"{e.title!r} ({ratio:.2f})" for ratio, e in scored[:5])
    raise PlexifyError(f"no confident episode match for {video_title!r}; top candidates: {top}")


def import_episode(sonarr: SonarrClient, path: Path, relative: Path, series: Series, episode: Episode) -> None:
    """Runs Sonarr's ManualImport for one file already known to belong to
    one episode, and confirms it actually left staging — Sonarr reports
    the command as successful even on a no-op import."""
    sonarr_path = f"{SONARR_VIEW_PREFIX}/{INCOMING_DIRNAME}/{relative.as_posix()}"
    command_id = sonarr.manual_import(
        sonarr_path, series.id, episode.id, sonarr.webdl_1080p_quality(), sonarr.english_language(),
    )
    sonarr.wait_for_command(command_id)
    if path.exists():
        raise PlexifyError(f"Sonarr reported success but {path} is still in staging")


def place_episode(path: Path, relative: Path, title: str, channel: str, sonarr: SonarrClient) -> bool:
    """The strict first pass for one freshly downloaded file. Returns
    False on a title-matching miss — the file is left in staging for a
    later batch sweep to reconsider — and raises PlexifyError for
    anything else (an unresolvable show, an unreachable Sonarr, or an
    import that silently didn't move the file), which still fails the
    download immediately."""
    show_name = resolve_show_name(relative, channel)
    series = resolve_series(sonarr, show_name)
    try:
        episode = select_episode(title, sonarr.episodes_for(series.id))
    except PlexifyError:
        return False
    import_episode(sonarr, path, relative, series, episode)
    return True


def token_fit(video_title: str, episode_title: str) -> bool:
    """The batch sweep's looser rule (see the module docstring): true
    when one side's words appear, in order and unbroken, inside the
    other, allowing up to TOKEN_FIT_MAX_SLACK extra words on the longer
    side. Tried against every title_segments() candidate, the same way
    the strict rule is."""
    episode_tokens = normalise(episode_title).split()
    if not episode_tokens:
        return False
    return any(
        _contiguous_with_slack(episode_tokens, normalise(segment).split())
        for segment in title_segments(video_title)
    )


def _contiguous_with_slack(a: list[str], b: list[str]) -> bool:
    shorter, longer = (a, b) if len(a) <= len(b) else (b, a)
    if not shorter or len(longer) - len(shorter) > TOKEN_FIT_MAX_SLACK:
        return False
    return any(longer[i:i + len(shorter)] == shorter for i in range(len(longer) - len(shorter) + 1))


def _strict_candidates(file: LeftoverFile, episodes: list[Episode]) -> list[Episode]:
    try:
        return [select_episode(file.title, episodes)]
    except PlexifyError:
        return []


def _token_candidates(file: LeftoverFile, episodes: list[Episode]) -> list[Episode]:
    return [e for e in episodes if token_fit(file.title, e.title)]


def _match_round(files, episodes, candidates_of):
    """One one-to-one matching pass: a file is paired with an episode
    only when that episode is the file's sole candidate AND the file is
    that episode's sole claimant. Returns the accepted pairs plus
    whatever files and episodes neither side consumed, for a further
    (looser) round to try."""
    candidates = {f: candidates_of(f, episodes) for f in files}
    claimants: dict[int, list[LeftoverFile]] = {}
    for f, cands in candidates.items():
        if len(cands) == 1:
            claimants.setdefault(cands[0].id, []).append(f)

    pairs, matched_files, matched_episode_ids = [], set(), set()
    for episode_id, claimers in claimants.items():
        if len(claimers) == 1:
            f = claimers[0]
            pairs.append(Pair(f, candidates[f][0]))
            matched_files.add(f)
            matched_episode_ids.add(episode_id)

    remaining_files = [f for f in files if f not in matched_files]
    remaining_episodes = [e for e in episodes if e.id not in matched_episode_ids]
    return pairs, remaining_files, remaining_episodes


def assign_batch(files: list[LeftoverFile], episodes: list[Episode]) -> BatchAssignment:
    """Matches one show's leftover staging files against its still-
    unplaced Sonarr episodes: the strict first-pass rule first, then the
    looser token rule over whatever neither side placed. See
    docs/plans/metube.md, "Batch matching: the second pass"."""
    strict_pairs, files, episodes = _match_round(files, episodes, _strict_candidates)
    token_pairs, files, episodes = _match_round(files, episodes, _token_candidates)
    return BatchAssignment(pairs=strict_pairs + token_pairs, leftover_files=files)


def _staged_files(directory: Path) -> list[Path]:
    """Real staged files directly in a staging directory — never a
    dotfile: the `.podhaus-share-mounted` healthcheck sentinel lives at
    STAGING_ROOT itself and must never be swept up as a leftover."""
    return [p for p in sorted(directory.iterdir()) if p.is_file() and not p.name.startswith(".")]


def sweep_show(show_dir: Path, done_titles: dict[str, str], sonarr: SonarrClient) -> tuple[int, list[str]]:
    """Sweeps one show's staging folder: places every safely-matched
    leftover file, then returns how many it placed plus a display name
    (title where known, else filename) for each file still left over
    afterwards."""
    disk_files = _staged_files(show_dir)
    if not disk_files:
        return 0, []
    titled = [LeftoverFile(p.name, done_titles[p.name]) for p in disk_files if p.name in done_titles]
    untitled_names = [p.name for p in disk_files if p.name not in done_titles]

    series = resolve_series(sonarr, show_dir.name)
    unplaced = [e for e in sonarr.episodes_for(series.id) if not e.has_file]
    assignment = assign_batch(titled, unplaced)

    for pair in assignment.pairs:
        relative = Path(show_dir.name) / pair.file.name
        import_episode(sonarr, show_dir / pair.file.name, relative, series, pair.episode)

    return len(assignment.pairs), untitled_names + [f.title for f in assignment.leftover_files]


def run_sweep(sonarr: SonarrClient, done_entries: list[dict]) -> bool:
    """Runs once MeTube's whole download queue is empty: sweeps every
    show folder in staging (a loose file at the staging root can't be
    show-resolved at all, and is always a leftover), places what it
    safely can, prints one operational line so `docker logs metube`
    shows the sweep ran, and reports the whole sweep as one Gatus
    result. Returns whether staging ended up empty."""
    done_titles = {e["filename"]: e["title"] for e in done_entries}
    failures: dict[str, list[str]] = {}
    placed_total = 0

    root_files = [p.name for p in _staged_files(STAGING_ROOT)]
    if root_files:
        failures["(staging root)"] = root_files
    for show_dir in sorted(p for p in STAGING_ROOT.iterdir() if p.is_dir()):
        placed, leftover = sweep_show(show_dir, done_titles, sonarr)
        placed_total += placed
        if leftover:
            failures[show_dir.name] = leftover

    left_total = sum(len(names) for names in failures.values())
    print(f"plexify: batch sweep placed {placed_total}, left {left_total}", file=sys.stderr)
    report_sweep(failures)
    return not failures


def report_sweep(failures: dict[str, list[str]]) -> None:
    if not failures:
        report_gatus(success=True, error=None)
        return
    total = sum(len(names) for names in failures.values())
    per_show = "; ".join(f"{show}: {', '.join(names[:3])}" for show, names in failures.items())
    report_gatus(success=False, error=f"batch sweep left {total} file(s) unplaced: {per_show}")


def report_gatus(success: bool, error: str | None) -> None:
    # A Gatus outage must not mask the hook's own result, so every failure
    # here — including a missing env var — is swallowed after logging.
    try:
        base_url = os.environ["GATUS_BASE_URL"].rstrip("/")
        endpoint_id = os.environ["GATUS_PLEXIFY_ENDPOINT_ID"]
        token = os.environ["GATUS_HEARTBEAT_PUSH_TOKEN"]
        params = {"success": "true" if success else "false"}
        if error:
            params["error"] = error
        url = f"{base_url}/api/v1/endpoints/{endpoint_id}/external?{urllib.parse.urlencode(params)}"
        request = urllib.request.Request(
            url, data=b"", method="POST", headers={"Authorization": f"Bearer {token}"},
        )
        urllib.request.urlopen(request, timeout=10).read()
    except Exception as exc:  # noqa: BLE001 - network boundary, see comment above
        print(f"plexify: Gatus push failed: {exc}", file=sys.stderr)


def main() -> int:
    path = Path(sys.argv[1])
    title = sys.argv[2]
    channel = sys.argv[3]
    sonarr = SonarrClient(required_env("SONARR_URL"), required_env("SONARR_API_KEY"))
    try:
        relative = path.relative_to(STAGING_ROOT)
        placed = place_episode(path, relative, title, channel, sonarr)
    except Exception as exc:  # noqa: BLE001 - top-level boundary, see module docstring
        print(f"plexify: {exc}", file=sys.stderr)
        report_gatus(success=False, error=str(exc))
        return 1

    if placed:
        report_gatus(success=True, error=None)

    # Either outcome checks whether the batch is now done — a miss is
    # deferred to the sweep rather than failing here (see module docstring).
    try:
        history = MeTubeClient(METUBE_URL).history()
    except PlexifyError as exc:
        print(f"plexify: {exc}", file=sys.stderr)
        report_gatus(success=False, error=str(exc))
        return 1
    if not batch_done(history["queue"], title):
        return 0
    return 0 if run_sweep(sonarr, history["done"]) else 1


if __name__ == "__main__":
    sys.exit(main())
