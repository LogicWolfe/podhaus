FROM python:alpine

COPY scripts/ship-watering.py /usr/local/bin/ship-watering
RUN chmod 0755 /usr/local/bin/ship-watering

# Content-hash build arg from the podhaus mechanism. The image contains the
# shipping script, so a gatus/ build-context change must rebuild the image.
ARG STACK_CONTENT_HASH=unset
ENV STACK_CONTENT_HASH=${STACK_CONTENT_HASH}
