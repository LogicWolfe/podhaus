## Secrets — resolved by `op run` at startup
KOMODO_DB_USERNAME=komodo
KOMODO_DB_PASSWORD=op://Homelab/Komodo DB Password/password
KOMODO_JWT_SECRET=op://Homelab/Komodo JWT Secret/password
KOMODO_WEBHOOK_SECRET=op://Homelab/Komodo Webhook Secret/password
KOMODO_INIT_ADMIN_USERNAME=nathan
KOMODO_INIT_ADMIN_PASSWORD=op://Homelab/Komodo Admin Password/password

## Core config
KOMODO_HOST=https://komodo.pod.haus
KOMODO_TITLE=PodHaus
KOMODO_FIRST_SERVER=https://periphery:8120
KOMODO_FIRST_SERVER_NAME=podhaus
KOMODO_LOCAL_AUTH=true
KOMODO_DISABLE_USER_REGISTRATION=true
TZ=Australia/Perth

## Image tag. Track the v2 minor line so we pick up bugfix releases
## without strict-pin edits; upstream's recommended default.
COMPOSE_KOMODO_IMAGE_TAG=2

## Backups
COMPOSE_KOMODO_BACKUPS_PATH=/opt/komodo/backups

## v2 PKI keypair location on bilby host. Bound into both Core and
## bilby's Periphery at /config/keys. Holds 4 X25519 keypairs:
## core.{key,pub} + bilby-periphery.{key,pub} + kangaroo-periphery.pub +
## kookaburra-periphery.pub. Pubkeys are also committed to komodo/keys/
## in the repo for reference + rebuild. Privkeys never leave the host
## they live on (kangaroo's + kookaburra's are on those hosts only).
COMPOSE_KOMODO_KEYS_PATH=/opt/komodo/keys

## v2 PKI trust lists. Core trusts the 3 Periphery pubkeys; bilby's
## Periphery trusts Core's pubkey. PERIPHERY_ALLOWED_IPS is no longer
## the load-bearing gate (the noise handshake is); kept off compose.
KOMODO_PRIVATE_KEY=file:/config/keys/core.key
KOMODO_PERIPHERY_PUBLIC_KEYS=file:/config/keys/bilby-periphery.pub,file:/config/keys/kangaroo-periphery.pub,file:/config/keys/kookaburra-periphery.pub,file:/config/keys/numbat-periphery.pub,file:/config/keys/fractal-periphery.pub
PERIPHERY_PRIVATE_KEY=file:/config/keys/bilby-periphery.key
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub

## Repo root (mounted into Core for ResourceSync, and Periphery for compose files).
## NOT set here — komodo-start exports COMPOSE_KOMODO_REPO_PATH=$(pwd) so the
## value tracks wherever the repo is checked out, keeping podhaus portable
## across hosts and clones.
