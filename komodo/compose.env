## Secrets — resolved by `op run` at startup
KOMODO_DB_USERNAME=komodo
KOMODO_DB_PASSWORD=op://Homelab/Komodo DB Password/password
KOMODO_JWT_SECRET=op://Homelab/Komodo JWT Secret/password
KOMODO_WEBHOOK_SECRET=op://Homelab/Komodo Webhook Secret/password
KOMODO_INIT_ADMIN_USERNAME=nathan
KOMODO_INIT_ADMIN_PASSWORD=op://Homelab/Komodo Admin Password/password

## Core config
KOMODO_HOST=https://komodo.pod.haus
KOMODO_TITLE=PodHaus
KOMODO_LOCAL_AUTH=true
KOMODO_DISABLE_USER_REGISTRATION=true
TZ=Australia/Perth

## Image tag. Track the v2 minor line so we pick up bugfix releases
## without strict-pin edits; upstream's recommended default.
COMPOSE_KOMODO_IMAGE_TAG=2

## Backups
COMPOSE_KOMODO_BACKUPS_PATH=/opt/komodo/backups

## v2 PKI keypair location on the Core host (bandicoot). Bound into Core
## at /config/keys. Pubkeys are also committed to komodo/keys/ for
## reference and rebuild. Every Periphery's private key stays on its own
## host instead (see e.g. bilby/periphery/compose.yaml).
COMPOSE_KOMODO_KEYS_PATH=/opt/komodo/keys

## v2 PKI trust list. Core trusts every fleet Periphery pubkey; each
## Periphery separately trusts Core's pubkey from its own compose.
## PERIPHERY_ALLOWED_IPS is no longer the load-bearing gate (the noise
## handshake is); kept off compose.
KOMODO_PRIVATE_KEY=file:/config/keys/core.key
KOMODO_PERIPHERY_PUBLIC_KEYS=file:/config/keys/bilby-periphery.pub,file:/config/keys/kangaroo-periphery.pub,file:/config/keys/numbat-periphery.pub,file:/config/keys/fractal-periphery.pub,file:/config/keys/voltaire-periphery.pub,file:/config/keys/pinelake-periphery.pub,file:/config/keys/bandicoot-periphery.pub

## Core's sync tree = bandicoot's Periphery clone of Repo "podhaus-bandicoot"
## (Komodo-managed, kept at origin/main by the push webhook and overlaid by
## komodo-sync). Bound into Core at /syncs/podhaus.
COMPOSE_KOMODO_SYNC_TREE=/opt/komodo-periphery/etc-komodo/repos/podhaus-bandicoot

## Repo root (mounted into Core for ResourceSync, and Periphery for compose files).
## NOT set here — komodo-start exports COMPOSE_KOMODO_REPO_PATH=$(pwd) so the
## value tracks wherever the repo is checked out, keeping podhaus portable
## across hosts and clones.
