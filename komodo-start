#!/bin/bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
export OP_SERVICE_ACCOUNT_TOKEN="$(cat OP_SERVICE_ACCOUNT_TOKEN)"

# Repo root is auto-discovered from the script's working directory. Keeps
# podhaus portable: clone anywhere, run ./komodo-start, and Komodo + every
# stack that interpolates [[PODHAUS_REPO]] points at this checkout.
export COMPOSE_KOMODO_REPO_PATH="$PWD"

# Host prerequisites — /etc/komodo/ssl, /opt/komodo/keys, dockernet and the
# fenwick-* networks — are provisioned by ansible/playbooks/bilby.yml. This
# script assumes them (the compose below attaches Core to dockernet and
# fails loudly if it is missing) and needs no sudo.

# Render Komodo Core's extra config from 1Password into the gitignored
# komodo/.runtime/ directory (bind-mounted into Core at
# /config/runtime/). Currently holds the central [[git_providers]] block
# Core proxies to Peripheries that need an HTTPS clone credential —
# bilby's linked-repo deploy of the fenwick monorepo needs this, and
# the cleanest config-as-code shape for it is core.config.toml rather
# than per-Periphery periphery.config.toml (no bilby-specific render+
# bind, and the next Periphery added gets the credential free). See
# komodo/core.config.toml.tmpl for the rendering note.
mkdir -p komodo/.runtime
GITHUB_PAT="$(op read 'op://Homelab/Homelab GitHub Personal Access Token/token')"
sed "s|__GITHUB_PAT__|${GITHUB_PAT}|" komodo/core.config.toml.tmpl \
  > komodo/.runtime/core.config.toml
chmod 0600 komodo/.runtime/core.config.toml
unset GITHUB_PAT

op run --env-file komodo/compose.env -- \
  docker compose -p komodo -f komodo/ferretdb.compose.yaml --env-file komodo/compose.env up -d

echo "Waiting for Komodo Core..."
until curl -sf -o /dev/null http://localhost:9120/; do
  sleep 2
done
echo "Komodo Core is ready"

api_key=$(op read "op://Homelab/Komodo API OnePassword Sync/username")
api_secret=$(op read "op://Homelab/Komodo API OnePassword Sync/credential")

komodo_api() {
  local endpoint="$1" payload="$2"
  curl -sf -X POST "http://localhost:9120/${endpoint}" \
    -H "Content-Type: application/json" \
    -H "X-Api-Key: ${api_key}" \
    -H "X-Api-Secret: ${api_secret}" \
    -d "$payload"
}

seed_variable() {
  local name="$1" value="$2" is_secret="${3:-true}"
  local create_payload update_payload
  create_payload=$(jq -n --arg n "$name" --arg v "$value" --argjson s "$is_secret" \
    '{type: "CreateVariable", params: {name: $n, value: $v, is_secret: $s}}')
  update_payload=$(jq -n --arg n "$name" --arg v "$value" \
    '{type: "UpdateVariableValue", params: {name: $n, value: $v}}')
  komodo_api write "$create_payload" > /dev/null 2>&1 || \
    komodo_api write "$update_payload" > /dev/null
  echo "  ${name}"
}

echo "Seeding 1Password variables into Komodo..."
seed_variable "ONEPASSWORD_CREDENTIALS" \
  "$(op document get "Homelab Credentials File" --vault Homelab)"
seed_variable "ONEPASSWORD_CONNECT_TOKEN" \
  "$(op read "op://Homelab/Homelab Access Token Komodo/credential")"
seed_variable "ONEPASSWORD_API_KEY" "$api_key"
seed_variable "ONEPASSWORD_API_SECRET" "$api_secret"

# PODHAUS_REPO is host-discovered (= $PWD at bootstrap time), so it can't
# live in komodo/sync/variables.toml — it'd be wrong on any host that
# clones the repo elsewhere. Seeded here so stacks that bind-mount via
# ${PODHAUS_REPO}/<stack>/<file> have a value to interpolate.
#
# TZ and MEDIA_DIR (other global non-secret vars) live in
# komodo/sync/variables.toml and apply via the ResourceSync's
# include_variables=true config. They're not seeded here.
echo "Seeding host-discovered variable into Komodo..."
seed_variable "PODHAUS_REPO"  "$PWD"            false

# Fenwick stack-private vars (FENWICK_SIGNAL_*, FENWICK_ADMIN_*) live
# in fenwick/stack.toml as [[variable]] blocks and apply via the
# ResourceSync. Removed from this script — co-locating stack-private
# config with the stack rather than scattering it across the
# bootstrap script.

# rclone.conf rendering moved into the backup stack's init container.
# Both bilby and kangaroo render their own /rclone/rclone.conf (named
# volume) from backup/rclone.conf.tmpl + per-host RCLONE_ONEDRIVE_TOKEN_B64
# (1P-stored, base64-encoded OAuth blob). See backup/compose.shared.yaml
# for the init logic and backup/{bilby,kangaroo}/stack.toml for the per-
# host token mapping. Bilby's prior /etc/komodo/rclone/ host-side render
# is no longer needed; the directory can be cleaned up but is left in
# place to avoid breaking any uncovered consumers.

# Bootstrap the podhaus ResourceSync resource. The CreateResourceSync
# API errors on duplicate name (`Resource with name 'X' already exists`,
# verified against Komodo 1.19.5 source bin/core/src/resource/mod.rs).
# Check existence first so re-runs of komodo-start are clean idempotent
# (rather than the older `|| true` swallow which would also hide real
# errors).
echo "Ensuring podhaus ResourceSync exists..."
if komodo_api read '{"type":"GetResourceSync","params":{"sync":"podhaus"}}' > /dev/null 2>&1; then
  echo "  podhaus ResourceSync already exists"
else
  echo "  Creating podhaus ResourceSync (first boot)..."
  komodo_api write '{
    "type": "CreateResourceSync",
    "params": {
      "name": "podhaus",
      "config": {
        "files_on_host": true,
        "resource_path": ["."],
        "include_variables": true,
        "include_resources": true,
        "webhook_enabled": true
      }
    }
  }' > /dev/null
fi

# Bootstrap-only double-sync: first pass registers stack defs + all
# TOML-declared variables (the variables.toml + per-stack [[variable]]
# blocks); komodo-op then comes up (deployed by the sync's deploy step
# for stacks with `deploy = true`) and populates OP__KOMODO__* vars;
# second pass re-renders stack environment blocks so `[[OP__KOMODO__*]]`
# references resolve to live values. Without the wait + second sync,
# fresh deploys would crash-loop on empty secrets.
#
# Steady-state debug iteration uses ./komodo-sync (single sync + deploy
# stale) — this double-sync logic lives here because it's only correct
# during cold-start.
echo "First sync (registers stack defs + non-secret vars)..."
komodo_api execute '{"type":"RunSync","params":{"sync":"podhaus"}}' > /dev/null

echo "Waiting for komodo-op to backfill OP secrets..."
while true; do
  count=$(komodo_api read '{"type":"ListVariables","params":{}}' | jq '[.[]|select(.name|startswith("OP__KOMODO__"))]|length')
  if [ "$count" -gt 0 ]; then
    echo "  ${count} OP__KOMODO__* variables populated"
    break
  fi
  sleep 5
done

echo "Second sync (env blocks now resolve to live OP vars)..."
komodo_api execute '{"type":"RunSync","params":{"sync":"podhaus"}}' > /dev/null

echo "Bootstrap complete. Use ./komodo-sync for local iteration; push to deploy."

# MinIO terraform-state bucket is bootstrapped by the MinIO stack's
# own `minio-init` init container — see minio/compose.yaml. Removed
# from komodo-start: the bucket is now a consequence of MinIO being
# deployed, not a side effect of the Komodo bootstrap script.
