[server]
bind_addr = "relay.numbat.pod.haus:2333"

[server.transport]
type = "noise"

[server.transport.noise]
local_private_key = "${RATHOLE_NOISE_LOCAL_PRIVATE_KEY}"

[server.services.public_tls]
type = "tcp"
bind_addr = "relay.numbat.pod.haus:443"
token = "${RATHOLE_PUBLIC_TLS_TOKEN}"

[server.services.forgejo_ssh]
type = "tcp"
bind_addr = "app.numbat.pod.haus:22"
token = "${RATHOLE_FORGEJO_SSH_TOKEN}"

[server.services.protected_http]
type = "tcp"
bind_addr = "127.0.0.1:8443"
token = "${RATHOLE_PROTECTED_HTTP_TOKEN}"

[server.services.bilby_ssh]
type = "tcp"
bind_addr = "127.0.0.1:2201"
token = "${RATHOLE_BILBY_SSH_TOKEN}"

[server.services.voltaire_ssh]
type = "tcp"
bind_addr = "127.0.0.1:2202"
token = "${RATHOLE_VOLTAIRE_SSH_TOKEN}"

[server.services.kangaroo_ssh]
type = "tcp"
bind_addr = "127.0.0.1:2203"
token = "${RATHOLE_KANGAROO_SSH_TOKEN}"

[server.services.fractal_ssh]
type = "tcp"
bind_addr = "127.0.0.1:2204"
token = "${RATHOLE_FRACTAL_SSH_TOKEN}"

# fractal terminates its own mTLS origin, so this carries TLS end-to-end
# from Pomerium to fractal's Caddy — the same contract protected_http has
# with bilby, just a second origin.
[server.services.fractal_http]
type = "tcp"
bind_addr = "127.0.0.1:8444"
token = "${RATHOLE_FRACTAL_HTTP_TOKEN}"

# voltaire terminates its own mTLS origin, same contract as fractal_http.
[server.services.voltaire_http]
type = "tcp"
bind_addr = "127.0.0.1:8445"
token = "${RATHOLE_VOLTAIRE_HTTP_TOKEN}"

[server.services.pinelake_ssh]
type = "tcp"
bind_addr = "127.0.0.1:2205"
token = "${RATHOLE_PINELAKE_SSH_TOKEN}"

[server.services.pinelake_http]
type = "tcp"
bind_addr = "127.0.0.1:8446"
token = "${RATHOLE_PINELAKE_HTTP_TOKEN}"

[server.services.pinelake_plex]
type = "tcp"
bind_addr = "relay.numbat.pod.haus:32400"
token = "${RATHOLE_PINELAKE_PLEX_TOKEN}"
