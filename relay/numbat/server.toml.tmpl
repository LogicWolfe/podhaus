[server]
bind_addr = "${NUMBAT_RELAY_IPV4}:2333"

[server.transport]
type = "noise"

[server.transport.noise]
local_private_key = "${RATHOLE_NOISE_LOCAL_PRIVATE_KEY}"

[server.services.public_tls]
type = "tcp"
bind_addr = "${NUMBAT_RELAY_IPV4}:443"
token = "${RATHOLE_PUBLIC_TLS_TOKEN}"

[server.services.forgejo_ssh]
type = "tcp"
bind_addr = "${NUMBAT_APPLICATION_IPV4}:22"
token = "${RATHOLE_FORGEJO_SSH_TOKEN}"

[server.services.protected_http]
type = "tcp"
bind_addr = "127.0.0.1:8443"
token = "${RATHOLE_PROTECTED_HTTP_TOKEN}"

[server.services.bilby_ssh]
type = "tcp"
bind_addr = "127.0.0.1:2201"
token = "${RATHOLE_BILBY_SSH_TOKEN}"

[server.services.voltaire_ssh]
type = "tcp"
bind_addr = "127.0.0.1:2202"
token = "${RATHOLE_VOLTAIRE_SSH_TOKEN}"
