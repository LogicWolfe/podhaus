#!/bin/bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

: "${OP_SERVICE_ACCOUNT_TOKEN:?run with: op-vault dev -- ./paperless/paperless-crosslink}"
PAPERLESS_PASSWORD="$(op read 'op://Homelab/Paperless Admin Password/password')"

TTY_FLAG=""
[ -t 0 ] && TTY_FLAG="-it"

exec docker run --rm $TTY_FLAG \
  --network dockernet \
  --user "$(id -u):$(id -g)" \
  -e PYTHONUNBUFFERED=1 \
  -e PAPERLESS_URL=http://paperless:8000 \
  -e PAPERLESS_USERNAME=nathan \
  -e PAPERLESS_PASSWORD="$PAPERLESS_PASSWORD" \
  -e PAPERLESS_HOST_HEADER=paperless.pod.haus \
  -v "$HOME/repos/podhaus-migration-state:/state:z" \
  -v "$(pwd)/paperless/paperless-crosslink.py:/app/paperless-crosslink.py:ro,z" \
  --entrypoint bash \
  python:3.13-slim \
  -c 'pip install --no-cache-dir --quiet --target=/tmp/d requests && PYTHONPATH=/tmp/d exec python /app/paperless-crosslink.py "$@"' \
  -- "$@"
