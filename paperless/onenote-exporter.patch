+    current_token = token
+    headers = {"Authorization": f"Bearer {current_token}"}
+    retryable = {429, 500, 502, 503, 504}
+    refreshed_once = False
+    for attempt in range(max_retries + 1):
         resp = requests.get(
             url,
             headers=headers,
             params=params,
             stream=stream,
-            timeout=30,
+            timeout=60,
         )
+        # Access token expired mid-run — silently refresh from MSAL cache and retry once.
+        if resp.status_code == 401 and not refreshed_once:
+            from .auth import acquire_token
+            current_token = acquire_token()
+            headers = {"Authorization": f"Bearer {current_token}"}
+            refreshed_once = True
+            continue
+        if resp.status_code not in retryable:
+            break
+        if attempt == max_retries:
+            break
+        header_retry = int(resp.headers.get("Retry-After", "1"))
+        backoff = max(header_retry, 2 ** (attempt + 1))
+        print(f"[{resp.status_code}] Retrying in {backoff}s (attempt {attempt + 1}/{max_retries + 1})")
+        time.sleep(backoff)
     resp.raise_for_status()
     return resp
 
