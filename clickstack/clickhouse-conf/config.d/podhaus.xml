<?xml version="1.0"?>
<!--
  ClickHouse override drop-in for podhaus. Layered over the image
  defaults via /etc/clickhouse-server/config.d (directory bind, not a
  file bind — see AGENTS.md Hard Rules).

  Purpose: this is the one memory-risky stack on bilby (Apple M1, 15 GB
  RAM shared with every other stack). The compose `mem_limit: 4g` is the
  hard ceiling; these settings make ClickHouse degrade *gracefully*
  inside it instead of getting OOM-killed, and bound the internal log so
  it can't quietly eat the local NVMe budget.

  Retention (TTL) is NOT set here — the OTel collector creates the
  otel_* tables; TTL is applied post-bootstrap (ALTER TABLE … MODIFY
  TTL to 180 d). See docs/plans/clickstack-migration/retention-and-storage.md.
-->
<clickhouse>
    <!-- Bind-mounting this config.d directory shadows the official
         image's docker_related_config.xml, which is what normally sets
         listen_host=0.0.0.0. Without restoring it ClickHouse listens
         only on 127.0.0.1/::1 (from config.xml): the in-container
         healthcheck passes but nothing on dockernet can reach 9000/8123,
         so the OTel collector + HyperDX get "connection refused".
         listen_try=1 mirrors the image config so a duplicate bind
         (0.0.0.0 vs the config.xml loopback entries) is non-fatal. -->
    <listen_host>0.0.0.0</listen_host>
    <listen_try>1</listen_try>

    <!-- The OTel collector inserts frequently → a large number of small
         MergeTree parts. ClickHouse otherwise attaches ALL parts before
         opening its listeners, so cold-start grew past any healthcheck
         start_period and autoheal killed it in a loop. Async loading
         opens 8123/9000 immediately and loads tables in the background
         (queries to a not-yet-loaded table briefly wait) — startup time
         is decoupled from part count. The real upstream cause (insert
         batching / part explosion) is a separate follow-up. -->
    <async_load_databases>true</async_load_databases>

    <!-- Keep ClickHouse's own footprint well under the 4g cgroup cap
         so headroom remains for queries + background merges. -->
    <max_server_memory_usage>3000000000</max_server_memory_usage>

    <!-- Logs are scanned, not point-looked-up; large caches buy little
         here and cost RAM on a tight box. Trim them down. -->
    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>

    <!-- Bound the internal server log: 8×100 MB rotation rather than
         the default unbounded growth on local NVMe. -->
    <logger>
        <size>100M</size>
        <count>8</count>
    </logger>
</clickhouse>
