# Public TLS front for MinIO's S3 API. Owns its own Let's Encrypt
# wildcard so the S3 data path never touches Cloudflare's proxy (which
# rewrites the SigV4-signed Accept-Encoding header and only has a
# single-level Universal SSL cert). See docs/plans/minio-public-caddy.md.
#
# One endpoint serves every S3 client:
#   - path-style   https://storage.pod.haus            (Terraform)
#   - virtual-host  https://<bucket>.storage.pod.haus   (Publii, aws-sdk-js v3)
# MinIO (MINIO_DOMAIN=storage.pod.haus) discriminates by Host, which
# Caddy's reverse_proxy forwards unchanged — as it does Accept-Encoding
# (no `encode` here, deliberately) — so SigV4 validates for Go and JS
# SDKs alike.

storage.pod.haus, *.storage.pod.haus {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	# The full MinIO API (S3 + admin) is served. The access-control
	# boundary is MinIO's own SigV4 — unauthenticated calls (incl. to
	# /minio/admin/) get AccessDenied; root/admin creds live only in
	# 1Password + the chezmoi-rendered Terraform env. Deliberately NOT
	# edge-blocked: an admin-path 403 would break the from-anywhere
	# `minio/terraform/` Terraform root (no TF root is exempt from the
	# from-anywhere rule — see AGENTS.md / docs/plans/minio-public-caddy.md).
	reverse_proxy minio:9000
}

# music.pod.haus — Music Assistant web UI, served LAN-direct by Caddy so
# Home Assistant's server-to-server websocket to MA bypasses Cloudflare
# Access (which blocks non-browser clients carrying no Access cookie).
# Pairs with the split-horizon A record (dns_unifi_split_horizon.tf): on
# the LAN this name resolves to bilby → Caddy → MA; off-LAN it resolves
# to the public CF record → tunnel → MA. MA's base_url is
# https://music.pod.haus so every client is told to use this name. MA is
# host-network, so Caddy reaches it over the dockernet bridge gateway.
music.pod.haus {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy 172.18.0.1:8095
}

# nathanbaxter.com — public static site, served from the
# `nathanbaxter-com` bucket (anonymous GetObject). The PUBLIC site is
# https + Cloudflare-proxied; this `http://` is only the internal
# cloudflared→Caddy hop (like every other pod.haus tunnel service) and
# the deliberate signal that Caddy must NOT ACME this name (Cloudflare
# owns the cert).
http://nathanbaxter.com, http://www.nathanbaxter.com {
	@www host www.nathanbaxter.com
	redir @www https://nathanbaxter.com{uri} permanent

	# Missing-object handling — known limitation, status stays 200.
	# The route's reverse_proxy detects MinIO's NoSuchKey 404, raises
	# `error 404`, handle_errors here fetches the styled 404.html and
	# serves it as the body. We CANNOT yet pin the final status back
	# to 404: Caddy 2.11.3's `replace_status` directive is rejected
	# inside both `handle_response` and `handle_errors` subhandler
	# contexts, and the inner reverse_proxy here overwrites the
	# original 404 with the 200 it gets from fetching 404.html. See
	# docs/plans/caddy-404-status-and-komodo-ifchanged.md.
	handle_errors 404 {
		rewrite * /nathanbaxter-com/404.html
		reverse_proxy minio:9000
	}

	# Mutually-exclusive handle blocks, each mapping one URL class to
	# the COMPLETE bucket key in a single rewrite (no rewrite chaining
	# — Caddy doesn't reliably chain sequential rewrites here). The
	# generator emits <dir>/index.html; assets carry a file extension.
	route {
		@dirslash path_regexp dirslash ^(/.+)/$
		@noext path_regexp noext ^(/[^.]+)$

		handle / {
			rewrite * /nathanbaxter-com/index.html
		}
		handle @dirslash {
			rewrite * /nathanbaxter-com{re.dirslash.1}/index.html
		}
		handle @noext {
			rewrite * /nathanbaxter-com{re.noext.1}/index.html
		}
		handle {
			rewrite * /nathanbaxter-com{path}
		}

		reverse_proxy minio:9000 {
			# MinIO 404 (NoSuchKey) → raise error 404 so handle_errors
			# above can serve the styled 404 page while keeping the
			# real status code.
			@missing status 404
			handle_response @missing {
				error 404
			}
		}
	}
}

# sky.pod.haus — Sky Croeser's site (skycroeser.net), TEMPORARY demo
# host. Same serving shape as nathanbaxter.com above (Publii static
# output in the `skycroeser-net` bucket, anonymous GetObject), with the
# WordPress.com legacy-URL redirects Sky's archive needs. The bucket is
# named for the real domain even while demoed here. At cutover,
# skycroeser.net (+ www) joins this site line — the redirects below are
# already in place for it and are harmless no-ops on sky.pod.haus (no
# dated inbound links resolve here yet).
#
# `http://` = the internal cloudflared→Caddy hop only (Cloudflare owns
# the edge cert); the deliberate signal that Caddy must NOT ACME it.
http://sky.pod.haus {
	# Styled 404 — same status caveat as nathanbaxter.com (stays 200
	# until Caddy can replace_status inside handle_errors). Verify the
	# Terminal theme emits 404.html; otherwise this itself 404s.
	handle_errors 404 {
		rewrite * /skycroeser-net/404.html
		reverse_proxy minio:9000
	}

	route {
		# (1) WordPress.com legacy URL preservation — `route` evaluates
		# in written order, so these fire before the bucket rewrites.
		# Posts were /YYYY/MM/DD/slug/ ; Publii serves /slug/. The
		# single-segment capture deliberately skips nested attachment
		# pages (/Y/M/D/post/image/) — they fall through to a 404.
		@wp_dated path_regexp wp_dated ^/\d{4}/\d{2}/\d{2}/([^/]+)/?$
		redir @wp_dated /{re.wp_dated.1}/ 301
		redir /feed/ /feed.xml 301
		redir /feed /feed.xml 301
		redir /category/uncategorized/ / 301
		redir /category/uncategorized / 301

		# G3 — renamed pages (old WP page slug → current Publii slug)
		redir /about/ /my-research-and-teaching/ 301
		redir /sketchmapforresearch/ /new-research-students/ 301
		# G4 — WordPress tag/author archive prefix changed (singular → plural)
		@wp_tag path_regexp wp_tag ^/tag/(.+)$
		redir @wp_tag /tags/{re.wp_tag.1} 301
		@wp_author path_regexp wp_author ^/author/(.+)$
		redir @wp_author /authors/{re.wp_author.1} 301
		# G2 — posts Publii re-slugged on import (old WP slug → current slug).
		# Reached either directly or after the @wp_dated date-strip above.
		redir /activism-and-play/ /come-brother-come-sister-look-at-this-software-activism-and-play/ 301
		redir /aies-ai-for-social-good/ /aies-ai-for-social-good-human-machine-interactions-and-trustworthy-ai/ 301
		redir /aies-day-1-artificial-agency-autonomy-and-lethality/ /aies-day-1-artificial-agency-autonomy-and-lethality-rights-and-principles/ 301
		redir /blueprint-for-the-future/ /blueprints-for-the-future/ 301
		redir /burning-man-individuality-and_community/ /burning-man-individuality-and-community/ 301
		redir /burning-man-reaching-ou/ /burning-man-reaching-out/ 301
		redir /citizen-lab-summer-institute-day-1/ /citizen-lab-summer-institute-on-monitoring-internet-openness-and-rights-day-1/ 301
		redir /compromised-data-day-one/ /compromised-data-social-media-research-methodological-challenges-unexamined-niches-and-the-politics-of-big-data/ 301
		redir /compromised-data-day-two/ /compromised-data-the-social-life-of-data-new-tools-audience-engagement-and-social-movements/ 301
		redir /contradictoryfeelings/ /quandaries-of-apparently-contradictory-feelings/ 301
		redir /creating-change-adshel-live-animal-exports-the-quick-and-easy-campaign/ /creating-change-adshel-live-animal-exports-and-the-quick-and-easy-campaign/ 301
		redir /ica18-day-3-activism-subalterns-more-activism-post-colonial-imaginations-and-cultural-symbols/ /ica18-day-3-activism-subalterns-more-activism-postcolonial-imaginations-and-cultural-symbols/ 301
