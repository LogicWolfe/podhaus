		# (2) pretty URL → COMPLETE bucket key in one rewrite per class
		# (no rewrite chaining — Caddy won't reliably chain them here).
		@dirslash path_regexp dirslash ^(/.+)/$
		@noext path_regexp noext ^(/[^.]+)$

