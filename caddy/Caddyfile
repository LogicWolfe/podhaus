# Public TLS front for MinIO's S3 API. Owns its own Let's Encrypt
# wildcard so the S3 data path never touches Cloudflare's proxy (which
# rewrites the SigV4-signed Accept-Encoding header and only has a
# single-level Universal SSL cert). See docs/plans/minio-public-caddy.md.
#
# One endpoint serves every S3 client:
#   - path-style   https://storage.pod.haus            (Terraform)
#   - virtual-host  https://<bucket>.storage.pod.haus   (Publii, aws-sdk-js v3)
# MinIO (MINIO_DOMAIN=storage.pod.haus) discriminates by Host, which
# Caddy's reverse_proxy forwards unchanged — as it does Accept-Encoding
# (no `encode` here, deliberately) — so SigV4 validates for Go and JS
# SDKs alike.

storage.pod.haus, *.storage.pod.haus {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	# The full MinIO API (S3 + admin) is served. The access-control
	# boundary is MinIO's own SigV4 — unauthenticated calls (incl. to
	# /minio/admin/) get AccessDenied; root/admin creds live only in
	# 1Password + the chezmoi-rendered Terraform env. Deliberately NOT
	# edge-blocked: an admin-path 403 would break the from-anywhere
	# `minio/terraform/` Terraform root (no TF root is exempt from the
	# from-anywhere rule — see AGENTS.md / docs/plans/minio-public-caddy.md).
	reverse_proxy minio:9000
}

# music.pod.haus — Music Assistant web UI, served LAN-direct by Caddy so
# Home Assistant's server-to-server websocket to MA bypasses Cloudflare
# Access (which blocks non-browser clients carrying no Access cookie).
# Pairs with the split-horizon A record (dns_unifi_split_horizon.tf): on
# the LAN this name resolves to bilby → Caddy → MA; off-LAN it resolves
# to the public CF record → tunnel → MA. MA's base_url is
# https://music.pod.haus so every client is told to use this name. MA is
# host-network, so Caddy reaches it over the dockernet bridge gateway.
music.pod.haus {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy 172.18.0.1:8095
}

# nathanbaxter.com — public static site, served from the
# `nathanbaxter-com` bucket (anonymous GetObject). The PUBLIC site is
# https + Cloudflare-proxied; this `http://` is only the internal
# cloudflared→Caddy hop (like every other pod.haus tunnel service) and
# the deliberate signal that Caddy must NOT ACME this name (Cloudflare
# owns the cert).
http://nathanbaxter.com, http://www.nathanbaxter.com {
	@www host www.nathanbaxter.com
	redir @www https://nathanbaxter.com{uri} permanent

	# Missing-object handling: the route's reverse_proxy detects MinIO's
	# NoSuchKey 404, raises `error 404`, and this handler serves the
	# styled 404.html body from the bucket with a real 404 status.
	# `replace_status` overrides the 200 the inner reverse_proxy gets
	# for the (existing) 404.html object — and it must sit INSIDE the
	# reverse_proxy block, not as a standalone handle_errors directive
	# (the placement an earlier attempt got wrong). See
	# docs/plans/caddy-404-status-and-komodo-ifchanged.md.
	handle_errors 404 {
		rewrite * /nathanbaxter-com/404.html
		reverse_proxy minio:9000 {
			replace_status 404
		}
	}

	# Mutually-exclusive handle blocks, each mapping one URL class to
	# the COMPLETE bucket key in a single rewrite (no rewrite chaining
	# — Caddy doesn't reliably chain sequential rewrites here). The
	# generator emits <dir>/index.html; assets carry a file extension.
	route {
		@dirslash path_regexp dirslash ^(/.+)/$
		@noext path_regexp noext ^(/[^.]+)$

		handle / {
			rewrite * /nathanbaxter-com/index.html
		}
		handle @dirslash {
			rewrite * /nathanbaxter-com{re.dirslash.1}/index.html
		}
		handle @noext {
			rewrite * /nathanbaxter-com{re.noext.1}/index.html
		}
		handle {
			rewrite * /nathanbaxter-com{path}
		}

		reverse_proxy minio:9000 {
			# MinIO 404 (NoSuchKey) → raise error 404 so handle_errors
			# above can serve the styled 404 page while keeping the
			# real status code.
			@missing status 404
			handle_response @missing {
				error 404
			}
		}
	}
}

# sky.pod.haus — Sky Croeser's site (skycroeser.net), TEMPORARY demo
# host. Same serving shape as nathanbaxter.com above (Publii static
# output in the `skycroeser-net` bucket, anonymous GetObject), with the
# WordPress.com legacy-URL redirects Sky's archive needs. The bucket is
# named for the real domain even while demoed here. At cutover,
# skycroeser.net (+ www) joins this site line — the redirects below are
# already in place for it and are harmless no-ops on sky.pod.haus (no
# dated inbound links resolve here yet).
#
# `http://` = the internal cloudflared→Caddy hop only (Cloudflare owns
# the edge cert); the deliberate signal that Caddy must NOT ACME it.
#
# skycroeser.net shares this block (the real domain; sky.pod.haus stays
# as a staging mirror). www.skycroeser.net 301s to the apex from its own
# block below, so only the bare apex serves content (canonical URL).
http://sky.pod.haus, http://skycroeser.net {
	# Styled 404 served from the bucket with a real 404 status (same
	# pattern as nathanbaxter.com above — replace_status inside the
	# reverse_proxy block). Terminal theme emits 404.html.
	handle_errors 404 {
		rewrite * /skycroeser-net/404.html
		reverse_proxy minio:9000 {
			replace_status 404
		}
	}

	route {
		# (1) WordPress.com legacy URL preservation — `route` evaluates
		# in written order, so these fire before the bucket rewrites.
		# Posts were /YYYY/MM/DD/slug/ ; Publii serves /slug/. The
		# single-segment capture deliberately skips nested attachment
		# pages (/Y/M/D/post/image/) — they fall through to a 404.
		@wp_dated path_regexp wp_dated ^/\d{4}/\d{2}/\d{2}/([^/]+)/?$
		redir @wp_dated /blog/{re.wp_dated.1}/ 301
		redir /feed/ /feed.xml 301
		redir /feed /feed.xml 301
		redir /category/uncategorized/ /blog/ 301
		redir /category/uncategorized /blog/ 301

		# G3 — old WP page URLs. "My research and teaching" (was /about/)
		# is now the Publii frontpage, so /about/ → / (the old site
		# served that content at both / and /about/ too).
		redir /about/ / 301
		redir /sketchmapforresearch/ /new-research-students/ 301
		# G4 — WordPress tag/author archive prefix changed (singular → plural)
		@wp_tag path_regexp wp_tag ^/tag/(.+)$
		redir @wp_tag /tags/{re.wp_tag.1} 301
		@wp_author path_regexp wp_author ^/author/(.+)$
		redir @wp_author /authors/{re.wp_author.1} 301
		# G2 — posts Publii re-slugged on import (old WP slug → current slug).
		# Reached either directly or after the @wp_dated date-strip above.
		redir /blog/activism-and-play/ /blog/come-brother-come-sister-look-at-this-software-activism-and-play/ 301
		redir /blog/aies-ai-for-social-good/ /blog/aies-ai-for-social-good-human-machine-interactions-and-trustworthy-ai/ 301
		redir /blog/aies-day-1-artificial-agency-autonomy-and-lethality/ /blog/aies-day-1-artificial-agency-autonomy-and-lethality-rights-and-principles/ 301
		redir /blog/blueprint-for-the-future/ /blog/blueprints-for-the-future/ 301
		redir /blog/burning-man-individuality-and_community/ /blog/burning-man-individuality-and-community/ 301
		redir /blog/burning-man-reaching-ou/ /blog/burning-man-reaching-out/ 301
		redir /blog/citizen-lab-summer-institute-day-1/ /blog/citizen-lab-summer-institute-on-monitoring-internet-openness-and-rights-day-1/ 301
		redir /blog/compromised-data-day-one/ /blog/compromised-data-social-media-research-methodological-challenges-unexamined-niches-and-the-politics-of-big-data/ 301
		redir /blog/compromised-data-day-two/ /blog/compromised-data-the-social-life-of-data-new-tools-audience-engagement-and-social-movements/ 301
		redir /blog/contradictoryfeelings/ /blog/quandaries-of-apparently-contradictory-feelings/ 301
		redir /blog/creating-change-adshel-live-animal-exports-the-quick-and-easy-campaign/ /blog/creating-change-adshel-live-animal-exports-and-the-quick-and-easy-campaign/ 301
		redir /blog/ica18-day-3-activism-subalterns-more-activism-post-colonial-imaginations-and-cultural-symbols/ /blog/ica18-day-3-activism-subalterns-more-activism-postcolonial-imaginations-and-cultural-symbols/ 301
		redir /blog/ica18-day-4-labour-in-the-gig-economy-resistant-media-feminist-peer-review-love-sex-and-friendship/ /blog/ica18-day-4-labour-in-the-gig-economy-resistant-media-feminist-peer-review-love-sex-and-friendship-illiberal-democracy-in-eastern-and-central-europe/ 301
		redir /blog/identity-humanity-affective-news-and-the-department-of-shameless-studies/ /blog/ir13-plenaries-identity-humanity-affective-news-and-the-department-of-shameless-studies/ 301
		redir /blog/ir13-epic-saturday/ /blog/ir13-saturday-highlights-jedward-peppa-pig-occupy-occupy-more-occupy-twitter-twitter-and-more-twitter/ 301
		redir /blog/ir13-sessions-protest-and-online-activism-online-activism-with-some-extra-online-activism/ /blog/ir13-friday-session-protest-and-online-activism/ 301
		redir /blog/ir13-sunday-highlights-mobile-ecologies-instagram-disruptive-spaces-teaching-on-facebook-and-a-bit-more-activism/ /blog/ir13-sunday-highlights-mobile-ecologies-instagram-disruptive-spaces-teaching-on-facebookand-a-bit-more-activism/ 301
		redir /blog/linux-conference-australia-disaster-response-activism-copyrigh/ /blog/linux-conference-australia-disaster-response-activism-and-copyright/ 301
		redir /blog/maintenance-creation/ /blog/maintenancecreation/ 301
		redir /blog/national-identity-scheme/ /blog/national-identity-schemes/ 301
		redir /blog/occupy-together-who-is-the-99-percent/ /blog/occupy-together-whos-the-99-percent/ 301
		redir /blog/opening-activism/ /blog/opening-activismsyzitisi-kai-ergastiri-anoihtoy-aktivismoy/ 301
		redir /blog/post-arab-spring-tunisia-local-government-in-indonesia-a-start-up-democracy/ /blog/post-arab-spring-tunisia-local-government-in-indonesia-a-start-up-democracy-and-the-youth/ 301
		redir /blog/post-arab-spring-tunisia-session-3/ /blog/post-arab-spring-tunisia-session-3-decentralisation-and-intercultural-practice/ 301
		redir /blog/racism-and-censorship-in-athen/ /blog/racism-and-censorship-first-impressions-of-athens/ 301
		redir /blog/twitter-revolution-connections/ /blog/connecting-to-the-twitter-revolution/ 301
		redir /blog/udc2015-circuits-of-struggle-day-2-journalism-and-climate-change-cultureappropriation-struggles-over-digital-technologies/ /blog/udc2015-circuits-of-struggle-day-2-journalism-and-climate-change-cultureappropriation-struggles-over-digital-technologies-and-femtechnet/ 301
		redir /blog/upcomingooactivism/ /blog/upcoming-oo-activism/ 301
		redir /blog/web-presence-workshop-1/ /blog/web-presence-workshop-1-activism-support-and-volcano-sacrifices/ 301
		redir /blog/why-im-ending-my-short-experiment-with-gittip-or-why-we-cant-have-nice-things-part-2039/ /blog/why-im-ending-my-short-experiment-with-gittip-now-gratipay-or-why-we-cant-have-nice-things-part-2039/ 301

		# (2) pretty URL → COMPLETE bucket key in one rewrite per class
		# (no rewrite chaining — Caddy won't reliably chain them here).
		@dirslash path_regexp dirslash ^(/.+)/$
		@noext path_regexp noext ^(/[^.]+)$

		handle / {
			rewrite * /skycroeser-net/index.html
		}
		handle @dirslash {
			rewrite * /skycroeser-net{re.dirslash.1}/index.html
		}
		handle @noext {
			rewrite * /skycroeser-net{re.noext.1}/index.html
		}
		handle {
			rewrite * /skycroeser-net{path}
		}

		reverse_proxy minio:9000 {
			@missing status 404
			handle_response @missing {
				error 404
			}
		}
	}
}

# www.skycroeser.net → 301 to the bare apex (canonical). Kept as a
# dedicated block rather than joining the site line above so www never
# serves duplicate content. Reaches Caddy via its own tunnel ingress rule.
http://www.skycroeser.net {
	redir https://skycroeser.net{uri} 301
}
