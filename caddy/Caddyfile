# music.pod.haus — Music Assistant web UI, served LAN-direct by Caddy so
# Home Assistant's server-to-server websocket to MA bypasses Cloudflare
# Access (which blocks non-browser clients carrying no Access cookie).
# Pairs with the split-horizon A record (dns_unifi_split_horizon.tf): on
# the LAN this name resolves to bilby → Caddy → MA; off-LAN it resolves
# to the public CF record → tunnel → MA. MA's base_url is
# https://music.pod.haus so every client is told to use this name. MA is
# host-network, so Caddy reaches it over the dockernet bridge gateway.
music.pod.haus {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy 172.18.0.1:8095
}

# nathanbaxter.com is served from the
# `nathanbaxter-com` bucket (anonymous GetObject). Cloudflare reaches the
# active Numbat path on :4444. The shared route stays available to the
# retained HTTP cloudflared origin, while only :4444 requires Cloudflare's
# origin-pull client certificate.
(nathan_site) {
	@www host www.nathanbaxter.com
	redir @www https://nathanbaxter.com{uri} permanent

	@nathanImmutable {
		host nathanbaxter.com
		path /_astro/*
	}
	header @nathanImmutable {
		Cache-Control "public, max-age=31536000, immutable"
		CDN-Cache-Control "public, max-age=31536000"
		-Cache-Tag
	}

	@nathanRelease {
		host nathanbaxter.com
		not path /_astro/*
	}
	header @nathanRelease {
		Cache-Control "no-cache"
		CDN-Cache-Control "public, max-age=31536000"
		Cache-Tag "{env.NATHANBAXTER_CACHE_TAG}"
	}

	# Missing-object handling: the route's reverse_proxy detects MinIO's
	# NoSuchKey 404, raises `error 404`, and this handler serves the
	# styled 404.html body from the bucket with a real 404 status.
	# `replace_status` overrides the 200 the inner reverse_proxy gets
	# for the existing 404.html object. It must sit INSIDE the
	# reverse_proxy block, not as a standalone handle_errors directive.
	handle_errors 404 {
		rewrite * /nathanbaxter-com/404.html
		reverse_proxy minio:9000 {
			replace_status 404
		}
	}

	# Mutually-exclusive handle blocks, each mapping one URL class to
	# the COMPLETE bucket key in a single rewrite (no rewrite chaining
	# — Caddy doesn't reliably chain sequential rewrites here). The
	# generator emits <dir>/index.html; assets carry a file extension.
	route {
		handle /.well-known/webfinger {
			header Content-Type application/jrd+json
			respond `{"subject":"acct:nathan@nathanbaxter.com","links":[{"rel":"http://openid.net/specs/connect/1.0/issuer","href":"https://id.pod.haus"}]}`
		}

		@dirslash path_regexp dirslash ^(/.+)/$
		@noext path_regexp noext ^(/[^.]+)$

		handle / {
			rewrite * /nathanbaxter-com/index.html
		}
		handle @dirslash {
			rewrite * /nathanbaxter-com{re.dirslash.1}/index.html
		}
		handle @noext {
			rewrite * /nathanbaxter-com{re.noext.1}/index.html
		}
		handle {
			rewrite * /nathanbaxter-com{path}
		}

		reverse_proxy minio:9000 {
			# MinIO 404 (NoSuchKey) → raise error 404 so handle_errors
			# above can serve the styled 404 page while keeping the
			# real status code.
			@missing status 404
			handle_response @missing {
				error 404
			}
		}
	}
}

http://nathanbaxter.com, http://www.nathanbaxter.com {
	import nathan_site
}

nathanbaxter.com:4444, www.nathanbaxter.com:4444 {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		client_auth {
			trust_pool file /etc/caddy/pki/cloudflare-origin-pull-ca.pem
		}
	}
	import nathan_site
}

# skycroeser.net — Sky Croeser's site. Same serving shape as
# nathanbaxter.com above (Publii static output in the `skycroeser-net`
# bucket, anonymous GetObject), with the WordPress.com legacy-URL
# redirects Sky's archive needs.
#
# `http://` is the retained cloudflared hop; Numbat reaches :4444. Both use
# the same site snippet, but only the Numbat listener requires AOP.
#
# www.skycroeser.net 301s to the apex from its own block below, so only
# the bare apex serves content (canonical URL).
(sky_site) {
	header {
		Cache-Control "no-cache"
		CDN-Cache-Control "public, max-age=31536000"
		Cache-Tag "{env.SKY_CACHE_TAG}"
	}

	# Styled 404 served from the bucket with a real 404 status (same
	# pattern as nathanbaxter.com above — replace_status inside the
	# reverse_proxy block). Terminal theme emits 404.html.
	handle_errors 404 {
		rewrite * /skycroeser-net/404.html
		reverse_proxy minio:9000 {
			replace_status 404
		}
	}

	route {
		# (1) WordPress.com legacy URL preservation — `route` evaluates
		# in written order, so these fire before the bucket rewrites.
		# Posts were /YYYY/MM/DD/slug/ ; Publii serves /slug/. The
		# single-segment capture deliberately skips nested attachment
		# pages (/Y/M/D/post/image/) — they fall through to a 404.
		@wp_dated path_regexp wp_dated ^/\d{4}/\d{2}/\d{2}/([^/]+)/?$
		redir @wp_dated /blog/{re.wp_dated.1}/ 301
		redir /feed/ /feed.xml 301
		redir /feed /feed.xml 301
		redir /category/uncategorized/ /blog/ 301
		redir /category/uncategorized /blog/ 301

		# G3 — old WP page URLs. "My research and teaching" (was /about/)
		# is now the Publii frontpage, so /about/ → / (the old site
		# served that content at both / and /about/ too).
		redir /about/ / 301
		redir /sketchmapforresearch/ /new-research-students/ 301
		# G4 — WordPress tag/author archive prefix changed (singular → plural)
		@wp_tag path_regexp wp_tag ^/tag/(.+)$
		redir @wp_tag /tags/{re.wp_tag.1} 301
		@wp_author path_regexp wp_author ^/author/(.+)$
		redir @wp_author /authors/{re.wp_author.1} 301
		# G2 — posts Publii re-slugged on import (old WP slug → current slug).
		# Reached either directly or after the @wp_dated date-strip above.
		redir /blog/activism-and-play/ /blog/come-brother-come-sister-look-at-this-software-activism-and-play/ 301
		redir /blog/aies-ai-for-social-good/ /blog/aies-ai-for-social-good-human-machine-interactions-and-trustworthy-ai/ 301
		redir /blog/aies-day-1-artificial-agency-autonomy-and-lethality/ /blog/aies-day-1-artificial-agency-autonomy-and-lethality-rights-and-principles/ 301
		redir /blog/blueprint-for-the-future/ /blog/blueprints-for-the-future/ 301
		redir /blog/burning-man-individuality-and_community/ /blog/burning-man-individuality-and-community/ 301
		redir /blog/burning-man-reaching-ou/ /blog/burning-man-reaching-out/ 301
		redir /blog/citizen-lab-summer-institute-day-1/ /blog/citizen-lab-summer-institute-on-monitoring-internet-openness-and-rights-day-1/ 301
		redir /blog/compromised-data-day-one/ /blog/compromised-data-social-media-research-methodological-challenges-unexamined-niches-and-the-politics-of-big-data/ 301
		redir /blog/compromised-data-day-two/ /blog/compromised-data-the-social-life-of-data-new-tools-audience-engagement-and-social-movements/ 301
		redir /blog/contradictoryfeelings/ /blog/quandaries-of-apparently-contradictory-feelings/ 301
		redir /blog/creating-change-adshel-live-animal-exports-the-quick-and-easy-campaign/ /blog/creating-change-adshel-live-animal-exports-and-the-quick-and-easy-campaign/ 301
