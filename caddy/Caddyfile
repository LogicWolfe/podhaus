{
	# Pomerium authenticates once with mTLS, then preserves each route's Host
	# header for Caddy dispatch. The private listener is not reachable directly.
	servers :4443 {
		strict_sni_host insecure_off
	}
}

# Public TLS front for MinIO's S3 API. Owns its own Let's Encrypt
# wildcard so the S3 data path never touches Cloudflare's proxy (which
# rewrites the SigV4-signed Accept-Encoding header and only has a
# single-level Universal SSL cert). See docs/hosts.html#kookaburra.
#
# One endpoint serves every S3 client:
#   - path-style   https://storage.pod.haus            (Terraform)
#   - virtual-host  https://<bucket>.storage.pod.haus   (Publii, aws-sdk-js v3)
# MinIO (MINIO_DOMAIN=storage.pod.haus) discriminates by Host, which
# Caddy's reverse_proxy forwards unchanged — as it does Accept-Encoding
# (no `encode` here, deliberately) — so SigV4 validates for Go and JS
# SDKs alike.

(pomerium_origin_tls) {
	tls /run/podhaus-secrets/pomerium-origin-server-cert.pem /run/podhaus-secrets/pomerium-origin-server-key.pem {
		client_auth {
			trust_pool file /run/podhaus-secrets/pomerium-origin-ca.pem
		}
	}
}

# Protected routes are reachable only through Numbat's loopback-bound rathole
# service. Caddy also requires Pomerium's client certificate on port 4443.
:4443 {
	import pomerium_origin_tls
	@missing_mcp_token {
		host watch.pod.haus
		path /api/mcp /api/mcp/*
		not header X-Podhaus-Gateway-Token {env.HYPERDX_MCP_GATEWAY_TOKEN}
	}
	@gatus host edge-canary.pod.haus gatus.pod.haus
	@bugs host bugs.pod.haus
	@backup host backup.pod.haus
	@fenwick host fenwick.pod.haus
	@kangaroo_backup host kangaroo-backup.pod.haus
	@kangaroo host kangaroo.pod.haus
	@komodo host komodo.pod.haus
	@torrent host torrent.pod.haus
	@home host home.pod.haus
	@plex host plex.pod.haus
	@music host music.pod.haus
	@watch host watch.pod.haus
	@docs host docs.pod.haus
	@minio_console host minio.pod.haus
	@sync host sync.pod.haus
	@paperless host paperless.pod.haus
	@stats host stats.pod.haus
	@git host git.pod.haus
	@dev host dev.nathanbaxter.com

	route {
		respond @missing_mcp_token 401
		reverse_proxy @gatus gatus:8080
		reverse_proxy @bugs bugsink:8000
		reverse_proxy @backup backrest:9898
		reverse_proxy @fenwick fenwick:8088
		reverse_proxy @kangaroo_backup 10.0.0.25:9898
		reverse_proxy @kangaroo 10.0.0.25:8080
		reverse_proxy @komodo komodo-core:9120
		reverse_proxy @torrent flood:3000
		reverse_proxy @home 172.18.0.1:8123
		reverse_proxy @plex 172.18.0.1:32400
		reverse_proxy @music 172.18.0.1:8095
		reverse_proxy @watch hyperdx:8080
		reverse_proxy @docs docs:8000
		reverse_proxy @minio_console minio:9001
		reverse_proxy @sync 10.0.0.25:8384
		reverse_proxy @paperless paperless:8000
		reverse_proxy @stats umami:3000
		reverse_proxy @git forgejo:3000
		reverse_proxy @dev nathanbaxter-dev:4321
		respond 404
	}
}

