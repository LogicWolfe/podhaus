#!/bin/bash
# Reference copy of podhaus's pre-commit hook. Install via symlink so
# future edits to this file are picked up automatically:
#
#   ln -sf ../../tools/pre-commit .git/hooks/pre-commit
#
# Checks run:
#   - lint-stack-env.py:           catches stack.toml env declarations
#                                   that no compose service references
#                                   (silent empty-var footgun).
#   - lint-stack-content-hash.py:  catches services that don't depend on
#                                   STACK_CONTENT_HASH (label + build-arg
#                                   pattern), so content changes wouldn't
#                                   actually recreate the container.
#   - lint-stack-toml.py:          rejects `deploy = true` on podhaus
#                                   stacks — Komodo's Sync Deploy sub-
#                                   stage duplicates Stage 2 and breaks
#                                   on transient linked-repo timeouts.
#   - lint-alloy-timestamps.py:    rejects `stage.timestamp` outside the
#                                   file-source Alloy modules (a container
#                                   row keeps Docker's receive time) and any
#                                   time zone pinned in a logging config.
#   - render-pomerium-keys.py --verify:
#                                   catches pomerium/config.yaml or
#                                   stack.toml key material that no longer
#                                   matches the Ansible inventory (the one
#                                   authoritative home for SSH keys).
#   - storage_binds role tests:     the reconciler's behaviour plus the
#                                   inventory contract for it — every
#                                   storage host declares its volumes, and
#                                   an automount pair is hardened on BOTH
#                                   halves. The .mount half being missed is
#                                   what let the 2026-05-30 mount wedge
#                                   recur on 2026-08-30.
#   - docker role tests:           daemon.json renders byte-for-byte as before
#                                   without the GPU switch (a drift would
#                                   restart Docker on every host) and carries
#                                   exactly the nvidia runtime with it.
#   - wsl role tests:              chrony's config (the Windows-clock refclock
#                                   never selected nor required, makestep at
#                                   any time, chronyd ordered after that
#                                   clock's device) and
#                                   `base` running before `wsl` and `earlyoom`
#                                   in fractal.yml and site.yml, so a fresh-host
#                                   dry run has the dnf5 bindings.
#   - docs_sources role tests:      source slots remain isolated and every
#                                   docs host declares both aggregate and
#                                   canonical chezmoi locations.
#   - backup heartbeat tests:       every configured push endpoint exists
#                                   in Gatus, including per-plan hooks.
#   - metube plexify tests:        the Sonarr-naming hook's title-matching
#                                   confidence rule (containment, difflib
#                                   ratio+margin, the 59-title Skillsville
#                                   fixture) runs with no network.
#   - llm tests:                    the watcher's handoff rules replayed
#                                   against a recorded game session, the
#                                   model-server log parsing against real
#                                   log lines, and the sign-in token command
#                                   against a stand-in Pocket ID.
#   - setup page tests:             the install scripts and claude-podhaus
#                                   against a stand-in llm.pod.haus, the
#                                   public Pomerium route, and, under node,
#                                   the page's sign-in script with stand-in
#                                   browser objects and the pi extension's
#                                   device sign-in against a stand-in
#                                   Pocket ID.
#   - fractal Caddy listener tests: the real Caddyfile's loopback and LAN
#                                   listeners run under the mise-installed
#                                   caddy, with stand-in upstreams.
set -e
root="$(git rev-parse --show-toplevel)"
cd "$root"

if ! command -v mise >/dev/null 2>&1; then
  echo "podhaus hooks require mise; install it, then follow the Python setup in README.md" >&2
  exit 1
fi

if ! mise exec -- pipenv --venv >/dev/null 2>&1; then
  echo "podhaus Pipenv is not installed; follow the Python setup in README.md" >&2
  exit 1
fi

if ! mise exec -- node --version >/dev/null 2>&1; then
  echo "podhaus hooks require Node from mise.toml; run mise install" >&2
  exit 1
fi

mise exec -- pipenv run python "$root/tools/lint-stack-env.py"
mise exec -- pipenv run python "$root/tools/lint-stack-content-hash.py"
mise exec -- pipenv run python "$root/tools/lint-stack-toml.py"
mise exec -- pipenv run python "$root/tools/lint-alloy-timestamps.py"
mise exec -- pipenv run python "$root/tools/render-pomerium-keys.py" --verify
mise exec -- pipenv run python "$root/tools/render-lan-addresses.py" --verify
# These tests create repositories whose git commands need their own index.
unset GIT_INDEX_FILE
mise exec -- pipenv run python -m unittest discover \
  --start-directory "$root/tools/tests"
mise exec -- pipenv run python -m unittest discover \
  --start-directory "$root/ansible/roles/storage_binds/tests"
mise exec -- pipenv run python -m unittest discover \
  --start-directory "$root/ansible/roles/docs_sources/tests"
mise exec -- pipenv run python -m unittest discover \
  --start-directory "$root/ansible/roles/earlyoom/tests"
mise exec -- pipenv run python -m unittest discover \
  --start-directory "$root/ansible/roles/docker/tests"
mise exec -- pipenv run python -m unittest discover \
  --start-directory "$root/ansible/roles/wsl/tests"
mise exec -- pipenv run python -m unittest discover \
  --start-directory "$root/metube/tests"
mise exec -- pipenv run python -m unittest discover \
  --start-directory "$root/lumen/tests"
mise exec -- pipenv run python -m unittest discover \
  --start-directory "$root/backup/tests"
mise exec -- pipenv run python -m unittest discover \
  --start-directory "$root/llm/tests"
mise exec -- pipenv run python -m unittest discover \
  --start-directory "$root/caddy/fractal/tests"
mise exec -- node --test "$root/caddy/fractal/tests/podhaus.test.ts"
mise exec -- node --test "$root/caddy/fractal/tests/setup-page.test.ts"
