#!/bin/bash
# podhaus's pre-commit hook: the static lints, which read the working tree and
# finish in a second or two. Install via symlink so edits here are live:
#
#   ln -sf ../../tools/pre-commit .git/hooks/pre-commit
#
# The test suites and the Alloy config lint, which needs Docker, run in CI
# through tools/check, and a push deploys only once CI is green
# (.github/workflows/check.yml). Run tools/check locally for the same result
# before pushing.
#
#   - lint-stack-env.py:           stack.toml env declarations that no compose
#                                   service references (silent empty-var
#                                   footgun).
#   - lint-stack-content-hash.py:  services that don't depend on
#                                   STACK_CONTENT_HASH (label + build-arg
#                                   pattern), so content changes wouldn't
#                                   actually recreate the container.
#   - lint-stack-toml.py:          `deploy = true` on podhaus stacks; Komodo's
#                                   Sync Deploy sub-stage duplicates Stage 2
#                                   and breaks on transient linked-repo
#                                   timeouts.
#   - lint-alloy-timestamps.py:    `stage.timestamp` outside the file-source
#                                   Alloy modules (a container row keeps
#                                   Docker's receive time) and any time zone
#                                   pinned in a logging config.
#   - render-pomerium-keys.py --verify:
#                                   pomerium/config.yaml or stack.toml key
#                                   material that no longer matches the
#                                   Ansible inventory.
#   - render-lan-addresses.py --verify:
#                                   Komodo LAN address variables that differ
#                                   from config/lan-addresses.json.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"

python="$root/.venv/bin/python"
if [ ! -x "$python" ]; then
  echo "podhaus's Python environment is missing; follow the Python setup in README.md" >&2
  exit 1
fi

"$python" tools/lint-stack-env.py
"$python" tools/lint-stack-content-hash.py
"$python" tools/lint-stack-toml.py
"$python" tools/lint-alloy-timestamps.py
"$python" tools/render-pomerium-keys.py --verify
"$python" tools/render-lan-addresses.py --verify
