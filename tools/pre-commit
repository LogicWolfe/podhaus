#!/bin/bash
# Reference copy of podhaus's pre-commit hook. Install via symlink so
# future edits to this file are picked up automatically:
#
#   ln -sf ../../tools/pre-commit .git/hooks/pre-commit
#
# Checks run:
#   - lint-stack-env.py:           catches stack.toml env declarations
#                                   that no compose service references
#                                   (silent empty-var footgun).
#   - lint-stack-content-hash.py:  catches services that don't depend on
#                                   STACK_CONTENT_HASH (label + build-arg
#                                   pattern), so content changes wouldn't
#                                   actually recreate the container.
#   - lint-stack-toml.py:          rejects `deploy = true` on podhaus
#                                   stacks — Komodo's Sync Deploy sub-
#                                   stage duplicates Stage 2 and breaks
#                                   on transient linked-repo timeouts.
set -e
root="$(git rev-parse --show-toplevel)"
cd "$root"

if ! command -v mise >/dev/null 2>&1; then
  echo "podhaus hooks require mise; install it, then follow the Python setup in README.md" >&2
  exit 1
fi

if ! mise exec -- pipenv --venv >/dev/null 2>&1; then
  echo "podhaus Pipenv is not installed; follow the Python setup in README.md" >&2
  exit 1
fi

mise exec -- pipenv run python "$root/tools/lint-stack-env.py"
mise exec -- pipenv run python "$root/tools/lint-stack-content-hash.py"
mise exec -- pipenv run python "$root/tools/lint-stack-toml.py"
